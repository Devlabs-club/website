# Copy to `.dev.vars` for local dev (overrides wrangler.toml [vars] via platformProxy).
# Or use `.env` — see .env.example. Both load via src/lib/loadEnv.ts.
#
# Deploy secrets: bun run deploy:cloudflare:secrets
#
WEBSITE_ROOT=http://localhost:4321
WORKOS_REDIRECT_URI=http://localhost:4321/api/auth/oauth/callback
#
# JWT_SECRET=...
# VERCEL_AUTOMATION_BYPASS_SECRET=...  # Vercel Deployment Protection → Protection Bypass for Automation
# MONGODB_URI=...
# LINKEDIN_SCRAPER_URL=https://enrich-scraper-production.up.railway.app
# LINKEDIN_SCRAPER_SECRET=...
# WORKOS_API_KEY=...
# WORKOS_CLIENT_ID=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=...
# BUILDER_CLAIM_MESSAGE_WEBHOOK_URL=...
# BUILDER_CLAIM_MESSAGE_WEBHOOK_SECRET=...
# BUILDER_CLAIM_INBOUND_WEBHOOK_SECRET=...
