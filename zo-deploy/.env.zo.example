# Copy to zo-deploy/.env on the Zo computer and fill in.
# run-enrichment.sh sources this before invoking the scripts.

# --- Required: where enriched data is written ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
ADMIN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority

# --- Chromium CDP (defaults are fine; the launcher binds 9222 on loopback) ---
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_USER_DATA_DIR=/home/workspace/.linkedin-chrome-profile

# --- Required: lets the website call this box's scraper service ---
# Generate once (e.g. `openssl rand -hex 32`) and set the SAME value as
# ZO_SCRAPER_SECRET in the website's env. server.mjs checks the Bearer token.
ZO_SCRAPER_SECRET=

# --- GitHub enrichment: API token, NOT a browser login ---
GITHUB_TOKEN=ghp_...

# --- Optional: Voyager API fallback (only needed if you also want the cookie path) ---
# Grab these from DevTools while signed in, or skip — the CDP DOM path doesn't need them.
# LINKEDIN_LI_AT_COOKIE=
# LINKEDIN_JSESSIONID_COOKIE=

# --- Optional: LLM refinement fallback ---
# OPENROUTER_API_KEY=
