---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import NewFooter from "../components/NewFooter.astro";
import PageLoader from "../components/PageLoader.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  keywords?: string;
  canonicalPath?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  hideNavbar?: boolean;
  hideFooter?: boolean;
  skipPageLoader?: boolean;
  skipParallax?: boolean;
  skipSmoothScroll?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  keywords,
  canonicalPath,
  robots,
  structuredData,
  hideNavbar = false,
  hideFooter = false,
  skipPageLoader = false,
  skipParallax = false,
  skipSmoothScroll = false,
} = Astro.props;

// Absolute URL required for Twitter/OG image crawlers - relative paths don't work.
// Prerendered pages bake meta tags at build time, so Astro.url.origin is localhost;
// Astro.site (from astro.config site + WEBSITE_ROOT on Vercel) is the canonical origin.
const siteOrigin = Astro.site
  ? new URL(Astro.site).origin
  : Astro.url.origin;
const canonicalUrl = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const defaultDescription =
  "DevLabs helps startup founders hire proven software engineers using project evidence, GitHub signal, work trials, and founder-reviewed proof of work.";
const defaultOgImage = `${siteOrigin}/og.png`;
const defaultOgImageAlt =
  "DevLabs - proof-of-work hiring for startup engineering teams.";
const defaultKeywords =
  "DevLabs, startup hiring platform, hire software engineers, hire founding engineers, AI engineers, proof of work hiring, technical recruiting, startup talent, vetted developers, engineering hiring";

const ogImageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteOrigin}${ogImage}`
  : defaultOgImage;
const metaDescription = description ?? defaultDescription;
const metaOgImageAlt = ogImageAlt ?? defaultOgImageAlt;
const metaKeywords = keywords ?? defaultKeywords;
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<!doctype html>
<html lang="en" class:list={[!skipSmoothScroll && "scroll-smooth"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaOgImageAlt} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={metaDescription} />

    <!-- Twitter Card meta tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/logo.png" type="image/png" />
    <Analytics />

    <meta name="keywords" content={metaKeywords} />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://db.onlinewebfonts.com/c/5de0a211c8f197500215b63ee263c25f?family=Mistrully&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://db.onlinewebfonts.com/c/5de0a211c8f197500215b63ee263c25f?family=Mistrully&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class:list={['bg-paper text-ink antialiased', !skipPageLoader && 'loader-visible']}>
    {!skipPageLoader ? <PageLoader /> : null}

    {!hideNavbar && <Navbar />}
    <main class="relative z-10">
      <slot />
    </main>
    <!-- <Footer /> -->
    {!hideFooter ? <NewFooter /> : null}
  </body>
</html>
<style>
  html {
    font-family: Manrope, system-ui, sans-serif;
  }

  body {
    background-color: #fbf6f3;
    color: #050505;
  }

  body.loader-visible {
    overflow: hidden;
  }

  /* Global section parallax: reveal + depth */
  .parallax-section {
    --parallax-offset-y: 0px;
    opacity: 0;
    transform: translateY(calc(56px + var(--parallax-offset-y)));
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .parallax-section.parallax-revealed {
    opacity: 1;
    transform: translateY(var(--parallax-offset-y));
  }
</style>
{!skipParallax ? (
  <script>
    import { initSectionParallax } from "../lib/scroll.js";
    initSectionParallax();
  </script>
) : null}
