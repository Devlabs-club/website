---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import LandingMarketingNav from "../components/landing/LandingMarketingNav.astro";
import LandingAsciiStars from "../components/landing/LandingAsciiStars.astro";
import LandingDarkClose from "../components/landing/LandingDarkClose.astro";
import LandingAsciiInit from "../components/landing/LandingAsciiInit.astro";
import LandingMarketingStyles from "../components/landing/LandingMarketingStyles.astro";

const timeline = [
  {
    year: "2024",
    cards: [
      {
        dateLabel: "March 2024",
        title: "The beginning",
        image: "/events/DevHacks6.jpg",
        bullets: [
          "Started in a dorm study room with 10 friends",
          "0 connections, 0 network, 0 direction",
        ],
      },
      {
        dateLabel: "August 2024",
        title: "First event",
        image: "/events/devspace.webp",
        bullets: ["50+ attendees"],
      },
    ],
  },
  {
    year: "2025",
    cards: [
      {
        dateLabel: "March 2025",
        title: "DevHacks",
        image: "/events/devhacks.jpg",
        bullets: [
          "Arizona's biggest student-led hackathon with 150+ students",
          "Product Hunt sponsored us",
          "60+ projects in 36 hours",
        ],
      },
      {
        dateLabel: "June 2025",
        title: "DevHouse AZ",
        image: "/events/devhouse.png",
        bullets: [
          "Hosted Arizona's first hacker house",
          "Became Arizona's biggest builder community with 500+ members",
          "Partnered with the state's top 4 VCs — AZVC, PHX Ventures, Arizona Commerce Authority",
          "10 graduated startups from Class of 2025",
        ],
      },
      {
        dateLabel: "November 2025",
        title: "DevSpace",
        image: "/events/devspace.webp",
        bullets: ["Gave away $10k grants to two startups"],
      },
      {
        dateLabel: "December 2025",
        title: "DevHouse SF",
        image: "/events/devhouse-sf.jpg",
        bullets: [
          "500+ applications",
          "Builders flew in from Canada, London and the east coast",
          "1 got hired for a $150k offer @ Supermemory",
          "$10k in prizes for the top builders",
        ],
      },
    ],
  },
  {
    year: "2026",
    cards: [
      {
        dateLabel: "Coming soon",
        title: "Momentum",
        image: "/hands-touching.png",
        bullets: ["Nationwide startup program"],
      },
    ],
  },
];

const timelineCards = timeline.flatMap((block) =>
  block.cards.map((card) => ({ year: block.year, ...card })),
);

const team = [
  {
    name: "Dhanush Vardhan",
    title: "Co-founder",
    meta: "Ex-Cloudflare · Incoming Google",
    image: "/team/dhanush.jpg",
    linkedin: "https://www.linkedin.com/in/dhanush-vardhan-30bb881b0/",
  },
  {
    name: "Bhoomi Sahajsinghani",
    title: "Co-founder",
    meta: "Builder community, partnerships",
    image: "/team/bhoomi.webp",
    linkedin: "https://www.linkedin.com/in/bhoomi-sahajsinghani/",
  },
  {
    name: "Pranay Siddu",
    title: "Head of Partnerships",
    meta: "Sponsors & founder relations",
    image: "/team/pranay.jpg",
    linkedin:
      "https://www.linkedin.com/in/pranay-siddu-athipathala-3061512b0/",
  },
];
---

<Layout title="Our Story - DevLabs" hideNavbar hideFooter skipPageLoader skipParallax>
  <LandingMarketingStyles />
  <main class="landing-page min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
    <LandingMarketingNav active="about" />

    <!-- Hero -->
    <section class="hero-section ruler-section relative mx-auto w-full max-w-7xl overflow-hidden px-6 pb-20 pt-10 sm:px-8 lg:px-10">
      <LandingAsciiStars />
      <div class="ruler-rails" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-4xl text-center">
        <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">
          we help builders go big or get hired
        </p>
        <h1 class="mt-6 text-[clamp(2rem,9.6vw,5.6rem)] font-normal leading-[1.18] tracking-[-0.035em] text-black">
          Meet the <span class="font-extrabold">team</span>
        </h1>
      </div>

      <!-- Hero video frame -->
      <div class="relative z-10 mx-auto mt-12 w-full max-w-[960px]">
        <div class="relative overflow-hidden rounded-[34px] border-[3px] border-[#168df7] bg-[#cfe6e9] shadow-[0_18px_55px_rgba(12,62,96,0.12)]">
          <div class="relative aspect-video">
            <video
              id="about-hero-video"
              controls
              loop
              playsinline
              autoplay
              muted
              preload="auto"
              class="block h-full w-full object-cover"
            >
              <source
                src="https://pub-bdc5a5628514472d904835747cff21f2.r2.dev/DEVHOUSE_draft4.mp4"
                type="video/mp4"
              />
            </video>
          </div>
        </div>
        <span class="selection-dot left-7 top-7"></span>
        <span class="selection-dot right-7 top-7"></span>
        <span class="selection-dot bottom-7 left-7"></span>
        <span class="selection-dot bottom-7 right-7"></span>
      </div>
    </section>

    <!-- Who we are -->
    <section class="relative mx-auto w-full max-w-7xl px-6 py-20 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">who we are</p>
          <h2 class="mt-6 text-[clamp(2rem,5vw,3.4rem)] font-black leading-[0.98] tracking-[-0.05em] text-black">
            A community built for people who <span class="text-[#ff7417]">ship</span>.
          </h2>
        </div>
        <div class="space-y-6 text-[clamp(1.1rem,1.7vw,1.45rem)] font-medium leading-relaxed text-black/68">
          <p>
            <span class="font-black text-black">DevLabs</span> started as a bunch of
            friends who wanted a place where builders could learn, build, and meet
            collaborators —
            <span class="font-black text-black">turning ideas into real products</span>.
          </p>
          <p>
            Today we host <span class="font-black text-black">hackathons</span>,
            <span class="font-black text-black">founder programs</span>, and
            <span class="font-black text-black">hacker houses</span> to help ambitious
            builders grow faster — with community, not alone.
          </p>
        </div>
      </div>
    </section>

    <!-- Growth timeline -->
    <section class="ruler-section relative bg-[#fbf6f3] py-20">
      <div class="mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-10">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">our growth</p>
            <h2 class="mt-6 text-[clamp(2rem,6vw,3.6rem)] font-black leading-[0.98] tracking-[-0.05em] text-black">
              One <span class="text-[#ff7417]">story</span> to tell.
            </h2>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button type="button" id="timeline-prev" aria-label="Scroll timeline left" class="grid h-11 w-11 place-items-center border-2 border-black text-black transition hover:bg-black hover:text-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button type="button" id="timeline-next" aria-label="Scroll timeline right" class="grid h-11 w-11 place-items-center border-2 border-black text-black transition hover:bg-black hover:text-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M9 6l6 6-6 6"></path></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="growth-timeline-scroll" class="mt-12 overflow-x-auto pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <div id="growth-timeline" class="flex w-max gap-5 px-6 sm:px-8 lg:px-10" style="--year-col:340px;--year-gap:20px;">
          {timelineCards.map((item, idx, arr) => {
            const showYear = idx === 0 || arr[idx - 1].year !== item.year;
            return (
              <div class="w-[340px] shrink-0 snap-start">
                <!-- rail + dot -->
                <div class="relative mb-5 h-8">
                  <div class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-black/15"></div>
                  <span class="absolute left-3 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#ff7417] bg-[#fbf6f3]"></span>
                  {showYear && (
                    <span class="absolute left-8 top-1/2 -translate-y-1/2 text-2xl font-black tracking-[-0.04em] text-black">{item.year}</span>
                  )}
                </div>

                <article class="flex h-full flex-col border border-black/12 bg-[#fffaf7] p-3.5">
                  <div class="aspect-[4/3] overflow-hidden border border-black/10 bg-[#cfe6e9]">
                    <img src={item.image} alt={item.title} loading="lazy" class="h-full w-full object-cover" />
                  </div>
                  <p class="mt-4 text-[0.65rem] font-extrabold uppercase tracking-[0.18em] text-[#bf4f08]">{item.dateLabel}</p>
                  <h3 class="mt-1.5 text-xl font-black tracking-[-0.03em] text-black">
                    <span class="relative inline">
                      {item.title}
                      <span class="absolute bottom-0.5 left-0 -z-10 h-[5px] w-full -rotate-1 bg-[#ff7417]/80" aria-hidden="true"></span>
                    </span>
                  </h3>
                  <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm leading-relaxed text-black/60">
                    {item.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </article>
              </div>
            );
          })}
        </div>
      </div>

      <!-- mobile arrows -->
      <div class="mt-6 flex items-center justify-center gap-2 sm:hidden">
        <button type="button" id="timeline-prev-mobile" aria-label="Scroll timeline left" class="grid h-11 w-11 place-items-center border-2 border-black text-black transition active:bg-black active:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <button type="button" id="timeline-next-mobile" aria-label="Scroll timeline right" class="grid h-11 w-11 place-items-center border-2 border-black text-black transition active:bg-black active:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </section>

    <!-- Team -->
    <section class="relative mx-auto w-full max-w-7xl px-6 py-20 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">the team</p>
          <h2 class="mt-6 text-[clamp(2rem,6vw,3.6rem)] font-black leading-[0.98] tracking-[-0.05em] text-black">
            Small team, big obsession.
          </h2>
        </div>
        <p class="max-w-xl self-end text-lg leading-relaxed text-black/62">
          A small team building a home where ambitious builders can grow faster
          together — and where founders find the ones who actually ship.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 border border-black/12 sm:grid-cols-3">
        {team.map((member, i) => (
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class={`group relative bg-[#fffaf7] p-5 transition-colors hover:bg-[#fff5ef] ${i !== team.length - 1 ? "border-b border-black/12 sm:border-b-0 sm:border-r" : ""}`}
          >
            <div class="aspect-square overflow-hidden border border-black/10 bg-[#cfe6e9]">
              <img src={member.image} alt={member.name} loading="lazy" class="h-full w-full object-cover grayscale-[15%] transition duration-300 group-hover:grayscale-0" />
            </div>
            <div class="mt-5 flex items-start justify-between gap-3">
              <div>
                <h3 class="text-xl font-black tracking-[-0.03em] text-black">{member.name}</h3>
                <p class="mt-1 text-sm font-extrabold uppercase tracking-[0.1em] text-[#bf4f08]">{member.title}</p>
                {member.meta && <p class="mt-1 text-sm text-black/55">{member.meta}</p>}
              </div>
              <svg class="mt-1 h-5 w-5 shrink-0 text-black/30 transition group-hover:text-[#ff7417]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"></path>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <LandingDarkClose />
  </main>

  <LandingAsciiInit />

  <script>
    const byId = (id: string) => document.getElementById(id);

    // Hero video autoplay
    (() => {
      const video = byId("about-hero-video");
      if (!(video instanceof HTMLVideoElement)) return;
      const play = () => video.play().catch(() => {});
      if (video.readyState >= 2) play();
      else video.addEventListener("loadeddata", play, { once: true });
    })();

    // Timeline horizontal scroll
    const timelineScroll = byId("growth-timeline-scroll");
    const scrollOneCard = () => 360;
    const scrollTimeline = (dir: number) => {
      timelineScroll?.scrollBy({ left: dir * scrollOneCard(), behavior: "smooth" });
    };
    const bind = (id: string, dir: number) => {
      const el = byId(id);
      el?.addEventListener("click", () => scrollTimeline(dir));
    };
    bind("timeline-prev", -1);
    bind("timeline-next", 1);
    bind("timeline-prev-mobile", -1);
    bind("timeline-next-mobile", 1);
  </script>
</Layout>
