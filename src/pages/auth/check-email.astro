---
import AppLayout from "../../layouts/AppLayout.astro";
import AuthCheckEmailPage from "../../components/auth/AuthCheckEmailPage.tsx";

const email = Astro.url.searchParams.get("email") || "";
const redirect = Astro.url.searchParams.get("redirect") || "";
const error = Astro.url.searchParams.get("error") || "";
---

<AppLayout title="Check your email · DevLabs" robots="noindex, nofollow">
  <AuthCheckEmailPage email={email} redirect={redirect} error={error} client:load />
</AppLayout>
