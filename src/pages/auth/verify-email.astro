---
import AppLayout from "../../layouts/AppLayout.astro";
import AuthVerifyEmailPage from "../../components/auth/AuthVerifyEmailPage.tsx";

const token = Astro.url.searchParams.get("token") || "";
const redirect = Astro.url.searchParams.get("redirect") || "";
---

<AppLayout title="Verify email · DevLabs" robots="noindex, nofollow">
  <AuthVerifyEmailPage token={token} redirect={redirect} client:load />
</AppLayout>
