---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import CompanyMarquee from "../components/CompanyMarquee.astro";
import LandingMarketingNav from "../components/landing/LandingMarketingNav.astro";
import LandingAsciiStars from "../components/landing/LandingAsciiStars.astro";
import LandingDarkClose from "../components/landing/LandingDarkClose.astro";
import LandingAsciiInit from "../components/landing/LandingAsciiInit.astro";
import LandingMarketingStyles from "../components/landing/LandingMarketingStyles.astro";
import { tryForFreeHref } from "../lib/productCta";

const benefits = [
  {
    title: "Access proven builders",
    detail:
      "Meet Arizona and SF's most ambitious student engineers, designers, and product minds — observed shipping real work, not polished resumes.",
    chips: ["Pre-vetted", "Shipped projects", "Hire-ready"],
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    title: "Brand in the room",
    detail:
      "Put your brand in front of thousands of builders through our hackathons, hacker houses, demo days, social, and newsletter network.",
    chips: ["2,000+ network", "Live events", "Demo days"],
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  },
  {
    title: "Fund what ships",
    detail:
      "Directly back the hardware, space, and prize pools builders need to turn wild ideas into real, working products.",
    chips: ["$50k+ deployed", "Prize pools", "Hacker houses"],
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  },
];

const testimonials = [
  {
    quote:
      "The energy was electric and I've never seen a crowd like this before.",
    logo: "/sponsors/deepmind.png",
    logoAlt: "Google DeepMind",
    avatar: "/team/paige.png",
    name: "Paige Bailey",
    role: "Lead DevRel, Google DeepMind",
  },
  {
    quote:
      "I ended up hiring from the DevHouse. I'm super satisfied — this is the kind of talent you don't see in any hackathon.",
    logo: "/sponsors/supermemory.png",
    logoAlt: "Supermemory",
    avatar: "/team/dhravya.png",
    name: "Dhravya Shah",
    role: "Founder, Supermemory",
  },
  {
    quote: "This is one of the best hackathons we've sponsored.",
    logo: "/sponsors/browser-use.png",
    logoAlt: "Browser Use",
    avatar: "/team/saurav.png",
    name: "Saurav Panda",
    role: "Founding Engineer, Browser Use",
  },
];

const partnerStats = [
  { value: "2,000+", label: "Builders in network" },
  { value: "100", label: "Top builders / cohort" },
  { value: "$50k+", label: "Deployed to builders" },
  { value: "1 day", label: "Need to intro" },
];
---

<Layout title="Sponsor DevLabs" hideNavbar hideFooter skipPageLoader skipParallax>
  <LandingMarketingStyles />
  <main class="landing-page min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
    <LandingMarketingNav active="sponsor" />

    <!-- Hero -->
    <section class="sponsor-hero hero-section ruler-section relative mx-auto w-full max-w-7xl overflow-hidden px-6 pb-12 pt-16 sm:px-8 lg:px-10">
      <LandingAsciiStars />
      <div class="ruler-rails" aria-hidden="true"></div>
      <div class="relative z-10 max-w-4xl">
        <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">
          partner with devlabs
        </p>
        <h1 class="mt-6 text-[clamp(2rem,9.6vw,5.6rem)] font-normal leading-[1.18] tracking-[-0.035em] text-black">
          Back the builders who
          <span class="font-extrabold">actually ship</span>.
        </h1>
        <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.4rem)] font-medium leading-relaxed text-black/45">
          Help us build the launchpad for the next 100 student founders. Sponsors
          don't just get a logo on a banner — they get first access to proof-backed
          builders before anyone else does.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="mailto:people@devlabs.club?subject=Sponsorship%20Inquiry"
            class="group inline-flex h-[3.35rem] items-center justify-center gap-3 rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-8 text-base font-extrabold text-white shadow-[0_16px_36px_rgba(5,5,5,0.12)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417] hover:shadow-[0_16px_36px_rgba(255,116,23,0.2)]"
          >
            Become a partner
            <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a
            href={tryForFreeHref}
            class="inline-flex h-[3.35rem] items-center justify-center gap-2 rounded-full border-2 border-black/15 bg-[#fffaf7]/90 px-8 text-base font-extrabold text-black shadow-[0_12px_28px_rgba(5,5,5,0.05)] transition hover:-translate-y-0.5 hover:border-black hover:bg-white"
          >
            Try for free
          </a>
        </div>
      </div>

      <!-- Proof strip -->
      <div class="relative z-10 mt-14 grid grid-cols-2 border border-black/10 bg-[#f4f1ed]/70 backdrop-blur-[2px] lg:grid-cols-4">
        {partnerStats.map((stat, i) => (
          <div class={`relative p-6 sm:p-8 ${i % 2 === 0 ? "border-r border-black/10" : ""} ${i < 2 ? "border-b border-black/10 lg:border-b-0" : ""} ${i !== 3 ? "lg:border-r lg:border-black/10" : ""}`}>
            <p class="text-[clamp(2rem,4vw,3rem)] font-black leading-none tracking-[-0.05em] text-black">{stat.value}</p>
            <p class="mt-3 text-xs font-extrabold uppercase tracking-[0.16em] text-black/45">{stat.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Trusted by marquee -->
    <section class="relative mx-auto w-full max-w-7xl px-6 py-10 sm:px-8 lg:px-10">
      <div class="border border-black/10 bg-[#f4f1ed]/55 px-2 py-6 sm:py-8">
        <p class="mb-4 text-center text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">
          trusted by industry leaders
        </p>
        <CompanyMarquee className="py-1" showTitle={false} lightBackground />
      </div>
    </section>

    <!-- Why sponsor -->
    <section class="relative mx-auto w-full max-w-7xl px-6 py-20 sm:px-8 lg:px-10">
      <div class="max-w-3xl">
        <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">why sponsor</p>
        <h2 class="mt-6 text-[clamp(2rem,6vw,3.6rem)] font-black leading-[0.98] tracking-[-0.05em] text-black">
          Three reasons founders keep coming back.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 border border-black/12 md:grid-cols-3">
        {benefits.map((b, i) => (
          <div class={`relative bg-[#fffaf7] p-8 ${i !== benefits.length - 1 ? "border-b border-black/12 md:border-b-0 md:border-r" : ""}`}>
            <div class="grid h-12 w-12 place-items-center border border-[#ff7417]/40 bg-[#fff5ef] text-[#ff7417]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon}></svg>
            </div>
            <h3 class="mt-7 text-2xl font-black tracking-[-0.03em] text-black">{b.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-black/60">{b.detail}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {b.chips.map((chip) => (
                <span class="border border-[#ff7417]/35 bg-[#fff5ef] px-2.5 py-1 text-xs font-semibold text-[#bf4f08]">{chip}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Dark close: testimonials flow into footer (single dark-act, no cream bar gap) -->
    <LandingDarkClose>
      <section class="relative px-5 pb-8 pt-40 sm:px-8 sm:pb-12 sm:pt-52 lg:px-10">
        <div class="relative z-10 mx-auto w-full max-w-7xl">
          <div class="mx-auto max-w-4xl text-center">
            <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-white/40">social proof</p>
            <h2 class="mx-auto mt-6 max-w-3xl text-[clamp(2rem,6vw,3.6rem)] font-black leading-[0.98] tracking-[-0.05em] text-white">
              From industry giants to rising startups.
            </h2>
          </div>

          <div class="mt-12 grid gap-4 sm:gap-6 lg:grid-cols-3">
            {testimonials.map((t) => (
              <figure class="relative flex min-h-[19rem] flex-col justify-between overflow-hidden border border-white/12 bg-white/[0.045] p-7 backdrop-blur-sm sm:min-h-[21rem]">
                <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#ff7417]/70 to-transparent"></div>
                <div class="flex items-start justify-between gap-5">
                  <span class="inline-flex h-12 max-w-full items-center rounded-full border border-white/10 bg-white/[0.04] px-4 sm:min-w-[14rem]">
                    <img src={t.logo} alt={t.logoAlt} loading="lazy" class="max-h-8 w-auto object-contain brightness-0 invert opacity-80" />
                  </span>
                  <span class="text-5xl font-black leading-none text-[#ff7417]/22">“</span>
                </div>
                <blockquote class="mt-8 text-lg font-semibold leading-relaxed text-white/88 sm:text-xl">
                  {t.quote}
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4 border-t border-white/10 pt-5">
                  <img src={t.avatar} alt={t.name} loading="lazy" class="h-14 w-14 shrink-0 border border-[#ff7417]/45 object-cover shadow-[0_0_0_4px_rgba(255,116,23,0.08)] sm:h-16 sm:w-16" />
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-black text-white">{t.name}</span>
                    <span class="block text-xs font-semibold leading-snug text-white/52">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    </LandingDarkClose>
  </main>

  <LandingAsciiInit />
</Layout>

<style>
  .sponsor-hero :global(.ascii-star) {
    opacity: 0.32;
  }

  @media (max-width: 639px) {
    .sponsor-hero :global(.ascii-star) {
      opacity: 0.22;
    }
  }
</style>
