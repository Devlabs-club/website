---
import Layout from '@/layouts/Layout.astro';
import ConversationalShell from '@/components/portal/ConversationalShell';
---

<Layout title="Founder Portal · DevLabs">
  <main class="relative pt-44 pb-24 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="mb-10">
        <p class="text-[#fa7d22] uppercase tracking-[0.2em] text-xs font-semibold">Founder OS</p>
        <h1 class="text-white text-5xl md:text-7xl leading-[0.95] mt-3">
          explain your startup once,
          <span class="block font-[Mistrully] italic">get a trusted shortlist fast</span>
        </h1>
        <p class="text-white/60 mt-5 max-w-3xl text-lg">Conversational founder intake that transforms messy context into role briefs, match logic, and candidate cards.</p>
      </div>

      <ConversationalShell
        client:load
        title="Founder Intake & Matching Agent"
        subtitle="Tell me what you’re building, who you need, and your timeline. I’ll do the structuring and search."
        options={[
          {
            label: 'Create Role Brief',
            action: 'create_role_brief',
            placeholder: 'company | role title | startup summary | skills(csv) | budget | timeline | work type',
          },
          {
            label: 'Run Builder Search',
            action: 'run_builder_search',
            placeholder: 'Paste the opportunity ID from role-brief response',
          },
        ]}
      />
    </div>
  </main>
</Layout>
