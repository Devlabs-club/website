---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import SeoPageShell from "../../components/seo/SeoPageShell.astro";
import { breadcrumbSchema, organizationSchema, seoKeywords, websiteSchema } from "../../lib/seo";

const title = "Juicebox Alternative for Startup Engineering Hiring | DevLabs";
const description =
  "Looking for a Juicebox alternative for hiring engineers? DevLabs is built for founders who care more about proof of work than searching millions of profiles.";
---

<Layout
  title={title}
  description={description}
  keywords={seoKeywords}
  canonicalPath="/alternatives/juicebox"
  hideNavbar
  hideFooter
  skipPageLoader
  skipParallax
  structuredData={[
    organizationSchema,
    websiteSchema,
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Juicebox alternative", path: "/alternatives/juicebox" },
    ]),
  ]}
>
  <SeoPageShell
    eyebrow="Juicebox alternative"
    title={'Juicebox helps you search. <span class="font-extrabold">DevLabs helps you judge the signal.</span>'}
    intro={"Juicebox is really good at helping recruiting teams search a huge talent market. That's not the problem we started DevLabs to solve. We built DevLabs for the founder staring at 300 \"good\" profiles and still having no idea who can actually build."}
  >
    <section class="mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-10">
      <div class="grid gap-5 lg:grid-cols-3">
        {[
          ["If your problem is finding more people", "Use a sourcing platform. There are millions of engineers online, and tools like Juicebox make searching that market much easier. That's valuable."],
          ["If your problem is figuring out who is actually good", "That is where things get harder. Two engineers can have almost identical resumes and be completely different builders. So DevLabs goes deeper into things like projects, GitHub, hackathons, startup work, agent traces, and people who have actually built with them."],
          ["DevLabs is deliberately smaller", "We are not trying to index the entire professional internet. We would rather show a founder 10 builders we have real signal on than 10,000 profiles that match a search. If you're hiring an early engineer, that tradeoff can make a lot of sense."],
        ].map(([heading, body]) => (
          <article class="border border-black/10 bg-white p-6">
            <h2 class="text-2xl font-normal tracking-[-0.02em]">{heading}</h2>
            <p class="mt-4 leading-relaxed text-black/62">{body}</p>
          </article>
        ))}
      </div>
    </section>
  </SeoPageShell>
</Layout>
