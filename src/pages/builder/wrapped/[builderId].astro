---
import AppLayout from "../../../layouts/AppLayout.astro";
import AgentWrappedPage from "../../../components/builder/AgentWrappedPage";
import { parseShareCardParam, shortCardParam } from "../../../lib/agentWrapped/buildprintAttribution";
import { loadWrappedOgData } from "../../../lib/agentWrapped/loadWrappedOgData";

const builderId = Astro.params.builderId || "";
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const featuredCard = parseShareCardParam(Astro.url.searchParams.get("c") || Astro.url.searchParams.get("card"));
const cardShort = shortCardParam(featuredCard);
const ogImage = cardShort
  ? `/api/builder/wrapped/${encodeURIComponent(builderId)}/og.png?c=${cardShort}`
  : `/api/builder/wrapped/${encodeURIComponent(builderId)}/og.png`;

let pageTitle = "AI Wrapped · DevLabs";
let pageDescription = "DevLabs AI Wrapped — building habits backed by proof.";

try {
  const ogData = await loadWrappedOgData(builderId, siteOrigin);
  if (ogData) {
    const featured = featuredCard
      ? ogData.cardPreviews.find((card) => card.key === featuredCard)
      : null;
    pageTitle = featured
      ? `${ogData.builderName} · ${featured.title} · AI Wrapped`
      : `${ogData.builderName} · ${ogData.archetype} · AI Wrapped`;
    pageDescription = featured
      ? `${ogData.builderName} — ${featured.title}. ${ogData.headline}`
      : `${ogData.builderName} — ${ogData.archetype}. ${ogData.headline}`;
  }
} catch {
  /* fall back to generic meta */
}
---

<AppLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  ogImageAlt={`${pageTitle} — DevLabs AI Wrapped`}
>
  <AgentWrappedPage builderId={builderId} client:load />
</AppLayout>
