<script>
  const canvases = Array.from(
    document.querySelectorAll<HTMLCanvasElement>("[data-star-canvas]"),
  );
  const waveCanvases = Array.from(
    document.querySelectorAll<HTMLCanvasElement>("[data-ascii-wave]"),
  );
  const rippleCanvases = Array.from(
    document.querySelectorAll<HTMLCanvasElement>("[data-ascii-ripple]"),
  );

  function createStarAsciiRenderer(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return () => {};

    const image = new Image();
    image.src = "/star.svg";

    const chars = " .:-=+*#%@";
    const fontSize = 10;
    const fontFamily =
      "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
    const sourceScale = 2.05;
    const revealMs = 1500;

    let animationFrame = 0;
    let startTime = 0;
    let width = 0;
    let height = 0;
    let charWidth = 6;
    let columns = 0;
    let rows = 0;
    let pixels: Uint8ClampedArray | null = null;
    let seeds: Float32Array | null = null;

    const clamp = (value: number, min: number, max: number) =>
      Math.max(min, Math.min(max, value));

    function setup() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `${fontSize}px ${fontFamily}`;
      charWidth = Math.max(5, ctx.measureText("@").width);
      columns = Math.ceil(width / charWidth);
      rows = Math.ceil(height / fontSize);

      const sampler = document.createElement("canvas");
      sampler.width = columns;
      sampler.height = rows;
      const samplerCtx = sampler.getContext("2d");
      if (!samplerCtx || !image.naturalWidth) return;

      const drawWidth = columns * sourceScale;
      const drawHeight = rows * sourceScale;
      samplerCtx.clearRect(0, 0, columns, rows);
      samplerCtx.drawImage(
        image,
        0,
        0,
        image.naturalWidth,
        image.naturalHeight,
        (columns - drawWidth) / 2,
        (rows - drawHeight) / 2,
        drawWidth,
        drawHeight,
      );

      pixels = samplerCtx.getImageData(0, 0, columns, rows).data;
      seeds = new Float32Array(columns * rows);
      for (let index = 0; index < seeds.length; index += 1) {
        seeds[index] = Math.random();
      }
    }

    function draw(now: number) {
      if (!pixels || !seeds) {
        animationFrame = requestAnimationFrame(draw);
        return;
      }

      if (!startTime) startTime = now;
      const progress = clamp((now - startTime) / revealMs, 0, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const revealWave = eased * 0.66;

      ctx.clearRect(0, 0, width, height);
      ctx.font = `${fontSize}px ${fontFamily}`;
      ctx.textBaseline = "top";

      const midX = columns / 2;
      const midY = rows / 2;

      for (let row = 0; row < rows; row += 1) {
        for (let col = 0; col < columns; col += 1) {
          const pixelIndex = (row * columns + col) * 4;
          const alpha = pixels[pixelIndex + 3] / 255;
          if (alpha < 0.06) continue;

          const edgeDistance = Math.min(col / columns, 1 - col / columns);
          const threshold = edgeDistance + seeds[row * columns + col] * 0.12;
          const cellFade = clamp((revealWave - threshold) * 5.5, 0, 1);
          if (cellFade <= 0) continue;

          const distFromCenter = Math.sqrt(
            Math.pow((col - midX) / midX, 2) + Math.pow((row - midY) / midY, 2),
          );
          const depth = clamp(1 - distFromCenter * 0.2, 0.55, 1);
          const opacity = clamp(alpha * cellFade * depth, 0, 0.9);
          const charIndex = Math.min(
            chars.length - 1,
            Math.floor(alpha * (chars.length - 1)),
          );

          ctx.fillStyle = `rgba(250, 125, 34, ${opacity})`;
          ctx.fillText(chars[charIndex], col * charWidth, row * fontSize);
        }
      }

      if (progress < 1) {
        animationFrame = requestAnimationFrame(draw);
      }
    }

    function start() {
      cancelAnimationFrame(animationFrame);
      startTime = 0;
      setup();
      animationFrame = requestAnimationFrame(draw);
    }

    if (image.complete && image.naturalWidth) start();
    else image.addEventListener("load", start, { once: true });

    window.addEventListener("resize", start);

    return () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener("resize", start);
    };
  }

  function createAsciiWave(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return () => {};

    const chars = " .:-=+*#%@";
    const fontFamily =
      "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let animationFrame = 0;
    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let fontSize = 12;
    let charWidth = 7;
    let seeds: Float32Array | null = null;

    const clamp = (value: number, min: number, max: number) =>
      Math.max(min, Math.min(max, value));

    function setup() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      fontSize = width < 640 ? 10 : 12;
      ctx.font = `${fontSize}px ${fontFamily}`;
      charWidth = Math.max(6, ctx.measureText("@").width);
      columns = Math.ceil(width / charWidth);
      rows = Math.ceil(height / fontSize);

      seeds = new Float32Array(columns * rows);
      for (let index = 0; index < seeds.length; index += 1) {
        seeds[index] = Math.random();
      }
    }

    function draw(now: number) {
      if (!seeds) {
        animationFrame = requestAnimationFrame(draw);
        return;
      }

      const time = prefersReducedMotion.matches ? 0 : now * 0.00028;
      ctx.clearRect(0, 0, width, height);
      ctx.font = `${fontSize}px ${fontFamily}`;
      ctx.textBaseline = "top";

      for (let row = 0; row < rows; row += 1) {
        const y = row * fontSize;
        const yNorm = row / Math.max(1, rows - 1);

        for (let col = 0; col < columns; col += 1) {
          const x = col * charWidth;
          const xNorm = col / Math.max(1, columns - 1);
          const centerA =
            0.32 + Math.sin(xNorm * 7.4 + time * 2.2) * 0.075;
          const centerB =
            0.58 + Math.sin(xNorm * 5.8 - time * 1.7 + 1.2) * 0.095;
          const bandA = Math.exp(-Math.pow((yNorm - centerA) / 0.13, 2));
          const bandB = Math.exp(-Math.pow((yNorm - centerB) / 0.16, 2));
          const topMist = Math.exp(-Math.pow((yNorm - 0.2) / 0.34, 2)) * 0.42;
          const noise = seeds[row * columns + col] || 0;
          const shimmer =
            0.84 + Math.sin(noise * 11 + time * 6 + col * 0.04) * 0.16;
          const edgeFade =
            clamp(xNorm * 4.2, 0, 1) *
            clamp((1 - xNorm) * 4.2, 0, 1) *
            clamp((1 - yNorm) * 1.4, 0, 1);
          const strength = clamp(
            (bandA * 1.08 + bandB * 0.82 + topMist) * shimmer * edgeFade,
            0,
            1,
          );

          if (strength < 0.08 || noise > strength + 0.38) continue;

          const charIndex = clamp(
            Math.floor(strength * (chars.length - 1)),
            0,
            chars.length - 1,
          );
          const opacity = clamp(strength * 0.44, 0.06, 0.42);
          const green = Math.round(84 + strength * 72);
          ctx.fillStyle = `rgba(255, ${green}, 0, ${opacity})`;
          ctx.fillText(chars[charIndex], x, y);
        }
      }

      if (!prefersReducedMotion.matches) {
        animationFrame = requestAnimationFrame(draw);
      }
    }

    function start() {
      cancelAnimationFrame(animationFrame);
      setup();
      animationFrame = requestAnimationFrame(draw);
    }

    start();
    window.addEventListener("resize", start);
    prefersReducedMotion.addEventListener("change", start);

    return () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener("resize", start);
      prefersReducedMotion.removeEventListener("change", start);
    };
  }

  function createAsciiRipple(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return () => {};

    const chars = " .:-=+*#%@";
    const isCompact = canvas.dataset.asciiRipple === "compact";
    const fontFamily =
      "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let animationFrame = 0;
    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let fontSize = 12;
    let charWidth = 7;

    const clamp = (value: number, min: number, max: number) =>
      Math.max(min, Math.min(max, value));

    function setup() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      fontSize = isCompact ? 9 : width < 720 ? 14 : 18;
      ctx.font = `${fontSize}px ${fontFamily}`;
      charWidth = Math.max(isCompact ? 5 : 8, ctx.measureText("@").width);
      columns = Math.ceil(width / charWidth);
      rows = Math.ceil(height / fontSize);
    }

    function drawCompactRipple(now: number) {
      const time = prefersReducedMotion.matches ? 0 : now * 0.0002;
      const centerX = width * 0.5;
      const centerY = height * 0.5;
      const minRadius = 8;
      const maxRadius = Math.min(width, height) * 0.58;
      const ringCount = 5;
      const ringChars = ["@", "#", "*", "+", "="];

      ctx.clearRect(0, 0, width, height);
      ctx.font = `800 ${fontSize}px ${fontFamily}`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      for (let ring = 0; ring < ringCount; ring += 1) {
        const progress = (time + ring / ringCount) % 1;
        const easedRadius =
          minRadius + Math.pow(progress, 0.76) * (maxRadius - minRadius);
        const ringFade = Math.pow(1 - progress, 0.44);
        const circumference = Math.max(1, Math.PI * 2 * easedRadius);
        const pointCount = Math.max(24, Math.floor(circumference / 5.2));
        const angleOffset = ring * 0.38 + time * 0.2;

        for (let point = 0; point < pointCount; point += 1) {
          const angle = (point / pointCount) * Math.PI * 2 + angleOffset;
          const x = centerX + Math.cos(angle) * easedRadius;
          const y = centerY + Math.sin(angle) * easedRadius;
          const edgeFade =
            clamp(x / width * 12, 0, 1) *
            clamp((1 - x / width) * 12, 0, 1) *
            clamp(y / height * 12, 0, 1) *
            clamp((1 - y / height) * 12, 0, 1);
          const sparkle =
            0.82 + Math.sin(point * 1.7 + ring * 2.1 + time * 4) * 0.18;
          const opacity = clamp((0.34 + ringFade * 0.5) * edgeFade * sparkle, 0, 0.9);
          if (opacity < 0.04) continue;

          const charIndex = Math.min(
            ringChars.length - 1,
            Math.floor(progress * ringChars.length),
          );
          ctx.fillStyle = `rgba(255, 255, 255, ${opacity})`;
          ctx.fillText(ringChars[charIndex], x, y);
        }
      }

      const corePulse = 0.35 + Math.sin(time * Math.PI * 2) * 0.18;
      ctx.fillStyle = `rgba(255, 255, 255, ${corePulse})`;
      ctx.fillText("+", centerX, centerY);
    }

    function draw(now: number) {
      if (isCompact) {
        drawCompactRipple(now);
        if (!prefersReducedMotion.matches) {
          animationFrame = requestAnimationFrame(draw);
        }
        return;
      }

      const time = prefersReducedMotion.matches ? 0 : now * 0.00018;
      const centerX = width * 0.5;
      const centerY = height * 0.5;
      const maxRadius = Math.hypot(width, height) * 0.66;
      const ringCount = isCompact ? 7 : 16;
      const spacing = maxRadius / ringCount;
      const thickness = isCompact
        ? Math.max(3.5, spacing * 0.18)
        : Math.max(12, spacing * 0.085);

      ctx.clearRect(0, 0, width, height);
      ctx.font = `${fontSize}px ${fontFamily}`;
      ctx.textBaseline = "top";

      for (let row = 0; row < rows; row += 1) {
        const y = row * fontSize;
        const dy = y + fontSize * 0.5 - centerY;

        for (let col = 0; col < columns; col += 1) {
          const x = col * charWidth;
          const dx = x + charWidth * 0.5 - centerX;
          const distance = Math.sqrt(dx * dx + dy * dy);
          const phase = (distance / spacing - time) % 1;
          const normalizedPhase = phase < 0 ? phase + 1 : phase;
          const ringDistance = Math.min(normalizedPhase, 1 - normalizedPhase);
          const strength = clamp(1 - (ringDistance * spacing) / thickness, 0, 1);
          if (strength <= 0.02) continue;

          const distanceFade = clamp(1 - distance / maxRadius, 0, 1);
          const edgeFade =
            clamp((x / width) * 6, 0, 1) *
            clamp((1 - x / width) * 6, 0, 1) *
            clamp((y / height) * 5, 0, 1) *
            clamp((1 - y / height) * 5, 0, 1);
          const opacity = isCompact
            ? strength * (0.38 + distanceFade * 0.58) * edgeFade
            : strength * (0.24 + distanceFade * 0.42) * edgeFade;
          if (opacity < 0.02) continue;

          const charIndex = clamp(
            Math.floor(strength * (chars.length - 1)),
            0,
            chars.length - 1,
          );
          ctx.fillStyle = `rgba(255, 116, 23, ${opacity})`;
          ctx.fillText(chars[charIndex], x, y);
        }
      }

      if (!prefersReducedMotion.matches) {
        animationFrame = requestAnimationFrame(draw);
      }
    }

    function start() {
      cancelAnimationFrame(animationFrame);
      setup();
      animationFrame = requestAnimationFrame(draw);
    }

    start();
    window.addEventListener("resize", start);
    prefersReducedMotion.addEventListener("change", start);

    return () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener("resize", start);
      prefersReducedMotion.removeEventListener("change", start);
    };
  }

  function createFluidScrollPanels() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-fluid-panel]"),
    );

    if (!panels.length) return () => {};

    const clamp = (value: number, min: number, max: number) =>
      Math.max(min, Math.min(max, value));

    let animationFrame = 0;
    let resizeObserver: ResizeObserver | null = null;

    function resetPanel(panel: HTMLElement) {
      panel.style.removeProperty("--fluid-y");
      panel.style.removeProperty("--fluid-scale");
      panel.style.removeProperty("--fluid-opacity");
      panel.style.removeProperty("--fluid-blur");
      panel.style.removeProperty("--fluid-shadow");
    }

    function update() {
      animationFrame = 0;

      if (prefersReducedMotion.matches) {
        panels.forEach(resetPanel);
        return;
      }

      const viewportHeight = Math.max(window.innerHeight, 1);
      const focusY = viewportHeight * 0.52;
      const motionRange = viewportHeight * 0.78;
      const moveAmount = window.innerWidth < 720 ? 18 : 42;

      panels.forEach((panel) => {
        const rect = panel.getBoundingClientRect();
        const panelFocus = rect.top + rect.height * 0.44;
        const distance = clamp((panelFocus - focusY) / motionRange, -1.25, 1.25);
        const presence = clamp(1 - Math.abs(distance) * 0.74, 0, 1);
        const easedPresence = 1 - Math.pow(1 - presence, 3);
        const direction = distance < 0 ? -1 : 1;
        const softenedDistance =
          direction * Math.pow(Math.abs(distance), 0.84);
        const y = softenedDistance * moveAmount * (1 - easedPresence * 0.18);
        const scale = 0.972 + easedPresence * 0.028;
        const opacity = 0.74 + easedPresence * 0.26;
        const blur = (1 - easedPresence) * 0.35;
        const shadow = easedPresence * 0.12;

        panel.style.setProperty("--fluid-y", `${y.toFixed(2)}px`);
        panel.style.setProperty("--fluid-scale", scale.toFixed(4));
        panel.style.setProperty("--fluid-opacity", opacity.toFixed(3));
        panel.style.setProperty("--fluid-blur", `${blur.toFixed(2)}px`);
        panel.style.setProperty("--fluid-shadow", shadow.toFixed(3));
      });
    }

    function scheduleUpdate() {
      if (!animationFrame) {
        animationFrame = requestAnimationFrame(update);
      }
    }

    scheduleUpdate();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    prefersReducedMotion.addEventListener("change", scheduleUpdate);

    if ("ResizeObserver" in window) {
      resizeObserver = new ResizeObserver(scheduleUpdate);
      panels.forEach((panel) => resizeObserver?.observe(panel));
    }

    return () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      prefersReducedMotion.removeEventListener("change", scheduleUpdate);
      resizeObserver?.disconnect();
      panels.forEach(resetPanel);
    };
  }

  const cleanups = [
    ...canvases.map((canvas) => createStarAsciiRenderer(canvas)),
    ...waveCanvases.map((canvas) => createAsciiWave(canvas)),
    ...rippleCanvases.map((canvas) => createAsciiRipple(canvas)),
    createFluidScrollPanels(),
  ];

  window.addEventListener("pagehide", () => {
    cleanups.forEach((cleanup) => cleanup());
  });
</script>

<!-- Scroll storytelling: GSAP ScrollTrigger choreography -->
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import SplitType from "split-type";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const ready =
    document.fonts && document.fonts.ready
      ? document.fonts.ready
      : Promise.resolve();

  // 1 — Hero: nav fades down, headline reveals line-by-line, search card slides up.
  function initHero() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const headline = document.querySelector<HTMLElement>("[data-hero-headline]");
    const cta = document.querySelector<HTMLElement>("[data-hero-cta]");
    const card = document.querySelector<HTMLElement>("[data-hero-card]");

    if (reduce) return;

    // Hide synchronously so there's no flash before the timeline runs.
    if (nav) gsap.set(nav, { opacity: 0, y: -16 });
    if (cta) gsap.set(cta, { opacity: 0, y: 22 });
    if (card) gsap.set(card, { opacity: 0, y: 40 });
    if (headline) gsap.set(headline, { opacity: 0 });

    ready.then(() => {
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
      if (nav) tl.to(nav, { opacity: 1, y: 0, duration: 0.7 }, 0);

      if (headline) {
        try {
          const split = new SplitType(headline, { types: "lines" });
          gsap.set(headline, { opacity: 1 });
          gsap.set(split.lines, { opacity: 0, y: 28 });
          tl.to(
            split.lines,
            { opacity: 1, y: 0, duration: 0.85, stagger: 0.14 },
            0.12,
          );
        } catch {
          tl.to(headline, { opacity: 1, duration: 0.8 }, 0.12);
        }
      }

      if (cta) tl.to(cta, { opacity: 1, y: 0, duration: 0.72 }, 0.42);
      if (card) tl.to(card, { opacity: 1, y: 0, duration: 0.95 }, 0.5);
    });
  }

  // Global reveal system — opt-in via attributes so each section can be tuned.
  // [data-reveal]            : element fades + rises into view
  // [data-reveal-group]      : staggers its [data-reveal] children together
  function initReveals() {
    if (reduce) return;

    gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
      if (el.closest("[data-reveal-group]")) return;
      gsap.from(el, {
        y: 26,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 86%" },
      });
    });

    gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
      const items = group.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!items.length) return;
      gsap.from(items, {
        y: 28,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        stagger: 0.12,
        scrollTrigger: { trigger: group, start: "top 82%" },
      });
    });
  }

  // Count-up — numbers tick from 0 to their value once, when scrolled into view.
  // <span data-count="2000" data-count-prefix="$" data-count-suffix="+"></span>
  function initCounters() {
    gsap.utils.toArray<HTMLElement>("[data-count]").forEach((el) => {
      const target = parseFloat(el.dataset.count || "0");
      const prefix = el.dataset.countPrefix || "";
      const suffix = el.dataset.countSuffix || "";
      const decimals = parseInt(el.dataset.countDecimals || "0", 10);
      const format = (n: number) =>
        prefix +
        n.toLocaleString("en-US", {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }) +
        suffix;

      el.textContent = reduce ? format(target) : format(0);
      if (reduce) return;

      ScrollTrigger.create({
        trigger: el,
        start: "top 80%",
        once: true,
        onEnter: () => {
          const obj = { v: 0 };
          gsap.to(obj, {
            v: target,
            duration: 1.5,
            ease: "power2.out",
            onUpdate: () => {
              el.textContent = format(obj.v);
            },
          });
        },
      });
    });
  }

  function initContributionWall() {
    const backdrop = document.querySelector<HTMLElement>("[data-contrib-wall-backdrop]");
    if (!backdrop) return;

    const COLORS = ["#f3ebe6", "#ffe4d1", "#ffc9a3", "#ff9f52", "#ff7417"];
    const CELL = 7;
    const CELL_GAP = 3;
    const TILE_GAP = 8;
    const TILE_WIDTH = Math.ceil(182 / 7) * (CELL + CELL_GAP) - CELL_GAP;
    const TILE_HEIGHT = 7 * (CELL + CELL_GAP) - CELL_GAP;

    type ContributionWall = {
      githubUsername: string;
      displayName: string;
      initials: string;
      totalContributions: number;
      levels: number[];
    };

    function encodeLevelsFromDays(days: Array<{ count: number }>) {
      return days.slice(-182).map((day) => {
        const count = day.count;
        if (count <= 0) return 0;
        if (count <= 3) return 1;
        if (count <= 6) return 2;
        if (count <= 9) return 3;
        return 4;
      });
    }

    function normalizeWall(raw: ContributionWall & { days?: Array<{ count: number }> }): ContributionWall {
      if (Array.isArray(raw.levels) && raw.levels.length > 0) return raw;
      if (Array.isArray(raw.days) && raw.days.length > 0) {
        return { ...raw, levels: encodeLevelsFromDays(raw.days) };
      }
      return { ...raw, levels: [] };
    }

    function renderContributionSvg(levels: number[]) {
      if (!levels.length) return "";
      const rows = 7;
      const cols = Math.ceil(levels.length / rows);
      const width = cols * (CELL + CELL_GAP) - CELL_GAP;
      const height = rows * (CELL + CELL_GAP) - CELL_GAP;
      const rects: string[] = [];

      for (let i = 0; i < levels.length; i += 1) {
        const col = Math.floor(i / rows);
        const row = i % rows;
        const x = col * (CELL + CELL_GAP);
        const y = row * (CELL + CELL_GAP);
        const fill = COLORS[levels[i]] ?? COLORS[0];
        rects.push(`<rect x="${x}" y="${y}" width="${CELL}" height="${CELL}" rx="1.5" fill="${fill}"/>`);
      }

      return `<svg class="contrib-graph-svg" viewBox="0 0 ${width} ${height}" width="${width}" height="${height}" aria-hidden="true">${rects.join("")}</svg>`;
    }

    function renderWall(wall: ContributionWall) {
      const graph = renderContributionSvg(wall.levels);
      if (!graph) return "";
      return `<span class="contrib-wall-tile">${graph}</span>`;
    }

    function paintBackdrop(walls: ContributionWall[]) {
      const normalized = walls
        .map(normalizeWall)
        .filter((wall) => wall.levels.length > 0)
        .sort((a, b) => Number(b.totalContributions || 0) - Number(a.totalContributions || 0));
      if (!normalized.length) return;

      const wallHost = backdrop.closest<HTMLElement>(".grind-content");
      const wallHostRect = wallHost?.getBoundingClientRect();
      const panelWidth = Math.max(wallHostRect?.width || backdrop.clientWidth || 1200, 320);
      const panelHeight = Math.max(wallHostRect?.height || backdrop.clientHeight || 520, 280);

      const cols = Math.max(
        1,
        Math.ceil((panelWidth - TILE_GAP * 2 + TILE_GAP) / (TILE_WIDTH + TILE_GAP)),
      );
      const rows = Math.max(
        1,
        Math.ceil((panelHeight - TILE_GAP * 2 + TILE_GAP) / (TILE_HEIGHT + TILE_GAP)),
      );
      const segmentSlots = cols * rows;
      const segment = normalized.slice(0, segmentSlots).map((wall) => renderWall(wall)).join("");

      backdrop.style.setProperty("--tile-w", `${TILE_WIDTH}px`);
      backdrop.style.setProperty("--tile-h", `${TILE_HEIGHT}px`);
      backdrop.style.setProperty("--rows", String(rows));
      backdrop.innerHTML = `
        <div class="contrib-wall-segment">${segment}</div>
      `;
    }

    async function loadWalls() {
      backdrop.innerHTML = "";
      try {
        const res = await fetch("/api/builders/github-contributions");
        if (!res.ok) return;
        const data = await res.json();
        if (!data?.success || !Array.isArray(data.walls) || data.walls.length === 0) return;
        (backdrop as HTMLElement & { __walls?: ContributionWall[] }).__walls = data.walls as ContributionWall[];
        requestAnimationFrame(() => {
          requestAnimationFrame(() => paintBackdrop(data.walls as ContributionWall[]));
        });
      } catch {
        // Keep the last rendered backdrop if loading fails.
      }
    }

    function repaintFromCache() {
      const cached = (backdrop as HTMLElement & { __walls?: ContributionWall[] }).__walls;
      if (cached?.length) {
        requestAnimationFrame(() => paintBackdrop(cached));
      }
    }

    loadWalls();
    window.addEventListener("load", repaintFromCache);

    const wallHost = backdrop.closest<HTMLElement>(".grind-content");
    if (wallHost && "ResizeObserver" in window) {
      const observer = new ResizeObserver(() => repaintFromCache());
      observer.observe(wallHost);
    } else {
      window.addEventListener("resize", repaintFromCache);
    }
  }

  initHero();
  initReveals();
  initCounters();
  initContributionWall();

  // Recompute trigger positions once images/fonts settle.
  ready.then(() => ScrollTrigger.refresh());
  window.addEventListener("load", () => ScrollTrigger.refresh());

  window.addEventListener("pagehide", () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>

