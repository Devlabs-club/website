---

<Layout
  title="DevLabs - Hire builders who can actually ship"
  hideNavbar
  hideFooter
  skipPageLoader
  skipParallax
>
  <main class="landing-page min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
    <header data-nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-8 sm:px-8 lg:px-10">
      <a href="/" aria-label="DevLabs home" class="inline-flex items-center">
        <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
      </a>

      <nav class="hidden items-center gap-11 text-[15px] font-medium text-black md:flex">
        {navLinks.map((link) => (
          <a href={link.href} class="transition-colors hover:text-[#ff7417]">
            {link.label}
          </a>
        ))}
        <a
          href={ctaHref}
          class="relative px-2 py-1 text-[#ff7417] transition-colors hover:text-black"
        >
          <span class="pointer-events-none absolute -left-1 top-0 h-2.5 w-2.5 border-l border-t border-[#ff7417]"></span>
          <span class="pointer-events-none absolute -right-1 top-0 h-2.5 w-2.5 border-r border-t border-[#ff7417]"></span>
          <span class="pointer-events-none absolute -bottom-0 -left-1 h-2.5 w-2.5 border-b border-l border-[#ff7417]"></span>
          <span class="pointer-events-none absolute -bottom-0 -right-1 h-2.5 w-2.5 border-b border-r border-[#ff7417]"></span>
          Hire now
        </a>
      </nav>

      <a
        href={ctaHref}
        class="relative px-2 py-1 text-sm font-medium text-[#ff7417] md:hidden"
      >
        Hire now
      </a>
    </header>

    <section class="hero-section ruler-section relative mx-auto flex w-full max-w-7xl flex-col items-center overflow-hidden px-6 pb-24 pt-24 text-center sm:px-8 lg:px-10">
      <canvas
        class="ascii-star hero-star-left absolute left-[max(-12rem,-13vw)] top-32 h-[clamp(22rem,32vw,32rem)] w-[clamp(22rem,32vw,32rem)] -rotate-[22deg]"
        data-star-canvas
        aria-hidden="true"
      ></canvas>
      <canvas
        class="ascii-star hero-star-right absolute right-[max(-11rem,-12vw)] top-20 h-[clamp(20rem,30vw,30rem)] w-[clamp(20rem,30vw,30rem)] rotate-[10deg]"
        data-star-canvas
        aria-hidden="true"
      ></canvas>

      <h1 data-hero-headline class="relative z-10 max-w-4xl text-[clamp(2rem,9.6vw,5.6rem)] font-normal leading-[1.18] tracking-[-0.035em] text-black">
        Hire
        <br class="sm:hidden" />
        <span class="relative inline-block font-extrabold">
          builders
         </span>
        <br class="sm:hidden" />
        who can<br />
        actually <br class="sm:hidden" /><span class="ml-[0.22em] font-extrabold">ship</span>
      </h1>

      <a
        href={ctaHref}
        data-hero-cta
        class="hero-start-cta group relative z-10 mt-8 inline-flex h-[3.35rem] min-w-[10.75rem] items-center justify-center overflow-hidden rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-9 text-sm font-extrabold text-white shadow-[0_16px_36px_rgba(5,5,5,0.12)] transition-[background-color,color,border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417] hover:text-white hover:shadow-[0_16px_36px_rgba(255,116,23,0.22)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1f2422]"
      >
        <canvas
          class="hero-start-cta-ripple absolute inset-0 h-full w-full"
          data-ascii-ripple="compact"
          aria-hidden="true"
        ></canvas>
        <span class="relative z-10">start now</span>
      </a>

      <div data-hero-card class="relative z-10 mt-16 w-full max-w-[1210px]">
        <div class="relative min-h-[520px] overflow-hidden rounded-[34px] border-[3px] border-[#168df7] bg-[#cfe6e9] shadow-[0_18px_55px_rgba(12,62,96,0.12)] sm:min-h-[390px] lg:min-h-[475px]">
          <img
            src="/landing/hero-meadow.png"
            alt=""
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-white/5"></div>

          <span class="selection-dot left-7 top-7"></span>
          <span class="selection-dot right-7 top-7"></span>
          <span class="selection-dot bottom-7 left-7"></span>
          <span class="selection-dot bottom-7 right-7"></span>

          <div class="hero-builder-card absolute left-1/2 top-[8%] w-[calc(100%_-_1rem)] -translate-x-1/2 border-2 border-black bg-white p-4 text-left shadow-[0_14px_24px_rgba(0,0,0,0.06)] sm:top-[12%] sm:w-[min(84%,820px)] sm:p-5">
            <div class="mb-3 inline-flex items-center gap-2 border border-[#ff7417]/60 bg-[#fff5ef] px-3 py-2 text-sm font-semibold text-[#bf4f08]">
              <span class="text-[#ff7417]">✦</span>
              Builder search
            </div>

            <div class="hero-search-input relative flex items-center gap-2 border border-black bg-white px-3 py-3 sm:gap-4 sm:px-4" aria-label="Find me a cracked App dev with expertise in stripe integration">
              <svg class="h-4 w-4 shrink-0 text-black sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <p class="min-w-0 flex-1 overflow-hidden text-[0.68rem] font-normal tracking-[-0.02em] text-black min-[380px]:text-[0.7rem] min-[440px]:text-[0.82rem] sm:text-[clamp(0.95rem,1.9vw,1.5rem)]">
                <span class="hero-typewriter-text">Find me a cracked App dev with expertise in stripe integration</span>
              </p>
              <a
                href="/auth/signup"
                aria-label="Search builders"
                class="hero-search-submit hidden h-10 w-10 shrink-0 place-items-center border border-black text-[#ff7417] transition-colors hover:bg-[#ff7417] hover:text-white sm:grid"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
              <div class="hero-loading-row" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </div>

            <div class="mt-4 grid gap-3 md:grid-cols-2">
              <div class="hero-result-card border border-black/15 bg-[#fffaf7] p-3">
                <div class="flex items-start gap-3">
                  <div class="grid h-10 w-10 shrink-0 place-items-center bg-[#ff7417] text-sm font-extrabold text-white">AV</div>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-bold text-black">Aarav V.</p>
                    <p class="mt-0.5 text-xs text-black/55">iOS + AI agents · 94% match</p>
                  </div>
                </div>
                <p class="mt-3 text-xs leading-relaxed text-black/60">
                  Shipped a campus rides app, vision-based receipt scanner, and two Swift demos.
                </p>
              </div>

              <div class="hero-result-card hero-result-card-two border border-black/15 bg-[#fffaf7] p-3">
                <div class="flex items-start gap-3">
                  <div class="grid h-10 w-10 shrink-0 place-items-center bg-black text-sm font-extrabold text-white">NK</div>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-bold text-black">Niki K.</p>
                    <p class="mt-0.5 text-xs text-black/55">React Native · 91% match</p>
                  </div>
                </div>
                <p class="mt-3 text-xs leading-relaxed text-black/60">
                  Built and launched three mobile prototypes with clean GitHub history.
                </p>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              {["App dev", "Shipped projects", "Hackathon finalist", "Available this week"].map((signal) => (
                <span class="hero-signal-chip border border-[#ff7417]/35 bg-[#fff5ef] px-2.5 py-1 text-xs font-semibold text-[#bf4f08]">
                  {signal}
                </span>
              ))}
            </div>

            <span class="hero-search-cursor" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.2 2.8 20.8 12l-7.1 1.4 3.9 6.7-3.1 1.8-3.8-6.6-4.8 5.4L4.2 2.8Z"></path>
              </svg>
            </span>
          </div>
        </div>

        <span class="corner-square -left-2 -top-2"></span>
        <span class="corner-square -right-2 -top-2"></span>
        <span class="corner-square -bottom-2 -left-2"></span>
        <span class="corner-square -bottom-2 -right-2"></span>
      </div>
    </section>

    <section class="ruler-section relative isolate overflow-hidden bg-[#fbf6f3] px-6 py-0 text-black sm:px-8 lg:px-10">
      <div class="ruler-rails" aria-hidden="true"></div>
      <canvas
        class="ascii-wave absolute inset-0 h-full w-full opacity-100 mix-blend-multiply"
        data-ascii-wave
        aria-hidden="true"
      ></canvas>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_38%,rgba(255,116,23,0.24),rgba(255,116,23,0.1)_34%,transparent_68%),linear-gradient(90deg,#fbf6f3_0%,rgba(251,246,243,0.2)_18%,rgba(251,246,243,0)_50%,rgba(251,246,243,0.2)_82%,#fbf6f3_100%),linear-gradient(180deg,rgba(251,246,243,0.34),rgba(251,246,243,0.52)_72%)]"></div>
      <div class="absolute inset-x-0 top-0 h-px bg-black/10"></div>

      <div class="relative z-10 mx-auto w-full max-w-7xl py-16 sm:py-20">
        <div data-fluid-panel class="overflow-hidden rounded-none border border-black/10 bg-[#fbf6f3]/82 backdrop-blur-[1px]">
          <div class="border-b border-black/10 px-6 py-6 sm:px-10">
            <p class="text-[clamp(1.15rem,1.8vw,1.55rem)] font-semibold tracking-[-0.02em] text-black/68">
              Worked with folks from
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5">
            <div class="flex min-h-[15rem] flex-col justify-between border-b border-black/10 bg-[#f4f1ed]/88 p-8 sm:col-span-2 lg:col-span-1 lg:row-span-2 lg:border-b-0 lg:border-r">
               <div>
                <p class="text-[clamp(2.5rem,4vw,3.8rem)] leading-none text-[#ff7417]">
                Backed by
                </p>
                <p class="mt-5 max-w-xs text-base font-medium leading-relaxed text-black/62">
                  We know these builders through events, shipped projects, and community momentum.
                </p>
              </div>
            </div>

            {folksLogos.map((logo) => (
              <div class="logo-cell flex min-h-[8.5rem] items-center justify-center border-b border-black/10 p-8 sm:border-r lg:min-h-[9.5rem]">
                <img
                  src={logo.src}
                  alt={logo.label}
                  loading="lazy"
                  class="max-h-10 max-w-[9.5rem] object-contain opacity-54 transition duration-300 hover:opacity-90"
                  style="filter: grayscale(1) brightness(0);"
                />
              </div>
            ))}

            <div class="logo-cell hidden min-h-[9.5rem] items-center justify-center border-b border-black/10 p-8 text-center text-sm font-semibold leading-relaxed text-black/38 lg:flex">
              Builders seen in the room, not just on paper
            </div>
          </div>
        </div>

        <div data-fluid-panel class="mx-auto mt-24 max-w-[22rem] text-center sm:mt-28 sm:max-w-5xl">
          <h2 class="text-[clamp(2rem,9.8vw,6.4rem)] font-black leading-[0.96] tracking-[-0.04em] text-black sm:leading-[0.93]">
            Hiring
            <br class="sm:hidden" />
            through
            <br class="sm:hidden" />
            resumes is
            <br class="sm:hidden" />
            broken.
            <span class="mt-3 block font-normal text-black/72">
              You need
              <br class="sm:hidden" />
              people
              <br class="sm:hidden" />
              who can
              <br class="sm:hidden" />
              <span class="relative inline-block font-black text-black">
                ship
               </span>
            </span>
          </h2>

          <p class="mx-auto mt-9 max-w-3xl text-[clamp(1.1rem,2vw,1.6rem)] font-medium leading-relaxed text-black/58">
            DevLabs already knows those people because we watch them build at our events.
          </p>
        </div>
      </div>
    </section>

    <section class="metrics-section ruler-section relative isolate overflow-hidden bg-[#fbf6f3] px-6 pb-0 pt-24 text-black sm:px-8 lg:px-10">

      <div class="relative z-10 mx-auto w-full max-w-7xl">
        <!-- <div class="grid gap-10 border-x border-black/10 px-8 py-8 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-10">
          <div>
            
            <h2 class="mt-5 max-w-4xl text-[clamp(3.6rem,7.2vw,7.8rem)] font-black leading-[0.9] tracking-[-0.055em] text-black">
              Built from a real builder ecosystem.
            </h2>
          </div>
          <div class="flex items-end">
            <p class="max-w-xl text-[clamp(1.1rem,1.65vw,1.45rem)] font-medium leading-relaxed text-black/58">
              DevLabs sees builders before a resume does: who shows up, what they ship, and who founders trust when the deadline is real.
            </p>
          </div>
        </div> -->

        <div data-fluid-panel class="grid border border-black/10 lg:grid-cols-3">
          <article class="metric-card metric-card-orange relative min-h-[24rem] overflow-hidden border-b border-black/10 bg-[#ff7417] p-8 text-white lg:border-b-0 lg:border-r">
            <div class="relative z-10 flex h-full flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-white/[0.18] px-3 py-1 text-xs font-extrabold uppercase tracking-[0.18em]">
                  network
                </span>
                <span class="grid h-10 w-10 place-items-center border border-white/30 bg-white/10 text-lg font-black">01</span>
              </div>

              <div>
                <p class="metric-number text-[clamp(5rem,6vw,7rem)] font-black leading-none tracking-[-0.07em] 2xl:text-[clamp(5.5rem,6vw,8rem)]">
                  <span data-count="2000" data-count-suffix="+">2,000+</span>
                </p>
                <p class="mt-5 max-w-sm text-2xl font-extrabold leading-tight tracking-[-0.03em]">
                  Builders in the DevLabs network
                </p>
              </div>
