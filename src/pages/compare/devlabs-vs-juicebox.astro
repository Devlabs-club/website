---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import SeoPageShell from "../../components/seo/SeoPageShell.astro";
import { breadcrumbSchema, organizationSchema, seoKeywords, websiteSchema } from "../../lib/seo";

const title = "DevLabs vs Juicebox for Engineering Hiring";
const description =
  "Compare DevLabs and Juicebox for startup engineering hiring. Juicebox is built around talent search; DevLabs is built around proof of work.";

const comparisonCards = [
  {
    name: "DevLabs",
    label: "Depth first",
    headline: "Start with proof of work.",
    body:
      "Built for founders hiring early engineers, where the real question is whether this person can actually build with the team.",
    points: ["Projects and demos", "GitHub and technical work", "Hackathons, hacker houses, and agent traces"],
  },
  {
    name: "Juicebox",
    label: "Breadth first",
    headline: "Start with talent search.",
    body:
      "Useful for recruiting teams that need to source broadly, build large pipelines, and search across a large talent market.",
    points: ["Professional profiles", "Recruiting data", "Large-scale sourcing workflows"],
  },
];

const lenses = [
  ["The search question", "Who matches the query?", "Who has actually shown useful builder signal?"],
  ["The hiring moment", "Large pipeline creation", "Engineer #2, #4, or #8 at a startup"],
  ["The founder output", "More people to review", "A shorter list worth calling"],
];
---

<Layout
  title={title}
  description={description}
  keywords={seoKeywords}
  canonicalPath="/compare/devlabs-vs-juicebox"
  hideNavbar
  hideFooter
  skipPageLoader
  skipParallax
  structuredData={[
    organizationSchema,
    websiteSchema,
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "DevLabs vs Juicebox", path: "/compare/devlabs-vs-juicebox" },
    ]),
  ]}
>
  <SeoPageShell
    eyebrow="DevLabs vs Juicebox"
    title={'Two very different ways to <span class="font-extrabold">find talent.</span>'}
    intro={"Juicebox starts with the talent market. DevLabs starts with builders. That sounds like a small difference, but it changes almost everything about how the products work."}
  >
    <section class="mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-10">
      <div class="compare-split">
        {comparisonCards.map((card) => (
          <article class:list={["compare-card", card.name === "DevLabs" && "compare-card--featured"]}>
            <div class="compare-card__top">
              <span>{card.label}</span>
              <strong>{card.name}</strong>
            </div>
            <h2>{card.headline}</h2>
            <p>{card.body}</p>
            <ul>
              {card.points.map((point) => (
                <li><span></span>{point}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="compare-lens">
        {lenses.map(([label, juicebox, devlabs]) => (
          <article>
            <p><span></span>{label}</p>
            <div class="compare-lens__side">
              <span>Juicebox</span>
              <strong>{juicebox}</strong>
            </div>
            <div class="compare-lens__side compare-lens__side--devlabs">
              <span>DevLabs</span>
              <strong>{devlabs}</strong>
            </div>
          </article>
        ))}
      </div>

      <div class="compare-notes">
        {[
          ["Where Juicebox makes more sense", "If you have a recruiting team and need to build a large pipeline across lots of roles, broad search is useful. You want reach. You want filters. You want sourcing infrastructure. Juicebox was built around that problem."],
          ["Where DevLabs makes more sense", "We're much narrower. DevLabs is for founders and small teams making important technical hires. The person you hire might be engineer #2, #4, or #8. At that stage, the question is usually not: \"Can I find 200 more software engineers?\" It is: \"Which five of these people would I actually trust to build this company with me?\" That's the problem we care about."],
          ["The simplest way to think about it", "Juicebox gives you breadth. DevLabs tries to give you depth. Sometimes you need the first. For early startup engineering hires, we think the second matters a lot more."],
        ].map(([heading, body]) => (
          <article>
            <h2>{heading}</h2>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>
  </SeoPageShell>

  <style>
    .compare-split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .compare-card {
      min-height: 430px;
      border: 1px solid rgba(16, 11, 9, 0.1);
      background: rgba(255, 255, 255, 0.86);
      padding: 34px;
      box-shadow: 0 22px 52px rgba(16, 11, 9, 0.06);
    }

    .compare-card--featured {
      background:
        radial-gradient(circle at 88% 12%, rgba(255, 116, 23, 0.18), transparent 32%),
        #fffaf6;
      border-color: rgba(255, 116, 23, 0.28);
    }

    .compare-card__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 64px;
      color: rgba(16, 11, 9, 0.48);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .compare-card--featured .compare-card__top {
      color: #ff7417;
    }

    .compare-card h2 {
      max-width: 520px;
      color: #100b09;
      font-size: 2.45rem;
      font-weight: 760;
      letter-spacing: 0;
      line-height: 1.02;
    }

    .compare-card p {
      margin-top: 18px;
      max-width: 520px;
      color: rgba(16, 11, 9, 0.68);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .compare-card ul {
      display: grid;
      gap: 12px;
      margin-top: 34px;
    }

    .compare-card li {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(16, 11, 9, 0.76);
      font-size: 0.98rem;
    }

    .compare-card li span {
      width: 8px;
      height: 8px;
      flex: 0 0 8px;
      background: #ff7417;
    }

    .compare-lens {
      display: grid;
      margin-top: 26px;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(255, 116, 23, 0.16), transparent 28%),
        radial-gradient(circle at 88% 0%, rgba(255, 116, 23, 0.12), transparent 34%),
        #100b09;
      padding: 24px;
      color: #fff;
      clip-path: polygon(0 0, calc(100% - 34px) 0, 100% 34px, 100% 100%, 34px 100%, 0 calc(100% - 34px));
    }

    .compare-lens article {
      display: grid;
      grid-template-columns: 0.68fr 1fr 1.12fr;
      align-items: stretch;
      min-height: 128px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .compare-lens article:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .compare-lens article > * {
      padding: 26px 30px;
    }

    .compare-lens p {
      display: flex;
      align-items: center;
      gap: 12px;
      border-right: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.035);
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.82rem;
      font-weight: 850;
      letter-spacing: 0.18em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .compare-lens p span {
      width: 9px;
      height: 9px;
      flex: 0 0 9px;
      background: #ff7417;
    }

    .compare-lens span {
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .compare-lens strong {
      display: block;
      margin-top: 14px;
      color: rgba(255, 255, 255, 0.88);
      font-size: 1.35rem;
      font-weight: 620;
      letter-spacing: 0;
      line-height: 1.18;
    }

    .compare-lens__side {
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }

    .compare-lens__side--devlabs {
      border-right: 0;
      background:
        linear-gradient(90deg, rgba(255, 116, 23, 0.17), rgba(255, 116, 23, 0.04));
    }

    .compare-lens__side--devlabs span {
      color: #ff7417;
    }

    .compare-lens__side--devlabs strong {
      color: #fff;
      font-weight: 760;
    }

    .compare-notes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 42px;
    }

    .compare-notes article {
      border: 1px solid rgba(16, 11, 9, 0.1);
      background: rgba(255, 250, 246, 0.86);
      padding: 28px;
    }

    .compare-notes h2 {
      color: #100b09;
      font-size: 1.45rem;
      font-weight: 650;
      letter-spacing: 0;
      line-height: 1.16;
    }

    .compare-notes p {
      margin-top: 16px;
      color: rgba(16, 11, 9, 0.66);
      line-height: 1.58;
    }

    @media (max-width: 900px) {
      .compare-split,
      .compare-notes,
      .compare-lens article {
        grid-template-columns: 1fr;
      }

      .compare-lens {
        padding: 18px;
      }

      .compare-lens article {
        min-height: auto;
      }

      .compare-lens article > * {
        padding: 20px;
      }

      .compare-lens p,
      .compare-lens__side {
        border-right: 0;
      }

      .compare-card {
        min-height: auto;
      }

      .compare-card__top {
        margin-bottom: 42px;
      }
    }
  </style>
</Layout>
