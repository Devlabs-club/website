---
export const prerender = true;

import Layout from '../layouts/Layout.astro';

// Event data (detailed view)
const events = [
  {
    id: 'momentum',
    name: 'Momentum',
    tagline: 'don\'t wait for the future, build it',
    description: 'Momentum is our premier program in San Francisco. A one-month intensive designed to accelerate the most ambitious builders. Supported by industry leaders, it\'s where you stop waiting and start building.',
    image: '/momentum_rocket.webp',
    stats: {
      location: 'San Francisco',
      duration: '4 Weeks',
      dates: 'Apr 17 - May 16',
      status: 'Upcoming'
    },
    partners: [
      { url: '/sponsors/momentum/spc.png', class: 'h-10 md:h-12' },
      { url: '/sponsors/momentum/a16z.png', class: 'h-8 md:h-10' },
      { url: '/sponsors/momentum/antler.png', class: 'h-10 md:h-12' },
      { url: '/sponsors/momentum/kickstart.png', class: 'h-12 md:h-14' },
      { url: '/sponsors/momentum/stripe.png', class: 'h-4 md:h-5' },
      ],
    highlights: ['San Francisco', 'Top Tier Partners', 'Intensive Build', 'Exclusive Network'],
    date: 'Spring 2026',
    status: 'upcoming',
    link: '/momentum',
    customFont: 'font-seasons',
    imageBg: '/momentum_bg.png'
  },
  {
    id: 'devhouse-sf',
    name: 'DevHouse SF',
    tagline: 'SF’s Biggest Hiring Stunt',
    description: 'DevHouse SF was a hacker house designed to immerse top 100 student builders in San Francisco’s startup ecosystem with one clear objective: to change the way startups hire. The top 100 builders live and work on problem statements from the sponsor companies.',
    image: '/events/devhouse-sf.jpg',
    stats: {
      builders: '100',
      incash: '$10,000',
      hired: '1 ',
      interview: '8'
    },
    partners: ['/sponsors/deepmind.png', '/sponsors/browser-use.png', '/sponsors/airgarage.png', '/sponsors/omi.png', '/sponsors/standout.png'],
    highlights: ['Hiring', 'Buidler Energy', ' Hacker House'],
    date: 'Summer 2025',
    status: 'completed',
    link: 'https://devhouse.devlabs.club'
  },
  {
    id: 'devhouse',
    name: 'DevHouse',
    tagline: 'Arizona\'s First Hacker House',
    description: 'DevHouse is our residential program where selected builders live together for 6 weeks, working on their projects while building lasting friendships. It\'s an intensive experience that combines living, learning, and building in a collaborative environment.',
    image: '/events/devhouse.png',
    stats: {
      residents: '12',
      weeks: '6',
      projects: '8',
      funding: '$50,000+'
    },
partners: ['/sponsors/loloft.png', '/sponsors/azvc.png', '/sponsors/phxventures.webp', '/sponsors/aca.png','/sponsors/siliconoasis.png'],
    highlights: ['Residential Program', 'Daily Standups', 'Project Showcase', 'Investor Demo Day'],
    date: 'Summer 2025',
    status: 'completed',
    link: 'https://www.gpec.org/news/press-releases/devlabs-launches-hacker-house/'
  },
  {
    id: 'devhacks',
    name: 'DevHacks',
    tagline: 'One hackathon. Infinite possibilities.',
    description: 'DevHacks is our premier hackathon that challenges participants to build innovative solutions to real-world problems. Teams work around the clock to create prototypes, learn new technologies, and compete for exciting prizes.',
    image: '/events/devhacks.jpg',
    stats: {
      participants: '180+',
      applications: '350+',
      projects: '50',
      sponsorship: '$25,000'
    },
    partners: ['/sponsors/ph.png'],
    highlights: ['48-Hour Build', 'Mentor Support', 'Pitch Competition', 'Cash Prizes'],
    date: 'Spring 2025',
    status: 'completed',
    link: 'https://devhacks.devlabs.club'
  },
  {
    id: 'devspace',
    name: 'DevSpace',
    tagline: 'Go Big @ ASU',
    description: 'DevSpace is our flagship networking and learning event that brings together Arizona\'s brightest developers, designers, and entrepreneurs. A day filled with workshops, lightning talks, and networking opportunities.<br><br> Special thanks to <a href="https://www.linkedin.com/in/hamidshojaee/" target="_blank" rel="noopener noreferrer" class="text-orange-400 hover:text-orange-300 underline underline-offset-2 font-medium">Hamid Shojaee</a> for his support and belief in our mission—we\'re grateful for everything he did to make Devspace possible.',
    image: '/events/devspace.webp',
    stats: {
      participants: '60+',
      speakers: '7',
      workshops: '5',
      collaborations: '25+'
    },
    partners: [ '/sponsors/e+i.png'],
    highlights: ['Networking Sessions', 'Technical Workshops', 'Startup Pitches', 'Mentorship Opportunities'],
    date: 'Fall 2024',
    status: 'completed',
    link: 'https://devspace.devlabs.club'
    }
];
---

<Layout title="Events - DevLabs Signature Experiences" hideNavbar hideFooter skipPageLoader skipParallax>
    <main class="devlabs-paper min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
        <!-- Nav -->
        <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-8 sm:px-8 lg:px-10">
            <a href="/" aria-label="DevLabs home" class="inline-flex items-center">
                <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
            </a>
            <nav class="hidden items-center gap-11 text-[15px] font-medium text-black md:flex">
                <a href="/sponsor" class="transition-colors hover:text-[#ff7417]">Sponsor</a>
                <a href="/events" class="text-[#ff7417]">Events</a>
                <a href="/about" class="transition-colors hover:text-[#ff7417]">Our Story</a>
                <a href="https://cal.com/geekydan/15min?overlayCalendar=true" class="relative px-2 py-1 text-[#ff7417] transition-colors hover:text-black">
                    <span class="pointer-events-none absolute -left-1 top-0 h-2.5 w-2.5 border-l border-t border-[#ff7417]"></span>
                    <span class="pointer-events-none absolute -right-1 top-0 h-2.5 w-2.5 border-r border-t border-[#ff7417]"></span>
                    <span class="pointer-events-none absolute -bottom-0 -left-1 h-2.5 w-2.5 border-b border-l border-[#ff7417]"></span>
                    <span class="pointer-events-none absolute -bottom-0 -right-1 h-2.5 w-2.5 border-b border-r border-[#ff7417]"></span>
                    Hire now
                </a>
            </nav>
            <a href="https://cal.com/geekydan/15min?overlayCalendar=true" class="relative px-2 py-1 text-sm font-medium text-[#ff7417] md:hidden">Hire now</a>
        </header>

        <!-- Hero -->
        <section class="ruler-section relative mx-auto w-full max-w-7xl px-6 pb-20 pt-16 sm:px-8 lg:px-10">
            <div class="ruler-rails" aria-hidden="true"></div>
            <div class="relative z-10 max-w-4xl">
                <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">devlabs events</p>
                <h1 class="mt-6 text-[clamp(2.4rem,9vw,5.6rem)] font-black leading-[0.96] tracking-[-0.05em] text-black">
                    Where builders <span class="text-[#ff7417]">go big</span>.
                </h1>
                <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.4rem)] font-medium leading-relaxed text-black/62">
                    From 48-hour hackathons to month-long hacker houses — these are the rooms
                    where we watch builders ship, and where founders find them.
                </p>
            </div>
        </section>

        <!-- Events List -->
        <div class="relative mx-auto flex max-w-7xl flex-col gap-24 px-6 pb-28 pt-4 sm:gap-32 sm:px-8 lg:px-10">
            {events.map((event, index) => (
                <section class={`flex flex-col items-center gap-12 lg:flex-row lg:gap-20 ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>

                    <!-- Image frame -->
                    <div class="w-full lg:w-5/12">
                        <div class="relative">
                            <div class="relative aspect-[4/5] overflow-hidden border-[3px] border-black bg-[#cfe6e9]">
                                {event.imageBg && (
                                    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style={`background-image: url('${event.imageBg}')`}></div>
                                )}
                                {event.image ? (
                                    <img
                                        src={event.image}
                                        alt={event.name}
                                        loading="lazy"
                                        class={`h-full w-full ${event.imageBg ? 'relative z-10 scale-110 object-contain drop-shadow-2xl' : 'object-cover'}`}
                                    />
                                ) : (
                                    <div class="h-full w-full bg-[#1a1a1a]"></div>
                                )}
                                <span class="absolute left-4 top-4 z-20 border border-black bg-[#fffaf7] px-2.5 py-1 text-[0.62rem] font-extrabold uppercase tracking-[0.18em] text-black">
                                    {event.status === 'upcoming' ? 'Upcoming' : 'Shipped'}
                                </span>
                                <span class="absolute bottom-4 left-4 right-4 z-20 text-3xl font-black tracking-[-0.04em] text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)] sm:text-4xl">
                                    {event.name}
                                </span>
                            </div>
                            <!-- corner squares -->
                            <span class="corner-square -left-2 -top-2"></span>
                            <span class="corner-square -right-2 -top-2"></span>
                            <span class="corner-square -bottom-2 -left-2"></span>
                            <span class="corner-square -bottom-2 -right-2"></span>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="w-full space-y-9 lg:w-7/12">
                        <div>
                            <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-black/40">
                                {String(index + 1).padStart(2, '0')} / {String(events.length).padStart(2, '0')} · {event.date}
                            </p>
                            <h2 class="mt-5 text-[clamp(2rem,5.4vw,3.6rem)] font-black leading-[0.96] tracking-[-0.05em] text-black">
                                <span class="relative inline">
                                    {event.tagline}
                                    <span class="absolute bottom-1 left-0 -z-10 h-[0.18em] w-full -rotate-1 bg-[#ff7417]/80" aria-hidden="true"></span>
                                </span>
                            </h2>
                            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-black/62 [&_a]:font-semibold [&_a]:text-[#bf4f08] [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-[#ff7417]" set:html={event.description}></p>
                        </div>

                        <!-- Stats -->
                        {event.stats && (
                            <div class="grid grid-cols-2 border border-black/12 bg-[#fffaf7] sm:grid-cols-4">
                                {Object.entries(event.stats).map(([key, value], i, arr) => (
                                    <div class={`border-black/12 p-5 ${i % 2 === 0 ? 'border-r' : ''} ${i < arr.length - (arr.length % 2 === 0 ? 2 : 1) ? 'border-b sm:border-b-0' : ''} sm:border-r sm:[&:nth-child(4n)]:border-r-0`}>
                                        <div class="text-2xl font-black tracking-[-0.04em] text-black">{value}</div>
                                        <div class="mt-1 text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-black/45">{key}</div>
                                    </div>
                                ))}
                            </div>
                        )}

                        <!-- Sponsored by -->
                        {event.partners && event.partners.length > 0 && (
                            <div class="border-t border-black/10 pt-7">
                                <div class="mb-5 text-[0.7rem] font-extrabold uppercase tracking-[0.2em] text-black/40">
                                    Sponsored by
                                </div>
                                <div class="flex flex-wrap items-center gap-8 opacity-80 transition-opacity duration-300 hover:opacity-100 md:gap-10">
                                    {event.partners.map(partner => {
                                        const isObject = typeof partner === 'object';
                                        const logoUrl = isObject ? partner.url : partner;
                                        const customClass = isObject && partner.class ? partner.class : 'h-7 md:h-9 max-w-[140px]';
                                        return (
                                            <img src={logoUrl} alt="Partner" class={`${customClass} w-auto object-contain`} />
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        <!-- Action -->
                        <div class="pt-1">
                            <a
                                href={event.link || '#'}
                                target={event.link?.startsWith('http') ? '_blank' : undefined}
                                class="group inline-flex items-center gap-3 rounded-full border-2 border-black px-8 py-3.5 text-base font-extrabold text-black transition hover:bg-black hover:text-white"
                            >
                                <span>Visit website</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </a>
                        </div>
                    </div>

                </section>
            ))}
        </div>

        <!-- Closing CTA (dark act) -->
        <section class="relative bg-[#0d0a09] px-5 py-24 text-white sm:px-8 sm:py-32 lg:px-10">
            <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
                <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.24em] text-white/40">come build with us</p>
                <h2 class="mt-6 text-[clamp(2.25rem,9vw,4.5rem)] font-black leading-[0.98] text-white">
                    The next room is filling up.
                </h2>
                <p class="mx-auto mt-5 max-w-md text-[clamp(0.98rem,1.4vw,1.18rem)] font-medium leading-relaxed text-white/75">
                    Whether you're hiring builders or want to back the next cohort — there's a seat for you.
                </p>
                <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                    <a href="https://cal.com/geekydan/15min?overlayCalendar=true" class="group inline-flex items-center justify-center gap-3 rounded-full bg-white px-7 py-3.5 text-base font-black text-[#1a1a1a] transition hover:bg-[#ff7417] hover:text-white">
                        Hire with proof
                        <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </a>
                    <a href="/sponsor" class="inline-flex items-center justify-center rounded-full border border-white/25 px-7 py-3.5 text-base font-black text-white/80 transition hover:border-white hover:text-white">
                        Sponsor an event
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .devlabs-paper {
        font-family: Manrope, system-ui, sans-serif;
        letter-spacing: 0;
    }

    .ruler-section {
        position: relative;
    }

    .ruler-section::before,
    .ruler-section::after {
        content: "";
        position: absolute;
        left: 50%;
        z-index: 0;
        width: 100vw;
        height: 1px;
        transform: translateX(-50%);
        background: rgba(5, 5, 5, 0.1);
        pointer-events: none;
    }

    .ruler-section::before { top: 0; }
    .ruler-section::after { bottom: 0; }

    .ruler-rails {
        position: absolute;
        inset-block: 0;
        left: 50%;
        z-index: 0;
        width: min(calc(100% - 3rem), 80rem);
        transform: translateX(-50%);
        border-inline: 1px solid rgba(5, 5, 5, 0.08);
        pointer-events: none;
    }

    .ruler-rails::before,
    .ruler-rails::after {
        content: "";
        position: absolute;
        inset-block: 0;
        width: 1px;
        background: rgba(5, 5, 5, 0.055);
    }

    .ruler-rails::before { left: 25%; }
    .ruler-rails::after { right: 25%; }

    .corner-square {
        position: absolute;
        width: 18px;
        height: 18px;
        border: 3px solid #168df7;
        background: #fbf6f3;
        z-index: 30;
    }

    @media (max-width: 640px) {
        .ruler-rails { display: none; }
    }
</style>
