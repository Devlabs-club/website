---
/**
 * Minimal status page — cream paper, Manrope, small ASCII mark, landing CTAs.
 */
interface Props {
  ascii: string;
  asciiAccent?: string;
  headline: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  ascii,
  asciiAccent = '#ff7417',
  headline,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<main class="status-route flex min-h-screen flex-col bg-[#fbf6f3] text-[#050505]">
  <header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-8 sm:px-8 lg:px-10">
    <a href="/" aria-label="DevLabs home" class="inline-flex items-center gap-2.5">
      <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
      <span class="text-lg font-extrabold tracking-[-0.02em]">DevLabs</span>
    </a>
  </header>

  <section class="mx-auto flex w-full max-w-xl flex-1 flex-col items-center justify-center px-6 pb-24 text-center sm:px-8">
    <pre
      class="status-ascii overflow-x-auto font-mono text-[clamp(0.55rem,2.2vw,0.95rem)] leading-[1.12] tracking-tight"
      style={`color: ${asciiAccent}`}
      aria-hidden="true">{ascii}</pre>

    <h1 class="mt-10 text-[clamp(1.85rem,4.5vw,2.5rem)] font-extrabold leading-[1.1] tracking-[-0.04em]">
      {headline}
    </h1>
    <p class="mt-3 max-w-md text-base font-medium leading-relaxed text-black/55">
      {description}
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={primaryHref}
        class="inline-flex h-12 items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-7 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417]"
      >
        {primaryLabel}
      </a>
      {secondaryHref && secondaryLabel ? (
        <a
          href={secondaryHref}
          class="inline-flex h-12 items-center justify-center rounded-full border-2 border-black/12 bg-white/80 px-7 text-sm font-extrabold text-black transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:text-[#bf4f08]"
        >
          {secondaryLabel}
        </a>
      ) : null}
    </div>
  </section>
</main>

<style>
  .status-route {
    font-family: Manrope, system-ui, sans-serif;
  }

  .status-ascii {
    margin: 0;
    user-select: none;
  }
</style>
