---
// Company data with logos, names, and website URLs

interface MarqueeItem {
  name: string;
  logo: string;
  alt?: string;
  url?: string;
}

interface Props {
  className?: string;
  showTitle?: boolean;
  /** Darken logos for cream/light page backgrounds (matches landing logo grid). */
  lightBackground?: boolean;
  /** Optional curated list; defaults to the full sponsor set. */
  items?: MarqueeItem[];
}

const { className, showTitle = true, lightBackground = false, items } = Astro.props;

const logoImgClass = lightBackground
  ? "h-10 w-auto max-w-[9.5rem] object-contain opacity-55 grayscale brightness-0 transition-all duration-500 group-hover:opacity-90"
  : "h-10 w-auto opacity-70 group-hover:opacity-100 transition-all duration-500 hover:scale-110";

const defaultCompanies: MarqueeItem[] = [
  {
    name: "DeepMind",
    logo: "/sponsors/deepmind.png",
    alt: "DeepMind",
    url: "https://deepmind.com",
  },
  {
    name: "Standout",
    logo: "/sponsors/standout.png",
    alt: "Standout",
    url: "https://standout.com",
  },
  {
    name: "Browser-Use",
    logo: "/sponsors/browser-use.png",
    alt: "Browser-Use",
    url: "https://browser-use.com",
  },
  {
    name: "OMI",
    logo: "/sponsors/omi.png",
    alt: "OMI",
    url: "https://omi.me",
  },
  {
    name: "AirGarage",
    logo: "/sponsors/airgarage.png",
    alt: "AirGarage",
    url: "https://airgarage.com",
  },
  {
    name: "PHX Ventures",
    logo: "/sponsors/phxventures.webp",
    alt: "PHX Ventures",
    url: "https://phxventures.com",
  },
  {
    name: "AZVC",
    logo: "/sponsors/azvc.png",
    alt: "AZVC",
    url: "https://azvc.com",
  },
  {
    name: "Plug and Play",
    logo: "/sponsors/plugandplay.png",
    alt: "Plug and Play Ventures",
    url: "https://www.plugandplaytechcenter.com",
  },
  {
    name: "Arizona Commerce Authority",
    logo: "/sponsors/aca.png",
    alt: "Arizona Commerce Authority",
    url: "https://www.azcommerce.com",
  },
  {
    name: "ASU",
    logo: "/asu.png",
    alt: "Arizona State University",
    url: "https://www.asu.edu",
  },
  {
    name: "Product Hunt",
    logo: "/sponsors/ph.png",
    alt: "Product Hunt",
    url: "https://www.producthunt.com",
  },
  {
    name: "LoLoft",
    logo: "/sponsors/loloft.png",
    alt: "LoLoft",
    url: "https://loloft.com",
  },
  {
    name: "Cloudflare",
    logo: "/sponsors/cloudflare.svg",
    alt: "Cloudflare",
    url: "https://www.cloudflare.com",
  },
];

const companies = items?.length ? items : defaultCompanies;
---

<div class:list={["w-full relative overflow-hidden", showTitle ? "py-12" : "py-5", className, lightBackground && "marquee-light"]}>
  {
    showTitle && (
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-orange-500/3 to-transparent pointer-events-none" />
    )
  }

  {
    showTitle && (
      <div class="text-center mb-12 relative z-20">
        <p class="text-gray-400 text-xs font-semibold tracking-[0.2em] uppercase mb-2 glow-text-sm">
          Trusted by Leading Teams
        </p>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-orange-400/50 to-transparent mx-auto" />
      </div>
    )
  }

  <div
    class="relative w-screen left-1/2 -translate-x-1/2 overflow-hidden marquee-fade"
  >
    <div
      class="flex animate-marquee px-6 sm:px-10 lg:px-16"
      style="--duration: 35s;"
    >
      {
        companies.map((company) => (
          company.url ? (
            <a
              href={company.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center mx-10 min-w-[120px] h-16 group flex-shrink-0 cursor-pointer"
              title={`Visit ${company.name}`}
            >
              <img
                src={company.logo}
                alt={company.alt ?? company.name}
                class={logoImgClass}
                loading="lazy"
              />
            </a>
          ) : (
            <div class="flex items-center justify-center mx-10 min-w-[120px] h-16 group flex-shrink-0">
              <img
                src={company.logo}
                alt={company.alt ?? company.name}
                class={logoImgClass}
                loading="lazy"
              />
            </div>
          )
        ))
      }
      {
        companies.map((company) => (
          company.url ? (
            <a
              href={company.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center mx-10 min-w-[120px] h-16 group flex-shrink-0 cursor-pointer"
              title={`Visit ${company.name}`}
              aria-hidden="true"
              tabindex="-1"
            >
              <img
                src={company.logo}
                alt=""
                class={logoImgClass}
                loading="lazy"
              />
            </a>
          ) : (
            <div class="flex items-center justify-center mx-10 min-w-[120px] h-16 group flex-shrink-0" aria-hidden="true">
              <img
                src={company.logo}
                alt=""
                class={logoImgClass}
                loading="lazy"
              />
            </div>
          )
        ))
      }
    </div>
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee var(--duration, 35s) linear infinite;
    display: flex;
    width: max-content;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  .animate-marquee,
  .animate-marquee-reverse {
    animation-timing-function: linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee,
    .animate-marquee-reverse {
      animation: none;
    }
  }

  .group:hover {
    filter: drop-shadow(0 8px 32px rgba(249, 115, 22, 0.15));
  }

  .marquee-light .group:hover {
    filter: drop-shadow(0 6px 18px rgba(5, 5, 5, 0.12));
  }

  .group img {
    transition: all 0.5s ease;
  }

  .group:hover img {
    transform: scale(1.1);
  }

  .glow-text-sm {
    text-shadow: 0 0 10px rgba(255, 153, 0, 0.3);
  }

  .marquee-fade {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
</style>
