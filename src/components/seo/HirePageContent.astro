---
interface Props {
  role: string;
  panelTitle?: string;
  proof: string[];
  sections: Array<{ title: string; body: string; bullets: string[] }>;
}

const { role, panelTitle, proof, sections } = Astro.props;
---

<section class="relative mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-10">
  <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="border border-black/10 bg-white p-6 shadow-[0_12px_34px_rgba(5,5,5,0.05)]">
      <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#ff7417]">Builder signal</p>
      <h2 class="mt-5 text-3xl font-normal leading-tight tracking-[-0.02em] text-black">
        {panelTitle ?? `What founders see before interviewing ${role}`}
      </h2>
      <div class="mt-7 grid gap-3">
        {proof.map((item) => (
          <div class="flex gap-3 border-t border-black/8 pt-3">
            <span class="mt-1 h-2.5 w-2.5 shrink-0 bg-[#ff7417]"></span>
            <p class="text-[0.98rem] leading-relaxed text-black/62">{item}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="grid gap-5">
      {sections.map((section) => (
        <article class="border border-black/10 bg-[#fffaf6] p-6">
          <h2 class="text-2xl font-normal tracking-[-0.02em] text-black">{section.title}</h2>
          <p class="mt-3 text-[1rem] leading-relaxed text-black/62">{section.body}</p>
          <ul class="mt-5 grid gap-2">
            {section.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm font-medium text-black/68">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff7417]"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
