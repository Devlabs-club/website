---
// Builder welcome / claim landing. Wireframe section order, landing theme
// (cream paper, Manrope, orange accent). Invite token persists identity for claim/link.
const baseSignIn = "/auth/signup?redirect=%2Fbuilder%2Fhome";

const features = [
  {
    title: "Get hiring opportunities",
    body: "Founders hiring through DevLabs reach out when your work is a fit.",
    tone: "opportunity",
  },
  {
    title: "Verified builder profile",
    body: "Stand out as someone from the DevLabs community, not another cold application.",
    tone: "verified",
  },
  {
    title: "Proof of work",
    body: "Projects, GitHub, hackathons, and experience in one place founders can actually read.",
    tone: "proof",
  },
];
---

<main class="builder-welcome min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
  <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-8 sm:px-8 lg:px-10">
    <a href="/" aria-label="DevLabs home" class="inline-flex items-center gap-2.5">
      <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
      <span class="text-lg font-extrabold tracking-[-0.02em]">DevLabs</span>
    </a>
    <a
      href={baseSignIn}
      data-claim-href
      class="claim-cta inline-flex h-11 items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-6 text-sm font-extrabold text-white shadow-[0_12px_28px_rgba(5,5,5,0.12)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417]"
    >
      Claim now
    </a>
  </header>

  <!-- Hero with community photo -->
  <section class="relative mx-auto max-w-7xl px-6 pt-2 sm:px-8 lg:px-10">
    <div class="relative overflow-hidden rounded-[34px] border border-black/10 bg-[#2f3432] shadow-[0_28px_90px_rgba(5,5,5,0.12)]">
      <img
        src="/landing/community/devhacks-crowd.png"
        alt="DevLabs builders at an event"
        class="h-[min(68vh,560px)] w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/20"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
        <img src="/logo.png" alt="" class="h-12 w-12 object-contain brightness-0 invert" />
        <p data-eyebrow class="mt-6 font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-white/70">
          For builders
        </p>
        <h1 class="mt-4 max-w-2xl text-[clamp(2.4rem,6vw,4.2rem)] font-black leading-[1.02] tracking-[-0.045em] text-white">
          Welcome to DevLabs
        </h1>
        <p class="mt-4 max-w-md text-[clamp(1rem,1.5vw,1.15rem)] font-medium leading-relaxed text-white/82">
          The DevLabs builder community is now online.<br />
          Your builder profile is ready to claim.
        </p>
        <a
          href={baseSignIn}
          data-claim-href
          class="claim-cta mt-8 inline-flex h-[3.35rem] min-w-[12rem] items-center justify-center rounded-full border-2 border-white bg-white px-9 text-sm font-extrabold text-[#050505] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417] hover:text-white"
        >
          Claim now →
        </a>
      </div>
    </div>

    <!-- Overlap intro card -->
    <div class="relative z-10 mx-auto -mt-10 max-w-3xl rounded-[28px] border border-black/10 bg-white px-7 py-9 text-center shadow-[0_24px_70px_rgba(5,5,5,0.08)] sm:-mt-14 sm:px-12 sm:py-11">
      <h2 class="text-[clamp(1.6rem,3.2vw,2.2rem)] font-black leading-[1.1] tracking-[-0.03em]">
        We are building something new for builders.
      </h2>
      <p data-intro class="mx-auto mt-4 max-w-xl text-[0.98rem] font-medium leading-relaxed text-black/58">
        DevLabs is moving from offline events into an online builder network. Founders find people from
        what they have actually shipped, not just resumes. We already put a profile together for you from
        your public work.
      </p>
    </div>
  </section>

  <!-- Built for builders -->
  <section class="mx-auto max-w-3xl px-6 py-16 sm:px-8 lg:px-10">
    <p class="text-center font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-black/42">
      Built for builders
    </p>
    <div class="mt-8 space-y-4">
      {features.map((feature) => (
        <div class="overflow-hidden rounded-[24px] border border-black/10 bg-white shadow-[0_14px_40px_rgba(5,5,5,0.05)]">
          <div class="grid sm:grid-cols-[140px_1fr]">
            <div
              class:list={[
                "relative flex min-h-[120px] items-center justify-center p-4",
                feature.tone === "opportunity" && "bg-[#fff5ef]",
                feature.tone === "verified" && "bg-[#f4f1ed]",
                feature.tone === "proof" && "bg-[#2f3432]",
              ]}
            >
              {feature.tone === "opportunity" ? (
                <div class="w-full rounded-2xl border border-[#ff7417]/25 bg-white p-3 shadow-sm">
                  <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.12em] text-[#bf4f08]">Great match</p>
                  <p class="mt-1 text-xs font-extrabold text-[#050505]">Full Stack @ Acme</p>
                  <p class="mt-0.5 text-[0.65rem] font-medium text-black/45">Tempe · Remote</p>
                </div>
              ) : null}
              {feature.tone === "verified" ? (
                <div class="w-full rounded-2xl border border-black/8 bg-white p-3">
                  <div class="flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#fff5ef] text-xs font-black text-[#bf4f08]">B</span>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-extrabold">Builder profile</p>
                      <p class="truncate text-[0.65rem] text-black/45">Product engineer</p>
                    </div>
                  </div>
                  <span class="mt-2 inline-flex rounded-full border border-[#ff7417]/35 bg-[#fff5ef] px-2 py-0.5 text-[0.58rem] font-extrabold uppercase tracking-[0.1em] text-[#bf4f08]">
                    Verified
                  </span>
                </div>
              ) : null}
              {feature.tone === "proof" ? (
                <div class="w-full space-y-1.5">
                  <div class="rounded-lg bg-white/10 px-2.5 py-1.5 text-[0.65rem] font-semibold text-white/85">GitHub · top repos</div>
                  <div class="rounded-lg bg-white/10 px-2.5 py-1.5 text-[0.65rem] font-semibold text-white/85">Hackathons · ships</div>
                  <div class="rounded-lg bg-[#ff7417]/30 px-2.5 py-1.5 text-[0.65rem] font-semibold text-[#ffb27a]">Proof ready</div>
                </div>
              ) : null}
            </div>
            <div class="flex flex-col justify-center px-6 py-6 sm:px-7">
              <h3 class="text-lg font-extrabold tracking-[-0.02em]">{feature.title}</h3>
              <p class="mt-2 text-sm font-medium leading-relaxed text-black/58">{feature.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="mx-auto max-w-7xl px-6 pb-16 sm:px-8 lg:px-10">
    <div class="rounded-[34px] border border-[#ff7417]/25 bg-[#fff5ef] px-6 py-14 text-center sm:px-12">
      <h2 class="mx-auto max-w-xl text-[clamp(1.9rem,4vw,2.8rem)] font-black leading-[1.02] tracking-[-0.04em]">
        Finish setting up your profile.
      </h2>
      <p data-email-note class="mx-auto mt-4 max-w-md text-[0.98rem] font-medium leading-relaxed text-[#bf4f08]">
        We reserved a builder profile for you. Claim it, add anything that is still empty, and you are ready to be discovered.
      </p>
      <a
        href={baseSignIn}
        data-claim-href
        class="claim-cta mt-8 inline-flex h-[3.35rem] min-w-[12rem] items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-9 text-sm font-extrabold text-white shadow-[0_16px_36px_rgba(5,5,5,0.12)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417]"
      >
        Claim now →
      </a>
    </div>
  </section>

  <footer class="border-t border-black/10 px-6 py-10 sm:px-8 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="DevLabs" class="h-7 w-7 object-contain" />
        <span class="text-sm font-bold text-black/60">© {new Date().getFullYear()} DevLabs</span>
      </div>
      <div class="flex flex-wrap gap-x-7 gap-y-2 text-sm font-semibold text-black/50">
        <a href="/events" class="transition hover:text-[#ff7417]">Events</a>
        <a href="/about" class="transition hover:text-[#ff7417]">Our story</a>
        <a href="/discord" class="transition hover:text-[#ff7417]">Discord</a>
        <a href="/privacy" class="transition hover:text-[#ff7417]">Privacy</a>
      </div>
    </div>
  </footer>
</main>

<style>
  .builder-welcome {
    font-family: Manrope, system-ui, sans-serif;
    letter-spacing: 0;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(5, 5, 5, 0.024) 0,
        rgba(5, 5, 5, 0.024) 1px,
        transparent 1px,
        transparent 24px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(5, 5, 5, 0.022) 0,
        rgba(5, 5, 5, 0.022) 1px,
        transparent 1px,
        transparent 24px
      );
  }
</style>

<script>
  const COOKIE_MAX_AGE = 60 * 60 * 24 * 14; // 14 days

  function persistIdentity(identity: Record<string, unknown>) {
    try {
      localStorage.setItem('devlabs_invite', JSON.stringify(identity));
    } catch {
      /* localStorage may be unavailable (private mode) */
    }
    try {
      const value = encodeURIComponent(JSON.stringify(identity));
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `devlabs_invite=${value}; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax${secure}`;
    } catch {
      /* ignore */
    }
  }

  function firstNameOf(name: string | null | undefined) {
    if (!name) return '';
    return String(name).trim().split(/\s+/)[0] || '';
  }

  function claimHref(email?: string | null) {
    const params = new URLSearchParams({ redirect: '/builder/home' });
    if (email) params.set('email', email);
    return `/auth/signup?${params.toString()}`;
  }

  function applyClaimLinks(email?: string | null) {
    const href = claimHref(email);
    document.querySelectorAll('[data-claim-href]').forEach((el) => {
      if (el instanceof HTMLAnchorElement) el.href = href;
    });
  }

  (function initInvite() {
    const params = new URLSearchParams(location.search);
    const token = params.get('t');
    const ref = params.get('ref');
    const utm = {
      source: params.get('utm_source'),
      medium: params.get('utm_medium'),
      campaign: params.get('utm_campaign'),
    };

    applyClaimLinks(null);

    if (!token) return;

    fetch(`/api/builder/invite/verify?t=${encodeURIComponent(token)}`)
      .then((r) => r.json())
      .then((data) => {
        if (!data || !data.success) return;

        persistIdentity({
          email: data.email,
          name: data.name || null,
          builderId: data.builderId || null,
          token,
          ref: ref || null,
          utm,
          ts: Date.now(),
        });

        applyClaimLinks(data.email || null);

        const first = firstNameOf(data.name);
        const eyebrow = document.querySelector('[data-eyebrow]');
        if (eyebrow && first) eyebrow.textContent = `Welcome, ${first}`;

        if (data.email) {
          document.querySelectorAll('[data-email-note]').forEach((el) => {
            el.textContent = `This invite is tied to ${data.email}. Claim with that email so we can attach your reserved profile.`;
          });
          const intro = document.querySelector('[data-intro]');
          if (intro && first) {
            intro.textContent = `Hey ${first}. DevLabs is moving from offline events into an online builder network. Founders find people from what they have actually shipped, not just resumes. We already put a profile together for you from your public work.`;
          }
        }
      })
      .catch(() => {
        /* invalid/expired link: page still works as a generic claim page */
      });
  })();
</script>
