---
// Builder welcome / claim landing page. Themed to match src/pages/index.astro
// (cream paper, Manrope, orange accent, rounded cards). Reads the signed invite
// token + ref/utm from the URL, persists builder identity to localStorage + a
// cookie so it survives login, and routes the builder into the dashboard form.
const signInHref = "/auth/signup?redirect=%2Fbuilder%2Fhome";

const steps = [
  {
    n: "01",
    title: "Claim your profile",
    body: "Sign in with the email this invite was sent to. We link you to the profile we already reserved.",
  },
  {
    n: "02",
    title: "Add your proof links",
    body: "Drop your LinkedIn, portfolio, and resume, and answer Open to work + US citizen. GitHub and Devpost are optional.",
  },
  {
    n: "03",
    title: "We build your profile",
    body: "DevLabs enriches a founder-readable profile from your real work — projects, contributions, and skills.",
  },
  {
    n: "04",
    title: "Get discovered",
    body: "Founders hiring through DevLabs find you by what you've shipped and reach out directly.",
  },
];

const faqs = [
  {
    q: "How did you build a profile for me?",
    a: "We assembled a founder-readable profile from your public work — GitHub, hackathons, and the events you've been part of. Claiming it lets you verify and complete the details.",
  },
  {
    q: "Is my profile public right now?",
    a: "No. It stays private until you claim and confirm it. Founders can't see it until you're ready.",
  },
  {
    q: "What do I need to finish setup?",
    a: "Your LinkedIn, portfolio link, resume, and answers for Open to work and US citizen. GitHub and Devpost are optional. Everything else is generated for you and stays editable.",
  },
  {
    q: "Will I get spammed?",
    a: "No. We only reach out when a founder actually wants to talk to you.",
  },
];
---

<main class="builder-welcome min-h-screen overflow-x-hidden bg-[#fbf6f3] text-[#050505]">
  <!-- Header -->
  <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-8 sm:px-8 lg:px-10">
    <a href="/" aria-label="DevLabs home" class="inline-flex items-center gap-2.5">
      <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
      <span class="text-lg font-extrabold tracking-[-0.02em]">DevLabs</span>
    </a>
    <a
      href={signInHref}
      class="claim-cta inline-flex h-11 items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-6 text-sm font-extrabold text-white shadow-[0_12px_28px_rgba(5,5,5,0.12)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417]"
    >
      Claim your profile
    </a>
  </header>

  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-6 pb-8 pt-8 sm:px-8 lg:px-10 lg:pt-14">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p data-eyebrow class="font-mono text-[0.78rem] font-extrabold uppercase tracking-[0.28em] text-black/42">
          For builders
        </p>
        <h1 class="mt-6 text-[clamp(2.4rem,6.4vw,4.6rem)] font-black leading-[1.02] tracking-[-0.045em]">
          Get discovered for what you've <span class="text-[#ff7417]">actually built</span>.
        </h1>
        <p class="mt-6 max-w-xl text-[clamp(1rem,1.4vw,1.18rem)] font-medium leading-relaxed text-black/58">
          DevLabs is where founders find builders by their real work — shipped projects, GitHub, and
          hackathons, not just resumes. We've reserved a profile for you. Claim it in under two minutes.
        </p>
        <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a
            href={signInHref}
            class="claim-cta inline-flex h-[3.35rem] min-w-[12rem] items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-9 text-sm font-extrabold text-white shadow-[0_16px_36px_rgba(5,5,5,0.12)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417] hover:shadow-[0_16px_36px_rgba(255,116,23,0.22)]"
          >
            Claim your profile
          </a>
          <p data-email-note class="max-w-xs text-sm font-medium leading-snug text-black/50">
            No spam — we only reach out when a founder wants to talk.
          </p>
        </div>
      </div>

      <!-- Proof preview cards -->
      <div class="relative">
        <div class="rounded-[26px] border border-black/10 bg-white p-6 shadow-[0_28px_90px_rgba(5,5,5,0.08)]">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#fff5ef] text-lg font-black text-[#bf4f08]">A</div>
            <div class="min-w-0">
              <p class="truncate text-[15px] font-extrabold tracking-[-0.01em]">Your builder profile</p>
              <p class="truncate text-sm font-medium text-black/50">Full-stack engineer · ships with AI</p>
            </div>
            <span class="ml-auto inline-flex items-center gap-1 rounded-full border border-[#ff7417]/40 bg-[#fff5ef] px-2.5 py-1 text-[0.64rem] font-extrabold uppercase tracking-[0.12em] text-[#bf4f08]">
              Verified
            </span>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {["React", "TypeScript", "Python", "LLMs", "Postgres"].map((s) => (
              <span class="rounded-full border border-black/10 bg-[#f4f1ed] px-3 py-1 text-xs font-semibold text-black/60">{s}</span>
            ))}
          </div>
          <div class="mt-5 grid grid-cols-3 gap-3 border-t border-black/8 pt-5">
            <div>
              <p class="text-2xl font-black leading-none tracking-[-0.04em]">24</p>
              <p class="mt-1 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-black/40">Repos</p>
            </div>
            <div>
              <p class="text-2xl font-black leading-none tracking-[-0.04em]">6</p>
              <p class="mt-1 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-black/40">Hackathons</p>
            </div>
            <div>
              <p class="text-2xl font-black leading-none tracking-[-0.04em]"><span class="text-[#ff7417]">+</span>3</p>
              <p class="mt-1 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-black/40">Ships/mo</p>
            </div>
          </div>
        </div>

        <div class="mt-4 flex items-center gap-3 rounded-[20px] border border-black/10 bg-[#fffaf7] p-4 shadow-[0_18px_55px_rgba(5,5,5,0.06)]">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#2f3432] text-sm font-black text-white">F</div>
          <div class="min-w-0">
            <p class="truncate text-sm font-extrabold">New opportunity</p>
            <p class="truncate text-xs font-medium text-black/50">A founder wants to talk about a founding engineer role.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof band / why -->
  <section class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-10">
    <div class="grid gap-10 rounded-[34px] border border-black/10 bg-[#fffaf7] p-8 sm:p-12 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <p class="font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-black/42">Your profile is already built</p>
        <h2 class="mt-4 text-[clamp(1.9rem,3.6vw,3rem)] font-black leading-[0.98] tracking-[-0.04em]">
          Proof of work, not another resume upload.
        </h2>
        <p class="mt-5 max-w-lg text-[clamp(0.98rem,1.3vw,1.1rem)] font-medium leading-relaxed text-black/58">
          We already pulled your public work into a founder-readable profile. Claiming it verifies you're
          the real builder and unlocks the finishing touches — then founders can discover you.
        </p>
      </div>
      <div class="rounded-[24px] border border-black/10 bg-white p-6 shadow-[0_24px_70px_rgba(5,5,5,0.08)]">
        <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-[#bf4f08]">What we pulled</p>
        <ul class="mt-4 space-y-3">
          {[
            "Projects & repos from GitHub",
            "Roles & experience",
            "Hackathons & events",
            "Skills, verified against real work",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm font-medium text-black/70">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#fff5ef] text-[0.62rem] font-black text-[#bf4f08]">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
    <div class="text-center">
      <p class="font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-black/42">How it works</p>
      <h2 class="mx-auto mt-4 max-w-2xl text-[clamp(2rem,4vw,3.2rem)] font-black leading-[0.95] tracking-[-0.045em]">
        Four steps to get hired.
      </h2>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {steps.map((step) => (
        <div class="rounded-[26px] border border-black/10 bg-white p-7 shadow-[0_18px_55px_rgba(5,5,5,0.05)]">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#ff7417] text-sm font-black text-white">{step.n}</span>
            <h3 class="text-xl font-extrabold tracking-[-0.02em]">{step.title}</h3>
          </div>
          <p class="mt-4 text-[0.98rem] font-medium leading-relaxed text-black/58">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Meet your mentor -->
  <section class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-10">
    <div class="grid gap-10 rounded-[34px] border border-black/10 bg-[#0d0a09] p-8 text-white sm:p-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <p class="font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-[#ffb27a]">Meet your guide</p>
        <h2 class="mt-4 text-[clamp(1.9rem,3.6vw,3rem)] font-black leading-[0.98] tracking-[-0.04em]">
          The DevLabs agent sets you up.
        </h2>
        <p class="mt-5 max-w-lg text-[clamp(0.98rem,1.3vw,1.1rem)] font-medium leading-relaxed text-white/72">
          Once you claim your profile, our agent turns your links and resume into a polished,
          founder-ready profile — so you spend minutes, not hours, on setup.
        </p>
      </div>
      <div class="rounded-[24px] border border-white/10 bg-white/[0.04] p-6">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="" class="h-9 w-9 object-contain brightness-0 invert" />
          <div>
            <p class="text-sm font-extrabold">DevLabs agent</p>
            <p class="text-xs font-medium text-white/50">Building your profile…</p>
          </div>
        </div>
        <div class="mt-5 space-y-3">
          <div class="rounded-2xl bg-white/[0.06] px-4 py-3 text-sm font-medium text-white/82">Pulling your GitHub projects and top repos.</div>
          <div class="rounded-2xl bg-white/[0.06] px-4 py-3 text-sm font-medium text-white/82">Summarizing your roles and impact.</div>
          <div class="rounded-2xl bg-[#ff7417]/20 px-4 py-3 text-sm font-semibold text-[#ffb27a]">Your profile is ready to review.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 py-8 sm:px-8 lg:px-10">
    <div class="text-center">
      <p class="font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-black/42">FAQ</p>
      <h2 class="mt-4 text-[clamp(1.9rem,3.6vw,2.8rem)] font-black leading-[0.98] tracking-[-0.04em]">Common questions</h2>
    </div>
    <div class="mt-10 divide-y divide-black/10 border-y border-black/10">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-extrabold tracking-[-0.01em]">
            {faq.q}
            <span class="text-[#ff7417] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[0.98rem] font-medium leading-relaxed text-black/58">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-10">
    <div class="relative overflow-hidden rounded-[34px] border border-[#ff7417]/25 bg-[#fff5ef] px-6 py-16 text-center sm:px-12">
      <h2 class="mx-auto max-w-2xl text-[clamp(2.2rem,5vw,3.6rem)] font-black leading-[0.96] tracking-[-0.045em]">
        Ready to be discovered?
      </h2>
      <p data-email-note class="mx-auto mt-5 max-w-md text-[clamp(0.98rem,1.3vw,1.12rem)] font-medium leading-relaxed text-[#bf4f08]">
        Claim your reserved builder profile and finish setup in minutes.
      </p>
      <a
        href={signInHref}
        class="claim-cta mt-9 inline-flex h-[3.5rem] min-w-[13rem] items-center justify-center rounded-full border-2 border-[#1f2422] bg-[#2f3432] px-10 text-base font-extrabold text-white shadow-[0_18px_44px_rgba(5,5,5,0.16)] transition hover:-translate-y-0.5 hover:border-[#ff7417] hover:bg-[#ff7417]"
      >
        Claim your profile
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-black/10 px-6 py-10 sm:px-8 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="DevLabs" class="h-7 w-7 object-contain" />
        <span class="text-sm font-bold text-black/60">© {new Date().getFullYear()} DevLabs</span>
      </div>
      <div class="flex flex-wrap gap-x-7 gap-y-2 text-sm font-semibold text-black/50">
        <a href="/events" class="transition hover:text-[#ff7417]">Events</a>
        <a href="/about" class="transition hover:text-[#ff7417]">Our story</a>
        <a href="/discord" class="transition hover:text-[#ff7417]">Discord</a>
        <a href="/privacy" class="transition hover:text-[#ff7417]">Privacy</a>
      </div>
    </div>
  </footer>
</main>

<style>
  .builder-welcome {
    font-family: Manrope, system-ui, sans-serif;
    letter-spacing: 0;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(5, 5, 5, 0.024) 0,
        rgba(5, 5, 5, 0.024) 1px,
        transparent 1px,
        transparent 24px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(5, 5, 5, 0.022) 0,
        rgba(5, 5, 5, 0.022) 1px,
        transparent 1px,
        transparent 24px
      );
  }
</style>

<script>
  const COOKIE_MAX_AGE = 60 * 60 * 24 * 14; // 14 days

  function persistIdentity(identity: Record<string, unknown>) {
    try {
      localStorage.setItem('devlabs_invite', JSON.stringify(identity));
    } catch {
      /* localStorage may be unavailable (private mode) */
    }
    try {
      const value = encodeURIComponent(JSON.stringify(identity));
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `devlabs_invite=${value}; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax${secure}`;
    } catch {
      /* ignore */
    }
  }

  function firstNameOf(name: string | null | undefined) {
    if (!name) return '';
    return String(name).trim().split(/\s+/)[0] || '';
  }

  (function initInvite() {
    const params = new URLSearchParams(location.search);
    const token = params.get('t');
    const ref = params.get('ref');
    const utm = {
      source: params.get('utm_source'),
      medium: params.get('utm_medium'),
      campaign: params.get('utm_campaign'),
    };

    if (!token) return;

    fetch(`/api/builder/invite/verify?t=${encodeURIComponent(token)}`)
      .then((r) => r.json())
      .then((data) => {
        if (!data || !data.success) return;

        persistIdentity({
          email: data.email,
          name: data.name || null,
          builderId: data.builderId || null,
          token,
          ref: ref || null,
          utm,
          ts: Date.now(),
        });

        const first = firstNameOf(data.name);
        const eyebrow = document.querySelector('[data-eyebrow]');
        if (eyebrow && first) eyebrow.textContent = `Welcome, ${first}`;

        if (data.email) {
          document.querySelectorAll('[data-email-note]').forEach((el) => {
            el.textContent = `This invite is tied to ${data.email}. No spam — we only reach out when a founder wants to talk.`;
          });
        }
      })
      .catch(() => {
        /* invalid/expired link — the page still works as a generic claim page */
      });
  })();
</script>
