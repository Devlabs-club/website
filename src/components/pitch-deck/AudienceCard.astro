---
import Icon from "./PitchDeckIcon.astro";

interface Props {
  className: string;
  number: string;
  icon: "laptop" | "clipboard" | "globe";
  lines: string[];
}

const { className, number, icon, lines } = Astro.props;
---

<article
  class:list={[
    "absolute h-[220px] w-[260px] rounded-[14px] bg-white/82 p-[24px] shadow-[0_18px_42px_rgba(250,134,47,0.07)]",
    className,
  ]}
>
  <div class="mb-[22px] grid h-[64px] w-[64px] place-items-center rounded-[13px] bg-[linear-gradient(135deg,#fa862f,#ffc48a)] text-white">
    <Icon kind={icon} className="h-[38px] w-[38px]" />
  </div>
  <p class="m-0 text-[30px] font-medium leading-none tracking-[-0.04em] text-[#fa862f]">{number}</p>
  <p class="mt-[9px] text-[15px] font-medium leading-[1.08] tracking-[-0.03em] text-[#fa862f]/42">
    {lines.map((line, index) => (
      <>
        {line}
        {index < lines.length - 1 && <br />}
      </>
    ))}
  </p>
</article>
