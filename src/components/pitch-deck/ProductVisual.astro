---
---

<div class="product-visual" aria-label="Product flow preview">
  <article class="product-window product-window--search">
    <div class="product-window__chrome">
      <span class="product-window__dots"><i></i><i></i><i></i></span>
      <span class="product-window__url">app.devlabs.club/founder</span>
    </div>
    <div class="product-window__body product-window__body--chat">
      <div class="product-chat__brand">
        <img src="/logo.svg" alt="" />
        <span>Devlabs Agent</span>
      </div>
      <div class="product-chat__thread">
        <div class="product-chat__bubble product-chat__bubble--agent">
          What kind of builder are you hiring?
        </div>
        <div class="product-chat__bubble product-chat__bubble--founder">
          Full-stack engineer — React, Node, PostgreSQL. Early-stage startup.
        </div>
        <div class="product-chat__bubble product-chat__bubble--agent product-chat__bubble--typing">
          Searching our vetted builder pool…
        </div>
      </div>
      <div class="product-chat__input">
        <span>Describe the role…</span>
        <button type="button">Search</button>
      </div>
    </div>
  </article>

  <article class="product-window product-window--shortlist">
    <div class="product-window__chrome">
      <span class="product-window__dots"><i></i><i></i><i></i></span>
      <span class="product-window__url">app.devlabs.club/founder/search/full-stack</span>
    </div>
    <div class="product-window__body product-window__body--results">
      <div class="product-results__head">
        <div>
          <p class="product-results__eyebrow">Agent shortlist</p>
          <h3>4 builders match your role</h3>
        </div>
        <span class="product-results__badge">Top 1% only</span>
      </div>
      <div class="product-results__list">
        <div class="product-builder-row product-builder-row--featured">
          <div class="product-builder-row__avatar">AK</div>
          <div class="product-builder-row__copy">
            <strong>Aakash K.</strong>
            <span class="product-builder-row__role">Full-stack · DevHacks SF winner</span>
            <div class="product-builder-row__signals">
              <span class="product-signal">Shipped 3 MVPs</span>
              <span class="product-signal">12k users in prod</span>
            </div>
          </div>
          <div class="product-builder-row__score">
            <strong>94%</strong>
            <span>match</span>
          </div>
        </div>
        <div class="product-builder-row">
          <div class="product-builder-row__avatar">PS</div>
          <div class="product-builder-row__copy">
            <strong>Priya S.</strong>
            <span class="product-builder-row__role">
              <span class="product-employer-badge">
                <span class="product-employer-badge__logo product-employer-badge__logo--stripe" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="20" height="20" rx="4.5" fill="#635BFF"></rect>
                    <path fill="#fff" d="M7.4 4.8h5.4l-4.2 10.4H3.2l4.2-10.4z"></path>
                  </svg>
                </span>
                ex-Stripe
              </span>
              · Payments infra
            </span>
            <div class="product-builder-row__signals">
              <span class="product-signal">4 yrs production</span>
              <span class="product-signal">240★ open source</span>
            </div>
          </div>
          <div class="product-builder-row__score">
            <strong>91%</strong>
            <span>match</span>
          </div>
        </div>
        <div class="product-builder-row">
          <div class="product-builder-row__avatar">ML</div>
          <div class="product-builder-row__copy">
            <strong>Marcus L.</strong>
            <span class="product-builder-row__role">Full-stack · YC W24 alum</span>
            <div class="product-builder-row__signals">
              <span class="product-signal">DevHouse SF</span>
              <span class="product-signal">0→1 founding eng</span>
            </div>
          </div>
          <div class="product-builder-row__score">
            <strong>88%</strong>
            <span>match</span>
          </div>
        </div>
      </div>
    </div>
  </article>

  <article class="product-window product-window--profile">
    <div class="product-window__chrome">
      <span class="product-window__dots"><i></i><i></i><i></i></span>
      <span class="product-window__url">app.devlabs.club/founder/builders/aakash-k</span>
    </div>
    <div class="product-window__body product-window__body--profile">
      <div class="product-profile__header">
        <div class="product-profile__avatar">AK</div>
        <div>
          <h3>Aakash K.</h3>
          <p>Full-stack · React, Node, PostgreSQL</p>
          <div class="product-profile__badges">
            <span class="product-profile__verified">Verified builder</span>
            <span class="product-profile__verified product-profile__verified--dark">Community vetted</span>
          </div>
        </div>
        <div class="product-profile__match">
          <strong>94%</strong>
          <span>match</span>
        </div>
      </div>

      <div class="product-profile__metrics">
        <div>
          <strong>3</strong>
          <span>Shipped MVPs</span>
        </div>
        <div>
          <strong>12k</strong>
          <span>Users in prod</span>
        </div>
        <div>
          <strong>240</strong>
          <span>GitHub stars</span>
        </div>
      </div>

      <div class="product-profile__proof">
        <p class="product-profile__label">Proof of work</p>
        <ul>
          <li>
            <span class="product-proof-icon">🏆</span>
            <div>
              <strong>Won DevHacks SF 2025</strong>
              <p>Built and deployed a live billing MVP in 36 hours — judged by founders</p>
            </div>
          </li>
          <li>
            <span class="product-proof-icon">📦</span>
            <div>
              <strong>3 production codebases</strong>
              <p>Auth, Stripe billing, and admin dashboards — all serving real users</p>
            </div>
          </li>
          <li>
            <span class="product-proof-icon">🔗</span>
            <div>
              <strong>Open-source maintainer</strong>
              <p>React component library · 240+ stars · used by 40+ teams</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="product-profile__tags">
        <span>Next.js</span>
        <span>Node.js</span>
        <span>PostgreSQL</span>
        <span>Stripe</span>
        <span>In prod</span>
      </div>
      <button class="product-profile__cta" type="button">Request intro</button>
    </div>
  </article>
</div>
