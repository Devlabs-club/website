---
// Last slide, composed centre-out. The portrait tiles use a scooped bottom
// edge and sit staggered, with a tinted tile offset behind each one.
// `mission` set with `quoted: true` renders in quote marks, so it reads as
// something the founder actually said rather than a caption about them.
const founders = [
  {
    name: "Dhanush Vardhan",
    role: "Co-founder",
    photo: "/pitchdeck-canva/team/dhanush.png",
    logos: [
      // only the G mark exists in the repo, so this one still needs its name
      { src: "/pitch-deck/logos/google.svg", name: "Google" },
      { src: "/pitch-deck/logos/cloudflare-wordmark.png", wordmark: true, alt: "Cloudflare", tall: true },
    ],
    mission: "Placeholder — one line, in Dhanush's words, on why he is building this.",
  },
  {
    name: "Bhoomi Sahajsinghani",
    role: "Co-founder",
    photo: "/pitchdeck-canva/team/bhoomi.png",
    logos: [{ src: "/pitch-deck/logos/twilio-wordmark.png", wordmark: true, alt: "Twilio" }],
    mission: "Everything I have came from some community. Devlabs is how I give that back.",
    quoted: true,
  },
];
---

<section class="team">
  <div class="team-bg" aria-hidden="true">
    <svg class="team-sweeps" viewBox="0 0 1600 900" fill="none">
      <path class="team-sweep" d="M -180 286 L 232 34 L 560 232" />
      <path class="team-sweep team-sweep--soft" d="M 1060 660 L 1400 890 L 1790 720" />
    </svg>
  </div>

  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> The team</p>
  </header>

  <div class="team__intro">
    <h1>We lived the problem. <em>Now we are fixing it.</em></h1>
  </div>

  <div class="team-board">
    {
      founders.map((f, i) => (
        <article class:list={["team-card", `team-card--${i + 1}`]}>
          <div class="team-card__tile">
            <span class="team-card__shade" aria-hidden="true"></span>
            <img class="team-card__face" src={f.photo} alt="" loading="eager" />
          </div>

          <h2>{f.name}</h2>
          <p class="team-card__role">{f.role}</p>
          <p class:list={["team-card__mission", f.quoted && "is-quoted"]}>
            {f.quoted ? <>&ldquo;{f.mission}&rdquo;</> : f.mission}
          </p>

          <div class="team-card__prior">
            {f.logos.map((l) =>
              l.wordmark ? (
                <img
                  class:list={["team-wordmark", l.tall && "team-wordmark--tall"]}
                  src={l.src}
                  alt={l.alt}
                  loading="eager"
                />
              ) : (
                <span class="team-logo">
                  <img src={l.src} alt="" loading="eager" />
                  {l.name}
                </span>
              )
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
