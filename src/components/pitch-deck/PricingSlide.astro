---
// Plans mirror src/components/PricingSection.astro. The slide splits the way
// the decision does — two self-serve tiers grouped on one panel, then the
// managed plan we want to sell taking the whole right side.
// stroke icons, 24-grid, drawn to match the linework elsewhere in the deck
const I = {
  roles: `<svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="7" width="17" height="13" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/></svg>`,
  profiles: `<svg viewBox="0 0 24 24" fill="none"><circle cx="9.5" cy="9" r="3.2"/><path d="M4 19.5c0-3 2.5-4.8 5.5-4.8s5.5 1.8 5.5 4.8"/><path d="M16 7.4a3 3 0 0 1 0 5.6M17.6 19.5c0-2.2-.9-3.7-2.3-4.5"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none"><path d="M10 13.8a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7l-1.3 1.3"/><path d="M14 10.2a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.3-1.3"/></svg>`,
  trace: `<svg viewBox="0 0 24 24" fill="none"><path d="m6 8 3.5 3.5L6 15"/><path d="M12.5 16h5.5"/><rect x="3" y="4" width="18" height="16" rx="2"/></svg>`,
  outreach: `<svg viewBox="0 0 24 24" fill="none"><path d="M20.5 4 3.8 10.4l6.4 2.6 2.6 6.4L20.5 4Z"/><path d="m10.2 13-.9 4.6"/></svg>`,
  ban: `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8"/><path d="m6.6 6.6 10.8 10.8"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2.6 14.5 9l6.9.3-5.4 4.3 1.9 6.7L12 16.6l-5.9 3.7 1.9-6.7L2.6 9.3 9.5 9Z"/></svg>`,
};

const selfServe = [
  {
    badge: null,
    eyebrow: "Get started",
    title: "Explore the talent pool",
    amount: "Free",
    unit: "forever",
    chips: [
      { label: "3 roles a month", icon: I.roles },
      { label: "5 profiles per role", icon: I.profiles },
      { label: "GitHub · LinkedIn", icon: I.link },
    ],
    missing: "No agent traces or outreach",
    bestFor: "Seeing the pool before you commit",
  },
  {
    badge: "Most popular",
    eyebrow: "Self-serve",
    title: "Growth",
    amount: "$20",
    unit: "per month",
    chips: [
      { label: "5 roles a month", icon: I.roles },
      { label: "20 profiles per role", icon: I.profiles },
      { label: "Full agent traces", icon: I.trace },
      { label: "Outreach", icon: I.outreach },
    ],
    missing: null,
    bestFor: "Founders running their own search · $200/yr saves 17%",
  },
];

const managed = {
  badge: "Fully managed",
  title: "Custom",
  amount: "$499",
  unit: "deposit",
  included: [
    "Everything in Growth, unlimited",
    "We run the search end to end",
    "Warm intros to matched builders",
    "A dedicated Devlabs point of contact",
  ],
};

// the economics, straight from the pricing page — the reason this plan sells
const deal = [
  { label: "Upfront deposit", value: "$499" },
  // the line that actually sells the plan, so it is set larger than the rest
  { label: "On successful hire", value: "50% of monthly salary", key: true },
  { label: "Deposit on hire", value: "Credited back in full" },
  { label: "If no hire", value: "Deposit is non-refundable" },
];

const tick = `<svg viewBox="0 0 16 16" fill="none"><path d="M3.4 8.3 6.3 11.2 12.6 4.7" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="pricing-slide__content deck-slide-layout">
  <header class="pricing-slide__header deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Pricing</p>
  </header>

  <div class="pricing-slide__intro">
    <h1>A bad early hire costs <em>more than money</em></h1>
  </div>

  <div class="pricing-fork">
    <!-- left: do it yourself -->
    <section class="pricing-lane">
      <p class="pricing-lane__label">Find them yourself</p>

      <div class="pricing-lane__panel">
        {
          selfServe.map((plan) => (
            <article class="pricing-tier">
              <div class="pricing-tier__top">
                <p class="pricing-tier__eyebrow">{plan.eyebrow}</p>
                {plan.badge && <span class="pricing-badge">{plan.badge}</span>}
              </div>
              <h2>{plan.title}</h2>

              <p class="pricing-tier__price">
                <strong>{plan.amount}</strong>
                <span>{plan.unit}</span>
              </p>

              <ul class="pricing-chips">
                {plan.chips.map((chip) => (
                  <li>
                    <i aria-hidden="true" set:html={chip.icon} />
                    {chip.label}
                  </li>
                ))}
                {plan.missing && (
                  <li class="is-missing">
                    <i aria-hidden="true" set:html={I.ban} />
                    {plan.missing}
                  </li>
                )}
              </ul>

              <p class="pricing-tier__for">{plan.bestFor}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- the fork -->
    <div class="pricing-or" aria-hidden="true">
      <span class="pricing-or__line"></span>
      <span class="pricing-or__word">or</span>
      <span class="pricing-or__line"></span>
    </div>

    <!-- right: we run it -->
    <section class="pricing-lane pricing-lane--managed">
      <p class="pricing-lane__label">Hand us the whole hire</p>

      <article class="pricing-managed">
        <div class="pricing-managed__tags">
          <span class="pricing-badge pricing-badge--rec">
            <i aria-hidden="true" set:html={I.star} />
            Recommended
          </span>
          <span class="pricing-badge pricing-badge--dark">{managed.badge}</span>
        </div>

        <div class="pricing-managed__head">
          <h2>{managed.title}</h2>
          <p class="pricing-managed__price">
            <strong>{managed.amount}</strong>
            <span>{managed.unit}</span>
          </p>
        </div>

        <ul class="pricing-managed__list">
          {
            managed.included.map((item) => (
              <li>
                <span class="pricing-tick" aria-hidden="true" set:html={tick} />
                {item}
              </li>
            ))
          }
        </ul>

        <dl class="pricing-deal">
          {
            deal.map((row) => (
              <div class:list={[row.key && "is-key"]}>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </article>
    </section>
  </div>
</section>
