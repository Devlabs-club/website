---
const icp = [
  "Pre-seed to seed founders",
  "~$1-10M raised",
  "Teams of 1-10",
  "Hiring first engineers",
];

const steps = [
  {
    n: "01",
    title: "Describe the role",
    body: "Founders tell us the work they need done, not just keywords on a job description.",
  },
  {
    n: "02",
    title: "Ranked shortlist",
    body: "Devlabs returns builders with proof, fit rationale and warm intro context.",
  },
  {
    n: "03",
    title: "Founders pay",
    body: "Teams pay for ranked shortlists and intros. Managed hiring starts with the existing $499 deposit plus success-based pricing.",
  },
];

const pricingNotes = [
  { label: "Explore", value: "Free", detail: "review starter builder signal" },
  { label: "Growth", value: "$20/mo", detail: "active hiring plan in the app" },
  { label: "Managed", value: "$499 deposit", detail: "end-to-end support, success-based on hire" },
];
---

<section class="pricing-slide__content deck-slide-layout">
  <header class="pricing-slide__header deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Ask / pricing / ICP</p>
  </header>

  <div class="pricing-slide__intro">
    <h1>Scale the builder graph into hiring</h1>
    <p>Early teams pay for proof-backed shortlists. Grant and partner support helps create more signal.</p>
  </div>

  <div class="ask-grid">
    <article class="ask-card ask-card--icp deck-card">
      <p class="ask-card__eyebrow">ICP</p>
      <h2>Early-stage founders hiring the first technical team</h2>
      <ul>
        {icp.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>

    <article class="ask-card ask-card--ask deck-card deck-card--orange">
      <p class="ask-card__eyebrow">The ask</p>
      <h2>Seeking non-dilutive / grant support</h2>
      <p>Scale builder events, proof capture and the matching product.</p>
      <div class="ask-placeholder">Raising / seeking $___ for events, product and GTM</div>
    </article>

    <article class="ask-card ask-card--steps deck-card">
      <p class="ask-card__eyebrow">How it works / who pays</p>
      <div class="ask-steps">
        {steps.map((step) => (
          <div class="ask-step">
            <b>{step.n}</b>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </article>

    <article class="ask-card ask-card--pricing deck-card">
      <p class="ask-card__eyebrow">Current pricing in product</p>
      <div class="pricing-notes">
        {pricingNotes.map((item) => (
          <div>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <em>{item.detail}</em>
          </div>
        ))}
      </div>
    </article>
  </div>
</section>
