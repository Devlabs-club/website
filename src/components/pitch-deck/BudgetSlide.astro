---
// How the $25K ask adds up: one bar, split by share. Set on a dark ground so
// it reads as the close of the ask rather than another card slide. Full unit
// costs live in the comment at the top of AskSlide.astro.
const parts = [
  { amount: "$10.9K", label: "Founder-led sales", share: 44, note: "We sell it ourselves. Lists, tools, and travel. Not new hires." },
  { amount: "$6K", label: "Expansion events", share: 24, note: "Events in Utah and Colorado to tap their founder networks." },
  { amount: "$3.6K", label: "Founder outreach", share: 14, note: "Founders at tech weeks, winning customers in person." },
  { amount: "$4.5K", label: "Tech & infra", share: 18, note: "Hosting, database and LinkedIn Sales Navigator." },
];
---

<section class="budget deck-slide-layout">
  <div class="budget-glow" aria-hidden="true"></div>

  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Use of funds</p>
  </header>

  <div class="budget-center">
    <p class="budget-eyebrow">Our ask</p>
    <strong class="budget-total">$25K</strong>

    <div class="budget-split">
      {
        parts.map((p, i) => (
          <div class={`budget-split__part s${i}`} style={`flex: ${p.share}`}>
            <i aria-hidden="true" />
            <strong>{p.amount}</strong>
            <span>{p.label}</span>
            <p>{p.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
