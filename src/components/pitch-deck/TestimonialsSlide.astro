---
// Portraits are pre-aligned: each one is composited onto identical 640x1000
// geometry with its eye line at the same height and its face scaled to the
// same size, so the heads line up across the row. Regenerate with the script
// in scripts/align-testimonial-portraits.py if you swap a photo.
// `logo` is a full wordmark. `mark` is an icon only, and gets the company
// name set beside it. With neither, the name alone stands in.
// Template only — replace `quote`, `author`, `role`, `company` with the real
// words. Drop a headshot path into `photo` and it fills the panel behind the
// copy, duotoned into that panel's colour; until then each panel shows a
// monogram. Every panel is the same size on purpose — no featured card.
const testimonials = [
  {
    tone: "orange",
    company: "pretorin",
    logo: "/brand/pretorin.png",
    // from the Devlabs Effect story 1 — his words, tightened to fit and with
    // the company name dropped since the wordmark sits directly above it
    quote:
      "The work here is ambiguous and the scope shifts weekly. That's usually where early-career engineers struggle. Ours didn't.",
    author: "Isaac Faber",
    role: "Founder",
    photo: "/pitch-deck/testimonials/aligned/p1.png",
  },
  {
    tone: "dark",
    company: "Google DeepMind",
    logo: "/sponsors/deepmind.png",
    quote: "The energy was electric and I've never seen a crowd like this before.",
    author: "Paige Bailey",
    role: "Lead DevRel",
    photo: "/pitch-deck/testimonials/aligned/p2.png",
  },
  {
    tone: "orange",
    company: "Supermemory",
    logo: "/sponsors/supermemory.png",
    quote:
      "I ended up hiring from the Devhouse. I'm super satisfied and this is the kind of talent you don't see in any hackathon.",
    author: "Dhravya Shah",
    role: "Founder",
    photo: "/pitch-deck/testimonials/aligned/p3.png",
  },
  {
    tone: "dark",
    company: "Sapling CRM",
    logo: "",
    // the supplied file had its wordmark set in white on white, so only the
    // leaf survived — the name is set alongside the mark instead
    mark: "/brand/sapling-crm.png",
    // from the Devlabs Effect story 4 — the headline off his card, plus what
    // the post says actually happened
    quote:
      "Proof of work got me a founding engineer. He had just graduated — one work trial, then a full-time offer.",
    author: "Alex Russo",
    role: "Founder",
    photo: "/pitch-deck/testimonials/aligned/p4.png",
  },
  {
    tone: "orange",
    company: "Browser Use",
    logo: "/sponsors/browser-use.png",
    quote: "This is one of the best hackathons we've sponsored.",
    author: "Saurav Panda",
    role: "Ex-Founding Engineer",
    photo: "/pitch-deck/testimonials/aligned/p5.png",
  },
];

// not a sixth testimonial — the band under the row is our own closing line,
// so it carries the Devlabs mark instead of a face and an attribution
const closer = {
  lead: "Founders meet builders in person, then trust the work enough to skip the hiring chaos.",
  accent: "That is the loop we built Devlabs for.",
};

const initials = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("");
---

<section class="testimonials deck-slide-layout">
  <header class="testimonials__header deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Testimonials</p>
  </header>

  <div class="testimonials__intro">
    <h1>Don&rsquo;t take our <em>word for it</em></h1>
    <p>Founders and sponsors who have hired out of the Devlabs pool.</p>
  </div>

  <div class="t-band">
    {
      testimonials.map((t, i) => (
        <article class:list={["t-panel", `t-panel--${t.tone}`, `t-panel--g${i + 1}`]}>
          <div class="t-panel__art" aria-hidden="true">
            <span class="t-panel__grad"></span>
            <span class="t-panel__bands"></span>
            {t.photo ? (
              <img src={t.photo} alt="" loading="eager" />
            ) : (
              <span class="t-panel__mono">{initials(t.author)}</span>
            )}
          </div>

          {t.logo ? (
            <img class="t-panel__logo" src={t.logo} alt={t.company} loading="eager" />
          ) : t.mark ? (
            <p class="t-panel__lockup">
              <img src={t.mark} alt="" loading="eager" />
              <span>{t.company}</span>
            </p>
          ) : (
            <p class="t-panel__co">{t.company}</p>
          )}

          <div class="t-panel__say">
            <p class="t-panel__quote">&ldquo;{t.quote}&rdquo;</p>
            <p class="t-panel__id">
              <strong>{t.author}</strong>
              <span>{t.role}</span>
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <aside class="t-closer">
    <img class="t-closer__logo" src="/logo.png" alt="" loading="eager" />
    <p class="t-closer__line">
      {closer.lead} <em>{closer.accent}</em>
    </p>
  </aside>
</section>
