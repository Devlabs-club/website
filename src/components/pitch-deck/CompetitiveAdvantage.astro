---
const featured = [
  {
    n: "01",
    title: "Signal is created live",
    body: "Hackathons, hacker houses and build nights show who can build before anyone opens a role.",
  },
  {
    n: "02",
    title: "Proof before profiles",
    body: "Founders see shipped work, collaboration style and why-hire evidence before the first intro.",
  },
];

const rest = [
  {
    n: "03",
    title: "Vs. job boards",
    body: "LinkedIn and Wellfound help search existing profiles. Devlabs adds observed proof from builders already shipping.",
  },
  {
    n: "04",
    title: "Vs. recruiters",
    body: "Recruiters expand the funnel. Devlabs narrows it to a ranked shortlist with specific evidence for the role.",
  },
  {
    n: "05",
    title: "Vs. AI sourcing tools",
    body: "AI tools summarize public data. Devlabs combines public proof with fresh signal from community events.",
  },
];

const metrics = [
  { value: "2,000+", label: "vetted builders" },
  { value: "20", label: "events in AZ & SF" },
  { value: "4", label: "companies hired" },
  { value: "$100K", label: "invested in events" },
];

const partners = [
  { name: "Stripe", src: "/sponsors/momentum/stripe.png" },
  { name: "Google DeepMind", src: "/sponsors/deepmind.png" },
  { name: "Dodo Payments", src: "/sponsors/momentum/dodo_payments.svg" },
  { name: "Browser Use", src: "/sponsors/browser-use.png" },
  { name: "Supermemory", src: "/sponsors/supermemory.png" },
];
---

<section class="advantage">
  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Competitive advantage</p>
  </header>

  <div class="advantage__intro">
    <h1>Why Devlabs wins early hiring</h1>
    <p>Competitors search for talent. Devlabs creates the signal that identifies it.</p>
  </div>

  <div class="advantage-lead">
    {featured.map((item) => (
      <article class="advantage-lead__card">
        <p class="advantage-card__n">{item.n}</p>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
      </article>
    ))}
  </div>

  <div class="advantage-rest">
    {rest.map((item) => (
      <article class="advantage-rest__item">
        <b>{item.n}</b>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
      </article>
    ))}
  </div>

  <div class="advantage-foot">
    <div class="advantage-facts">
      {metrics.map((metric) => (
        <div class="advantage-metric">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))}
    </div>
    <div class="advantage-logos-wrap">
      <p>event partners</p>
      <div class="advantage-logos">
        {partners.map((partner) => (
          <img src={partner.src} alt={partner.name} />
        ))}
      </div>
    </div>
  </div>
</section>
