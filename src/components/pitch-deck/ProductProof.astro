---
// Three steps, each with its statement on the left and what the founder
// actually sees on the right. Names are fictional and avatars are initials —
// no real builder's name or photograph appears.
// The real "1. Basics" step from the founder flow. `ghost: true` renders as
// placeholder text, matching an unfilled field in the product.
const basics = [
  { label: "Title", value: "Payments Engineer", key: true },
  { label: "Job type", value: "Full-time, contract", ghost: true },
  { label: "Must have", value: "Stripe, webhooks", key: true },
  { label: "Salary", value: "200k" },
];

// The real result card. Names are fictional and avatars are initials rather
// than photographs, so no builder's identity appears in the deck.
const results = [
  {
    initials: "MR",
    name: "Maya R.",
    badge: "Strong Match",
    bio: "Ships <b>payments</b> infrastructure in production — <b>Stripe</b> Connect, webhooks.",
    meta: "Greater Phoenix Area · Available now",
    prev: "Prev. intern · Tesla",
    tags: [],
    fit: "96",
    spark: [30, 55, 40, 72, 48, 85, 62, 95, 55, 80, 68, 92],
    lead: true,
  },
];

const sources = ["GitHub", "LinkedIn", "Resume", "Repos"];

// Agent-trace signals. Illustrative figures for the mock, not measured data.
const tools = [
  { name: "Claude", pct: 52 },
  { name: "Codex", pct: 31 },
  { name: "Cursor", pct: 17 },
];

const steps = [
  { n: "01", title: "Describe the role", body: "Plain language. Not a boolean search string." },
  { n: "02", title: "Get your top five builders", body: "Ranked on work they shipped, not keywords they listed." },
  { n: "03", title: "Open one — the proof is attached", body: "Repos, agent traces and event record, on every card." },
];
---

<div class="deck-bg" aria-hidden="true">
  <div class="deck-bg__base"></div>
  <div class="deck-bg__lens"></div>
  <div class="deck-bg__scan-lines"></div>
  <div class="deck-bg__grain"></div>
  <div class="deck-bg__fade"></div>
</div>

<section class="pflow">
  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> The product</p>
  </header>

  <div class="pflow-rows">
    <span class="pflow-rail" aria-hidden="true"></span>
    <!-- 01 · the query -->
    <div class="pflow-row">
      <div class="pflow-step">
        <p class="pflow-step__n"><span>{steps[0].n}</span></p>
        <h2 class="pflow-step__title">{steps[0].title}</h2>
        <p class="pflow-step__body">{steps[0].body}</p>
      </div>
      <div class="pflow-art">
        <div class="pflow-form">
          <div class="pflow-form__head">
            <p>1. Basics</p>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="m6 15 6-6 6 6"></path>
            </svg>
          </div>
          <div class="pflow-form__grid">
            {
              basics.map((f) => (
                <label class="pflow-field">
                  <span class="pflow-field__label">{f.label}</span>
                  <span
                    class:list={[
                      "pflow-field__input",
                      f.ghost && "pflow-field__input--ghost",
                      f.key && "pflow-field__input--key",
                    ]}
                  >
                    {f.value}
                  </span>
                </label>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- 02 · the shortlist -->
    <div class="pflow-row">
      <div class="pflow-step">
        <p class="pflow-step__n"><span>{steps[1].n}</span></p>
        <h2 class="pflow-step__title">{steps[1].title}</h2>
        <p class="pflow-step__body">{steps[1].body}</p>
      </div>
      <div class="pflow-art">
        <div class="pflow-results">
          {
            results.map((b) => (
              <article class:list={["pcard", b.lead && "pcard--lead"]}>
                <div class="pcard__top">
                  <span class="pflow-avatar">{b.initials}</span>
                  <div class="pcard__id">
                    <p class="pcard__name">
                      {b.name}
                      <span class="pcard__badge">{b.badge}</span>
                    </p>
                    <p class="pcard__bio" set:html={b.bio}></p>
                    <p class="pcard__meta">{b.meta}</p>
                    <p class="pcard__prev">
                      <img src="/pitch-deck/logos/tesla.svg" alt="" />
                      {b.prev}
                      <span class="pcard__spark" aria-hidden="true">
                        {b.spark.map((h) => <i style={`height: ${h}%`}></i>)}
                      </span>
                      <span class="pcard__spark-label">ship cadence · 12w</span>
                    </p>
                  </div>
                  <span class="pcard__fit">
                    <svg viewBox="0 0 44 44" aria-hidden="true">
                      <circle class="pcard__ring-bg" cx="22" cy="22" r="19" />
                      <circle
                        class="pcard__ring-fg"
                        cx="22"
                        cy="22"
                        r="19"
                        style={`stroke-dasharray: ${(Number(b.fit) / 100) * 119.4} 119.4`}
                      />
                    </svg>
                    <span class="pcard__fit-num">{b.fit}<em>%</em></span>
                  </span>
                </div>

                {b.tags.length > 0 && (
                  <ul class="pcard__tags">
                    {b.tags.map((t, i) => <li class:list={[i === 0 && "pcard__tags--lead"]}>{t}</li>)}
                  </ul>
                )}

                <div class="pcard__foot">
                  <span class="pcard__icons">
                    <img src="/socials/linkedin.svg" alt="" />
                    <img src="/brand/github.svg" alt="" />
                  </span>
                  <span class="pcard__link">Full profile</span>
                  <span class="pcard__trace">Trace</span>
                  <span class="pcard__actions">
                    <em>Pass</em>
                    <strong>Invite</strong>
                  </span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 03 · the proof -->
    <div class="pflow-row">
      <div class="pflow-step">
        <p class="pflow-step__n"><span>{steps[2].n}</span></p>
        <h2 class="pflow-step__title">{steps[2].title}</h2>
        <p class="pflow-step__body">{steps[2].body}</p>
      </div>
      <div class="pflow-art">
        <article class="pmodal">
          <div class="pmodal__bar">
            <p>Builder profile</p>
            <span aria-hidden="true">&times;</span>
          </div>

          <div class="pmodal__body">
            <div class="pmodal__id">
              <span class="pflow-avatar pflow-avatar--lg">MR</span>
              <p class="pmodal__name">Maya R.</p>
              <p class="pmodal__role">Full-stack engineer · payments</p>
              <p class="pmodal__loc">Greater Phoenix Area</p>
              <div class="pmodal__links">
                <span>GitHub</span><span>LinkedIn</span><span>Resume</span>
              </div>
            </div>

            <aside class="psig">
              <p class="psig__label">Agent signals</p>

              <ul class="psig__tools">
                {
                  tools.map((t) => (
                    <li>
                      <span class="psig__tool-name">{t.name}</span>
                      <span class="psig__tool-bar" aria-hidden="true">
                        <i style={`width: ${t.pct}%`}></i>
                      </span>
                      <span class="psig__tool-pct">{t.pct}%</span>
                    </li>
                  ))
                }
              </ul>

              <div class="psig__arch">
                <span class="psig__arch-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" />
                  </svg>
                </span>
                <span class="psig__arch-text">
                  <strong>Night owl</strong>
                  <em>Peak commits 11pm &ndash; 2am</em>
                </span>
              </div>

              <div class="psig__row">
                <p class="psig__k">Strongest on</p>
                <ul class="psig__chips">
                  <li>infra</li>
                  <li>full-stack</li>
                </ul>
              </div>

              <div class="psig__row">
                <p class="psig__k">Agents used for</p>
                <p class="psig__v">Refactors, tests and migrations</p>
              </div>
            </aside>
            <div class="ptrace-panel">
              <div class="ptrace-panel__head">
                <span class="ptrace-panel__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 4.5 13.9 9.6 19 11.5 13.9 13.4 12 18.5 10.1 13.4 5 11.5 10.1 9.6Z" />
                  </svg>
                </span>
                <span class="ptrace-panel__label">
                  <em>Agent trace</em>
                  <i>Preview from resume, LinkedIn &amp; projects</i>
                </span>
                <span class="ptrace-panel__btn">Preview</span>
              </div>

              <p class="ptrace-panel__h">How they ship</p>

              <div class="pmatch">
                <div class="pmatch__top">
                  <span class="pmatch__label">Role match</span>
                  <span class="pmatch__num">96<em>%</em></span>
                </div>
                <p class="pmatch__verdict">Strong <b>payments</b> overlap</p>
                <span class="pmatch__bar" aria-hidden="true"><i style="width: 96%"></i></span>
              </div>

              <ul class="psrc">
                {sources.map((c) => <li>{c}</li>)}
              </ul>

              <p class="ptrace-panel__body">
                Owned checkout end to end and shipped <b>Stripe</b> Connect in production —
                not a tutorial repo.
              </p>

              <ul class="ppills">
                <li>96% match</li>
                <li>8 projects reviewed</li>
              </ul>
            </div>

          </div>
        </article>
      </div>
    </div>
  </div>
</section>
