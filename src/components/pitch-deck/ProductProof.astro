---
const query = "I want to hire full stack developers with experience in stripe integration";

const matches = [
  {
    name: "Aakash K.",
    photo: "/landing/builders/aakash.jpg",
    role: "Full-stack · 5+ hackathon winner",
    intern: { company: "Tesla", logo: "/pitch-deck/logos/tesla.svg" },
    why: "Owned checkout end to end and shipped Stripe Connect in production, not a tutorial repo.",
    repo: "stripe-connect",
    tweet: "Shipped Stripe Connect onboarding in a weekend",
    wrapped: [
      {
        prompt: "Which archetype?",
        title: "The Architect",
        detail: "Plans the billing model first, then writes the path that compounds.",
        art: "/wrapped/story-office-glitch.jpg",
      },
      {
        prompt: "Which model?",
        title: "Claude into Codex",
        detail: "Explores the system in Claude, then ships the webhook in Codex.",
        art: "/wrapped/story-code-field.jpg",
      },
      {
        prompt: "When do they ship?",
        title: "Night owl",
        detail: "Most payment commits land after the room gets quiet.",
        art: "/wrapped/story-green-halftone.jpg",
      },
    ],
  },
  {
    name: "Abhinav R.",
    photo: "/landing/builders/abhinav.jpg",
    role: "Full-stack",
    intern: { company: "Waymo", logo: "/pitch-deck/logos/waymo.png" },
    why: "Has shipped subscription billing and webhook recovery on a real product, not a resume keyword.",
    repo: "stripe-hooks",
    tweet: "Webhook retries are the whole Stripe job",
    wrapped: [
      {
        prompt: "Which archetype?",
        title: "Velocity Machine",
        detail: "Jumps into the failing webhook and ships the recovery path.",
        art: "/wrapped/story-red-glitch.jpg",
      },
      {
        prompt: "How do they steer?",
        title: "Stops and redirects",
        detail: "Cuts the agent when it touches the wrong billing file.",
        art: "/wrapped/story-soft-mesh.jpg",
      },
      {
        prompt: "Longest agent run?",
        title: "3h 12m",
        detail: "One session chased dunning retries until he stepped in.",
        art: "/wrapped/story-red-abstract.jpg",
      },
    ],
  },
];
---

<section class="product-proof">
  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> The product</p>
  </header>

  <div class="product-proof__intro">
    <h1>Describe the role.<br />Get builders with proof attached</h1>
    <p>Every recommendation explains what the builder shipped,<br />how they worked and why they fit the role.</p>
  </div>

  <div class="product-demo">
    <div class="product-search">
      <div class="product-search__bar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <p>{query}</p>
        <span class="product-search__go" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </div>
    </div>

    <div class="product-results">
      {matches.map((match) => (
        <article class="product-card">
          <div class="product-card__top">
            <img src={match.photo} alt="" />
            <div>
              <p class="product-card__kicker">Ranked recommendation</p>
              <h2>{match.name}</h2>
              <p class="product-card__role">{match.role}</p>
              {match.intern && (
                <p class="product-card__intern">
                  <img src={match.intern.logo} alt="" />
                  prev intern @ {match.intern.company}
                </p>
              )}
            </div>
            <p class="product-card__badge">Strong match</p>
          </div>

          <div class="product-why">
            <p class="product-why__label">Why hire</p>
            <p class="product-why__text">{match.why}</p>
          </div>

          <div class="product-wrapped">
            <p class="product-wrapped__label">Agent Wrapped</p>
            <div class="product-wrapped__row">
              {match.wrapped.map((card, cardIndex) => (
                <article class:list={["product-wrap-card", `product-wrap-card--${cardIndex + 1}`]}>
                  <div class="product-wrap-card__art">
                    <div class="product-wrap-card__dither">
                      <img src={card.art} alt="" />
                      <i class="product-wrap-card__bayer"></i>
                    </div>
                    <i class="product-wrap-card__ink"></i>
                    <i class="product-wrap-card__fade"></i>
                    <div class="product-wrap-card__dots" aria-hidden="true">
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                  </div>
                  <div class="product-wrap-card__body">
                    <p>{card.prompt}</p>
                    <h3>{card.title}</h3>
                    <span>{card.detail}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="product-card__foot">
            <p class="product-pills">
              <span class="product-pill">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
                </svg>
                <em>{match.repo}</em>
              </span>
              <span class="product-pill">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
                <em>{match.tweet}</em>
              </span>
            </p>
            <button type="button" class="product-invite">Invite</button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
