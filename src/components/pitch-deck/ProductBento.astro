---
const sources = [
  { id: "linkedin", label: "LinkedIn", src: "/sponsors/companies/linkedin.svg", x: 50, y: 16 },
  { id: "github", label: "GitHub", src: "/brand/github.svg", x: 82, y: 38 },
  { id: "hackathons", label: "Hackathons", src: "/events/devhacks_logo.svg", x: 78, y: 78 },
  { id: "claude", label: "Claude", src: "/brand/claude.png", x: 50, y: 88 },
  { id: "cursor", label: "Cursor", src: "/brand/cursor-ai.svg", x: 18, y: 38 },
];

const communityFaces = [
  "/landing/community/devhacks-crowd.png",
  "/landing/community/devhacks-build.png",
  "/landing/community/devspace-talk.png",
];
---

<div class="product-bento">
  <article class="product-bento__panel product-bento__sources">
    <div class="product-sources__copy">
      <div class="product-sources__heading">
        <h3>Proof of work</h3>
        <span class="product-sources__badge">5 sources</span>
      </div>
      <p>Real evidence from where builders already ship.</p>
    </div>
    <div class="product-source-hub" aria-hidden="true">
      <svg class="product-source-hub__lines" viewBox="0 0 520 320" preserveAspectRatio="none">
        {sources.map((source) => (
          <line
            x1="260"
            y1="178"
            x2={(source.x / 100) * 520}
            y2={(source.y / 100) * 320}
            stroke="rgba(31, 42, 46, 0.22)"
            stroke-width="1"
            stroke-dasharray="3 5"
            stroke-linecap="round"
          />
        ))}
      </svg>
      <div class="product-source-hub__center">
        <img src="/logo.svg" alt="" />
      </div>
      {sources.map((source) => (
        <div class="product-source-hub__node" style={`left: ${source.x}%; top: ${source.y}%;`}>
          <div class:list={["product-source-hub__icon", `product-source-hub__icon--${source.id}`]}>
            <img src={source.src} alt="" />
          </div>
          <span>{source.label}</span>
        </div>
      ))}
    </div>
  </article>

  <article class="product-bento__panel product-bento__community">
    <div class="product-community">
      <div class="product-community__card product-community__card--primary">
        <div class="product-community__avatars">
          {communityFaces.map((face) => (
            <img src={face} alt="" />
          ))}
        </div>
        <p>Build with Devlabs</p>
      </div>
      <div class="product-community__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 5v12m0 0-4-4m4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="product-community__card product-community__card--secondary">
        <p>Ship projects. Build proof. Get hired.</p>
      </div>
    </div>
  </article>

  <article class="product-bento__panel product-bento__demo">
    <div class="product-demo__label">Recommendations engine</div>
    <div class="product-demo__screen">
      <img src="/pitch-deck/recommendations-demo.png" alt="Recommendations panel showing matched builders and why-hire evidence" loading="eager" />
    </div>
  </article>
</div>
