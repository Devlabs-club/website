---
// Left: an explicit intake panel — every source named with what it yields, and
// what the four of them resolve into. Right: the real Agent Wrapped exports.
const intake = [
  {
    name: "GitHub",
    yield: "Commits, reviews, and what actually shipped",
    icons: ["/brand/github.svg"],
  },
  {
    name: "Claude · Codex · Cursor",
    yield: "Agent traces — how they work, not just the result",
    // cursor-ai.svg is a filled rounded-square lockup — it knocks to a solid
    // black tile under the ink filter, so the row carries two marks and names three
    icons: ["/brand/claude.png", "/brand/chatgpt.svg"],
    live: true,
  },
  {
    name: "LinkedIn · web",
    yield: "Context, history and corroboration",
    icons: ["/socials/linkedin.svg"],
  },
  {
    name: "Our events",
    yield: "Hackathons, houses and demo days we ran",
    icons: [],
  },
];
---

<section class="builder-criteria">
  <header class="builder-criteria__header deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> What we look for</p>
  </header>

  <div class="bc-split">
    <div class="bc-left">
      <div class="builder-criteria__intro">
        <h1 class="builder-criteria__title">
          We already know <em>if you can ship</em>
        </h1>
      </div>

      <!-- the intake -->
      <section class="bc-intake">
        <div class="bc-intake__head">
          <p>Four sources, one profile</p>
          <span>what we pull, and what it tells us</span>
        </div>

        <ul class="bc-intake__list">
          {
            intake.map((row) => (
              <li class:list={["bc-src", row.live && "bc-src--live"]}>
                <span class="bc-src__icons">
                  {row.icons.length > 0 ? (
                    row.icons.map((i) => <img src={i} alt="" />)
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M4 20V9l8-5 8 5v11" />
                      <path d="M9.5 20v-6h5v6" />
                    </svg>
                  )}
                </span>
                <span class="bc-src__text">
                  <strong>{row.name}</strong>
                  <em>{row.yield}</em>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="bc-intake__out">
          <span class="bc-intake__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </span>
          <p>One verified builder profile</p>
        </div>
      </section>
    </div>

    <!-- the wrapped cards -->
    <section class="bc-col bc-col--trace">
      <div class="bc-trace-head">
        <p>What the agent trace reveals</p>
        <span>real wrapped exports from our builders</span>
      </div>

      <div class="bc-fan">
        <figure class="bc-fan__card bc-fan__card--1">
          <img src="/pitch-deck/wrapped/hours.png" alt="Agent Wrapped: 521 hours built with agents" />
        </figure>
        <figure class="bc-fan__card bc-fan__card--2">
          <img src="/pitch-deck/wrapped/tokens.png" alt="Agent Wrapped: 16.2B tokens burned with agents" />
        </figure>
        <figure class="bc-fan__card bc-fan__card--3">
          <img src="/pitch-deck/wrapped/model.png" alt="Agent Wrapped: top model GPT-5, 51% of sessions" />
        </figure>
      </div>
    </section>
  </div>
</section>
