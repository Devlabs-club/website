---
const criteria = [
  "Pre-seed and seed startups",
  "Founder-led hiring",
  "No internal recruiting team",
  "Hiring founding and early engineers",
  "Needs a small, trusted shortlist",
];

const steps = [
  { n: "01", title: "Watch builders work" },
  { n: "02", title: "Capture real proof" },
  { n: "03", title: "Identify the strongest builders" },
  { n: "04", title: "Recommend a trusted shortlist" },
];
---

<section class="target-audience">
  <header class="deck-slide-header">
    <div class="deck-brand-lockup">
      <img src="/logo.svg" alt="" />
      <span>Devlabs</span>
    </div>
    <p class="deck-slide-meta"><i></i> Target audience</p>
  </header>

  <div class="target-split">
    <div class="target-copy">
      <h1>Built for startups making their first technical hires</h1>
      <p>
        Pre-seed and seed founders do not need another database of applicants.
        They need a small, trusted shortlist of builders who have already proved they can ship.
      </p>

      <div class="target-serve">
        <p class="target-serve__label">Who we serve</p>
        <ol>
          {criteria.map((item) => (
            <li>
              <span aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ol>
      </div>
    </div>

    <figure class="target-stage">
      <img src="/landing/community/devhacks-build.png" alt="Builders working together at DevHacks" />
      <figcaption class="target-stage__source">
        Hackathons + hacker houses + build nights
      </figcaption>
      <ol class="target-funnel">
        {steps.map((step, index) => (
          <li class:list={[index === steps.length - 1 && "is-last"]}>
            <b>{step.n}</b>
            <span>{step.title}</span>
          </li>
        ))}
      </ol>
    </figure>
  </div>

  <p class="target-bottom">
    The best builders are not always applying. We bring them into the hiring funnel through events.
  </p>
</section>
