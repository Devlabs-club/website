---
---

<div class="solution-visual">
  <div class="solution-visual__glow" aria-hidden="true"></div>
  <div class="solution-stripes" aria-hidden="true"></div>

  <div class="solution-panel">
    <div class="solution-flow">
      <article class="solution-card">
        <div class="solution-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 20h16M6 20V8l6-4 6 4v12M10 12h4v8h-4v-8z"></path>
          </svg>
        </div>
        <div>
          <h3>Startups</h3>
          <p>Early-stage companies making their initial technical hires.</p>
        </div>
        <span class="solution-card__tag">Hiring</span>
      </article>

      <div class="solution-bridge" aria-hidden="true">
        <span class="solution-bridge__line"></span>
        <div class="solution-hub">
          <img src="/logo.svg" alt="" />
        </div>
        <span class="solution-bridge__line"></span>
        <span class="solution-bridge__arms"></span>
      </div>

      <article class="solution-card">
        <div class="solution-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M8 3h8l4 4v14H4V3h4z"></path>
            <path d="M12 3v4h4M8 13h8M8 17h5"></path>
          </svg>
        </div>
        <div>
          <h3>Builders</h3>
          <p>Vetted through hackathons, hacker houses, and real work.</p>
        </div>
        <span class="solution-card__tag">Proof</span>
      </article>
    </div>

    <aside class="solution-product" aria-label="Product preview">
      <p class="solution-product__label">Builder profile</p>
      <div class="solution-product__header">
        <div class="solution-product__avatar">AK</div>
        <div>
          <p class="solution-product__name">Aakash K.</p>
          <p class="solution-product__role">Full-stack · DevHacks winner</p>
        </div>
      </div>
      <div class="solution-product__signals">
        <span class="solution-product__signal">3 shipped projects</span>
        <span class="solution-product__signal">Hackathon MVP</span>
        <span class="solution-product__signal">Open source</span>
      </div>
      <div class="solution-product__match">
        <span>Match score</span>
        <strong>94%</strong>
      </div>
    </aside>
  </div>
</div>
