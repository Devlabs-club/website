---
interface Props {
  kind: "mark" | "shield" | "rocket" | "bell" | "gauge" | "trend" | "laptop" | "clipboard" | "globe" | "apple" | "android";
  className?: string;
}

const { kind, className = "h-8 w-8" } = Astro.props;
---

{kind === "mark" && (
  <svg class={className} viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M32 7v50M32 7v50" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    <path d="M7 32h50" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    <path d="m14.3 14.3 35.4 35.4" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    <path d="m49.7 14.3-35.4 35.4" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
  </svg>
)}

{kind === "shield" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M24 5.5 39 11v12.8c0 9.1-6.3 15.5-15 18.8-8.7-3.3-15-9.7-15-18.8V11l15-5.5Z" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round" />
    <path d="M24 17.5v13" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
    <circle cx="24" cy="15" r="1.8" fill="currentColor" />
  </svg>
)}

{kind === "rocket" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M24 6.5c6.9 4.7 10.6 12.1 10.8 22.1L28.2 27 24 37l-4.2-10-6.6 1.6C13.6 18.6 17.2 11.2 24 6.5Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
    <circle cx="24" cy="18.2" r="2.7" fill="currentColor" />
    <path d="M16.3 33c-2.5 1.6-5.1 2.1-7.7 1.4 1.6-2.8 3.9-4.6 7.1-5.5M31.7 33c2.5 1.6 5.1 2.1 7.7 1.4-1.6-2.8-3.9-4.6-7.1-5.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
  </svg>
)}

{kind === "bell" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M24 9.5c-6.2 0-10.5 4.8-10.5 11.7 0 7.3-2.3 9.8-3.2 11h27.4c-.9-1.2-3.2-3.7-3.2-11C34.5 14.3 30.2 9.5 24 9.5Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
    <path d="M19.9 35.2a4.2 4.2 0 0 0 8.2 0M24 21.9v6M21 24.9h6" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
)}

{kind === "gauge" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle cx="24" cy="24" r="13.2" stroke="currentColor" stroke-width="3" />
    <path d="M24 24 30 18.8" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <path d="M24 8.5v2.8M39.5 24h-2.8M24 39.5v-2.8M8.5 24h2.8M35 13l-2 2M35 35l-2-2M13 35l2-2M13 13l2 2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  </svg>
)}

{kind === "trend" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M9 32.5 19.4 21.8l7.4 7.3L40 15.2" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M29.4 15.2H40v10.6" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{kind === "laptop" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="10" y="12" width="28" height="19" rx="3" stroke="currentColor" stroke-width="3" />
    <path d="M7 35.5h34" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
)}

{kind === "clipboard" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="13" y="10.5" width="22" height="28" rx="4" stroke="currentColor" stroke-width="3" />
    <rect x="18" y="7.5" width="12" height="6" rx="2" stroke="currentColor" stroke-width="2.6" />
    <path d="M20 26.5 23 30l6-8" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{kind === "globe" && (
  <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="3" />
    <ellipse cx="24" cy="24" rx="6.8" ry="15" stroke="currentColor" stroke-width="2.6" />
    <path d="M9.5 24h29M13.5 16.5h21M13.5 31.5h21" stroke="currentColor" stroke-width="2.4" />
  </svg>
)}

{kind === "apple" && (
  <svg class={className} viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
    <path d="M31.2 8.7c-1.2 1.5-3.1 2.7-4.9 2.5-.2-1.9.7-3.8 1.8-5 1.2-1.4 3.3-2.5 5-2.6.2 2-.6 3.9-1.9 5.1ZM38.4 33.8c-1 2.2-1.5 3.1-2.8 5.1-1.8 2.8-4.4 6.3-7.6 6.3-2.8 0-3.5-1.8-7.3-1.8s-4.6 1.8-7.4 1.9c-3.2.1-5.6-3.1-7.4-5.9-5-7.7-5.6-16.8-2.5-21.6 2.2-3.4 5.6-5.4 8.8-5.4 3.3 0 5.4 1.8 8.1 1.8 2.6 0 4.2-1.8 8-1.8 2.8 0 5.8 1.5 8 4.2-7 3.8-5.9 13.9 1.1 17.2Z" />
  </svg>
)}

{kind === "android" && (
  <svg class={className} viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
    <path d="M13.4 18.5h21.2v16.1c0 2-1.6 3.6-3.6 3.6h-1.5v5.2c0 1.3-1.1 2.4-2.4 2.4s-2.4-1.1-2.4-2.4v-5.2h-1.4v5.2c0 1.3-1.1 2.4-2.4 2.4s-2.4-1.1-2.4-2.4v-5.2H17c-2 0-3.6-1.6-3.6-3.6V18.5ZM8.4 19.2c1.3 0 2.4 1.1 2.4 2.4v10.7c0 1.3-1.1 2.4-2.4 2.4S6 33.6 6 32.3V21.6c0-1.3 1.1-2.4 2.4-2.4Zm31.2 0c1.3 0 2.4 1.1 2.4 2.4v10.7c0 1.3-1.1 2.4-2.4 2.4s-2.4-1.1-2.4-2.4V21.6c0-1.3 1.1-2.4 2.4-2.4ZM18.3 9.2l-2.5-4.4 1.7-1 2.6 4.5a13 13 0 0 1 7.8 0l2.6-4.5 1.7 1-2.5 4.4c3.1 1.7 5.1 4.4 5.1 7.5H13.2c0-3.1 2-5.8 5.1-7.5Zm1.7 3.9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm8 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
  </svg>
)}
