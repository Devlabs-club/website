---
interface Props {
  /** Optional label centered on the rail (e.g. "Trusted by") */
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={["landing-rule-rail", className]} aria-hidden={!label}>
  <span class="landing-rule-rail__cross landing-rule-rail__cross--tl" aria-hidden="true"></span>
  <span class="landing-rule-rail__cross landing-rule-rail__cross--tr" aria-hidden="true"></span>
  <span class="landing-rule-rail__cross landing-rule-rail__cross--bl" aria-hidden="true"></span>
  <span class="landing-rule-rail__cross landing-rule-rail__cross--br" aria-hidden="true"></span>
  <div class="landing-rule-rail__line landing-rule-rail__line--top"></div>
  <div class="landing-rule-rail__line landing-rule-rail__line--bottom"></div>
  {
    label ? (
      <p class="landing-rule-rail__label">{label}</p>
    ) : null
  }
</div>

<style>
  .landing-rule-rail {
    position: relative;
    width: var(--landing-rail-w, min(100%, 86rem));
    max-width: 100%;
    margin-inline: auto;
    min-height: 2.75rem;
    padding-inline: 0;
  }

  .landing-rule-rail__line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--landing-hairline, rgb(5 5 5 / 0.12));
  }

  .landing-rule-rail__line--top {
    top: 0.85rem;
  }

  .landing-rule-rail__line--bottom {
    bottom: 0.85rem;
  }

  .landing-rule-rail__cross {
    position: absolute;
    width: 9px;
    height: 9px;
    z-index: 1;
  }

  .landing-rule-rail__cross::before,
  .landing-rule-rail__cross::after {
    content: "";
    position: absolute;
    background: rgb(5 5 5 / 0.38);
  }

  .landing-rule-rail__cross::before {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .landing-rule-rail__cross::after {
    top: 50%;
    left: 0;
    height: 1px;
    width: 100%;
    transform: translateY(-50%);
  }

  .landing-rule-rail__cross--tl {
    top: calc(0.85rem - 4px);
    left: -4px;
  }

  .landing-rule-rail__cross--tr {
    top: calc(0.85rem - 4px);
    right: -4px;
  }

  .landing-rule-rail__cross--bl {
    bottom: calc(0.85rem - 4px);
    left: -4px;
  }

  .landing-rule-rail__cross--br {
    bottom: calc(0.85rem - 4px);
    right: -4px;
  }

  .landing-rule-rail__label {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    padding: 0.95rem 0.85rem;
    width: fit-content;
    text-align: center;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(5 5 5 / 0.45);
    background: #fbf6f3;
  }
</style>
