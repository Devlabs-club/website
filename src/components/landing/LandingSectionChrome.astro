---
/**
 * Cartesia-style section chrome: vertical rails + junction crosses.
 * Pair with `.ruler-section` on the parent for horizontal hairline dividers.
 */
interface Props {
  /** Show mid-column crosses on top/bottom edges (desktop). Default true. */
  mid?: boolean;
  class?: string;
}

const { mid = true, class: className } = Astro.props;
---

<div class:list={["ruler-rails", className]} aria-hidden="true"></div>
<div class:list={["ruler-crosses", !mid && "ruler-crosses--corners-only"]} aria-hidden="true">
  <span class="tl"></span>
  <span class="tr"></span>
  <span class="bl"></span>
  <span class="br"></span>
  {
    mid ? (
      <>
        <span class="mt-1"></span>
        <span class="mt-2"></span>
        <span class="mb-1"></span>
        <span class="mb-2"></span>
      </>
    ) : null
  }
</div>
