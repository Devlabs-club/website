---
import LandingSectionChrome from "./LandingSectionChrome.astro";
import { tryForFreeHref } from "../../lib/productCta";

const bookCallHref = "https://cal.com/geekydan/15min?overlayCalendar=true";
---

<section
  id="paths"
  class="audience-split-section ruler-section ruler-section--no-top landing-band-cream relative isolate overflow-hidden px-5 pb-20 pt-20 text-black sm:px-8 sm:pb-28 sm:pt-24 lg:px-10"
  aria-label="Two ways into DevLabs"
>
  <LandingSectionChrome mid={false} />
  <div class="section-industrial-grid" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-black/42">06 / Paths</p>
      <h2 class="mt-5 text-[clamp(2.2rem,6vw,4rem)] font-black leading-[0.96] tracking-[-0.04em] text-black">
        Two ways <span class="text-[#ff7417]">in.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[clamp(1rem,1.4vw,1.15rem)] font-medium leading-relaxed text-black/58">
        Founders hire from proof. Builders show up where the signal is made.
      </p>
    </header>

    <div class="audience-split mt-12 grid sm:mt-16 lg:grid-cols-2">
      <!-- Founders -->
      <article class="audience-panel landing-cut border border-black/12 bg-[#fffaf7] lg:border-r-0">
        <div class="flex items-center justify-between gap-3 border-b border-black/8 pb-4">
          <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.16em] text-black/42">For founders</p>
          <span class="dl-stamp">HIRE</span>
        </div>
        <h3 class="mt-6 text-[clamp(1.55rem,3vw,2.15rem)] font-black leading-[1.05] tracking-[-0.03em] text-black">
          Get a proof-backed shortlist
        </h3>
        <p class="mt-3 max-w-md text-sm font-medium leading-relaxed text-black/55 sm:text-[0.95rem]">
          Tell the agent who you need. Review builders ranked on shipped work, events, and real context — not keyword resumes.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={tryForFreeHref}
            class="nav-cut-button border-black bg-[#050505] text-white hover:border-[#ff7417] hover:bg-[#ff7417]"
          >
            Try for Free
          </a>
          <a
            href={bookCallHref}
            class="nav-cut-button border-black/15 bg-[#fbf6f3] text-black hover:border-[#ff7417] hover:text-[#bf4f08]"
          >
            Book a Call
          </a>
        </div>
      </article>

      <!-- Builders -->
      <article class="audience-panel landing-cut border border-black/12 bg-[#fff4ec]">
        <div class="flex items-center justify-between gap-3 border-b border-black/8 pb-4">
          <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.16em] text-black/42">For builders</p>
          <span class="dl-stamp dl-stamp--accent">SHIP</span>
        </div>
        <h3 class="mt-6 text-[clamp(1.55rem,3vw,2.15rem)] font-black leading-[1.05] tracking-[-0.03em] text-black">
          Join the network that gets hired
        </h3>
        <p class="mt-3 max-w-md text-sm font-medium leading-relaxed text-black/55 sm:text-[0.95rem]">
          Show up at DevHacks, DevHouse, and Momentum. Ship in public. Get on founder shortlists when the work is real.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/get-hired"
            class="nav-cut-button border-black bg-[#ff7417] text-white hover:border-[#050505] hover:bg-[#050505]"
          >
            Join as builder
          </a>
          <a
            href="/events"
            class="nav-cut-button border-black/15 bg-[#fffaf7] text-black hover:border-[#ff7417] hover:text-[#bf4f08]"
          >
            Explore events
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .audience-panel {
    --cut: 0.85rem;
    position: relative;
    z-index: 1;
    padding: 1.75rem 1.35rem 2rem;
  }

  @media (min-width: 640px) {
    .audience-panel {
      padding: 2.25rem 2rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .audience-split {
      border: 1px solid rgb(5 5 5 / 0.12);
    }

    .audience-panel {
      border: none !important;
      border-radius: 0;
    }

    .audience-panel + .audience-panel {
      border-left: 1px solid rgb(5 5 5 / 0.12) !important;
    }

    .audience-split {
      --cut: 1rem;
      clip-path: polygon(
        0 0,
        100% 0,
        100% calc(100% - var(--cut)),
        calc(100% - var(--cut)) 100%,
        0 100%
      );
    }
  }

  @media (max-width: 1023px) {
    .audience-split {
      gap: 0.75rem;
    }
  }
</style>
