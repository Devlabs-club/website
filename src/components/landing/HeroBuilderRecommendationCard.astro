---
interface Props {
  name: string;
  avatar: string;
  headline: string;
  matchLabel: string;
  matchScore: number;
  meta: string;
  title: string;
  company: string;
  companyLogo: string;
  whyHire: string;
  proof: string[];
  project: string;
  skills: string[];
  verified?: boolean;
  github?: string;
  linkedin?: string;
  website?: string;
  ctaHref: string;
  class?: string;
}

const {
  name,
  avatar,
  headline,
  matchLabel,
  matchScore,
  meta,
  title,
  company,
  companyLogo,
  whyHire,
  proof,
  project,
  skills,
  verified = true,
  github,
  linkedin,
  website,
  ctaHref,
  class: className,
} = Astro.props;

const initial = name.trim().charAt(0).toUpperCase();
---

<article class:list={["hero-result-card rounded-2xl border border-[#ece7e1] bg-white p-3.5 shadow-[0_1px_3px_rgba(16,24,40,0.05),0_10px_30px_rgba(16,24,40,0.05)] sm:p-5", className]}>
  <div class="flex items-start justify-between gap-3 sm:gap-4">
    <div class="flex min-w-0 gap-2.5 sm:gap-3">
      {avatar ? (
        <img src={avatar} alt="" class="h-10 w-10 shrink-0 rounded-full object-cover sm:h-12 sm:w-12" />
      ) : (
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f3ede4] text-sm font-semibold text-black/60 sm:h-12 sm:w-12">
          {initial}
        </div>
      )}
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-1.5">
          <a href={ctaHref} class="text-base font-semibold text-black hover:underline sm:text-lg">{name}</a>
          {verified && (
            <svg class="h-4 w-4 shrink-0 text-[#ec9149]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          )}
          <span class="rounded-full border border-[#ec9149]/25 bg-[#fff7ef] px-2 py-0.5 text-[10px] font-semibold text-[#c56a12]">
            {matchLabel}
          </span>
        </div>
        <p class="mt-0.5 line-clamp-1 text-sm text-black/55">{headline}</p>
        <p class="mt-1 text-[11px] text-black/40">{meta}</p>
        <div class="mt-1.5 hidden items-center gap-1.5 text-[11px] text-black/50 sm:flex">
          <img src={companyLogo} alt="" class="h-4 w-4 rounded object-contain" loading="lazy" />
          <span class="line-clamp-1">{title} · {company}</span>
        </div>
      </div>
    </div>
    <div class="shrink-0 text-right">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-black/35">Fit</p>
      <p class="text-xl font-semibold text-black sm:text-2xl">{matchScore}%</p>
    </div>
  </div>

  <div class="mt-3 rounded-xl border border-[#ec9149]/35 bg-[#fff7ef] px-3 py-2.5 sm:mt-4 sm:px-4 sm:py-3.5">
    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#c56a12]">Why hire</p>
    <p class="mt-1 line-clamp-3 text-[13px] font-medium leading-relaxed text-black/90 sm:mt-1.5 sm:line-clamp-none sm:text-[15px]">
      {whyHire}
    </p>
  </div>

  <ul class="mt-2.5 hidden space-y-1.5 sm:mt-3 sm:block">
    {proof.map((bullet) => (
      <li class="flex gap-2 text-sm leading-snug text-black/65">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#ec9149]"></span>
        <span class="line-clamp-2">{bullet}</span>
      </li>
    ))}
  </ul>

  <div class="mt-2.5 flex flex-wrap items-center gap-1.5 sm:mt-3">
    <span class="inline-flex max-w-full rounded-full border border-[#ece7e1] bg-[#fdfaf7] px-2.5 py-1 text-[11px] font-medium text-black/60">
      <span class="truncate">{project}</span>
    </span>
    {skills.map((skill) => (
      <span class="rounded-full border border-[#ece7e1] px-2.5 py-1 text-[11px] text-black/55">{skill}</span>
    ))}
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-[#ece7e1] pt-2.5 sm:mt-4 sm:gap-3 sm:pt-3">
    <div class="flex flex-wrap items-center gap-2">
      {linkedin && (
        <a href={linkedin} target="_blank" rel="noreferrer" class="grid h-8 w-8 place-items-center rounded-lg border border-[#ece7e1] text-black/45 hover:bg-[#fdfaf7] hover:text-black" aria-label={`${name} LinkedIn`}>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noreferrer" class="grid h-8 w-8 place-items-center rounded-lg border border-[#ece7e1] text-black/45 hover:bg-[#fdfaf7] hover:text-black" aria-label={`${name} GitHub`}>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
      )}
      {website && (
        <a href={website} target="_blank" rel="noreferrer" class="grid h-8 w-8 place-items-center rounded-lg border border-[#ece7e1] text-black/45 hover:bg-[#fdfaf7] hover:text-black" aria-label={`${name} website`}>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
        </a>
      )}
      <a href={ctaHref} class="inline-flex h-8 items-center rounded-lg px-2 text-xs font-medium text-black/55 hover:bg-[#fdfaf7] hover:text-black">
        Full profile
      </a>
    </div>
    <div class="flex gap-2">
      <button
        type="button"
        class="inline-flex h-8 items-center rounded-lg border border-[#ece7e1] px-2.5 text-sm font-semibold text-black hover:bg-[#fdfaf7] sm:h-9 sm:px-3"
      >
        Pass
      </button>
      <a
        href={ctaHref}
        class="inline-flex h-8 items-center justify-center gap-1.5 rounded-lg bg-[#ec9149] px-2.5 text-sm font-semibold text-white hover:bg-[#dd7f36] sm:h-9 sm:px-3"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <line x1="19" x2="19" y1="8" y2="14"></line>
          <line x1="22" x2="16" y1="11" y2="11"></line>
        </svg>
        Invite
      </a>
    </div>
  </div>
</article>
