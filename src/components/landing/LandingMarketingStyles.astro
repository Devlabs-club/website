    .hero-star-left {
      left: -7rem !important;
      top: 5rem !important;
      width: 14rem !important;
      height: 14rem !important;
    }

    .hero-star-right {
      right: -4rem !important;
      top: 5rem !important;
      width: 12rem !important;
      height: 12rem !important;
    }

    .ruler-rails {
      display: none;
    }
  }
</style>
