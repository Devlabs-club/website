---
import { tryForFreeHref } from "../../lib/productCta";

interface Props {
  active?: "product" | "pricing" | "events" | "about" | "sponsor";
}

const { active } = Astro.props;

const links = [
  { id: "product" as const, label: "Product", href: "/#product" },
  { id: "pricing" as const, label: "Pricing", href: "/#pricing" },
  { id: "events" as const, label: "Events", href: "/events" },
  { id: "about" as const, label: "Our Story", href: "/about" },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 border-b border-black/[0.07] bg-[#f7f4f1]/90 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[3.75rem] w-full max-w-[86rem] items-center justify-between gap-4 px-5 sm:h-16 sm:px-8 lg:px-10"
  >
    <a
      href="/"
      aria-label="DevLabs home"
      class="grid h-10 w-10 shrink-0 place-items-center transition opacity-90 hover:opacity-100"
    >
      <img src="/logo.png" alt="" class="h-8 w-8 object-contain" />
    </a>

    <nav class="hidden flex-1 items-center justify-center lg:flex">
      {links.map((link, index) => (
        <>
          <a
            href={link.href}
            data-active={active === link.id ? "true" : undefined}
            class="nav-industrial-link"
          >
            {link.label}
          </a>
          {index < links.length - 1 ? (
            <span class="mx-4 h-3 w-px bg-black/20 sm:mx-5" aria-hidden="true" />
          ) : null}
        </>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center gap-2.5 md:flex">
      <a
        href="/auth/login"
        class="nav-cut-button bg-transparent text-black hover:text-[#bf4f08]"
      >
        Sign In
      </a>
      <a
        href={tryForFreeHref}
        class="nav-cut-button border-black bg-[#050505] text-white hover:border-[#ff7417] hover:bg-[#ff7417]"
      >
        Hire Now
      </a>
    </div>

    <a
      href={tryForFreeHref}
      class="nav-cut-button border-black bg-[#050505] px-3.5 text-white md:hidden"
    >
      Hire Now
    </a>
  </div>
</header>
