---
import LandingSectionChrome from "./LandingSectionChrome.astro";
---

<section
  id="system"
  class="system-map-section ruler-section ruler-section--no-top landing-band-cream relative isolate overflow-hidden px-5 pb-20 pt-20 text-black sm:px-8 sm:pb-28 sm:pt-24 lg:px-10"
  aria-label="How DevLabs turns signal into a shortlist"
  data-system-map
>
  <LandingSectionChrome mid={false} />
  <div class="section-industrial-grid" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl">
    <header class="mx-auto max-w-4xl text-center">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-black/42">02 / System</p>
      <h2 class="mt-5 text-[clamp(2.1rem,6.5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.04em] text-black">
        Hire from what people ship, not what they <span class="text-[#ff7417]">claim.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-[clamp(1rem,1.5vw,1.2rem)] font-medium leading-relaxed text-black/58">
        Real work, events, and founder context resolve into a shortlist you can act on — before another resume pile.
      </p>
    </header>

    <div class="system-map-panel landing-cut relative mt-12 overflow-hidden border border-black/12 bg-[#fffaf7] sm:mt-16">
      <div class="section-industrial-grid section-industrial-grid--inset opacity-60" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-wrap items-center justify-center gap-2 border-b border-black/8 px-4 py-3 sm:justify-between sm:px-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="dl-stamp">SHIPPED</span>
          <span class="dl-stamp">EVENT</span>
          <span class="dl-stamp">VOUCHED</span>
        </div>
        <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.14em] text-black/38">
          From signal → shortlist
        </p>
      </div>

      <!-- Desktop: horizontal flow -->
      <div class="system-map-desktop relative hidden px-4 py-10 sm:block sm:px-8 sm:py-14 lg:px-12">
        <svg
          class="system-map-svg mx-auto w-full max-w-5xl"
          viewBox="0 0 960 280"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Signal sources flow into the DevLabs graph, then to an agent shortlist and hire"
        >
          <title>From signal to shortlist</title>

          <!-- Edges: sources → hub -->
          <g class="dl-edge-group" stroke="rgb(5 5 5 / 0.28)" stroke-width="1.25" stroke-linecap="round">
            <path class="dl-edge" d="M170 48 H300 V140 H380" />
            <path class="dl-edge" d="M170 108 H300 V140 H380" />
            <path class="dl-edge" d="M170 168 H300 V140 H380" />
            <path class="dl-edge" d="M170 228 H300 V140 H380" />
            <!-- hub → shortlist → hire -->
            <path class="dl-edge dl-edge--accent" d="M560 140 H640" stroke="#ff7417" stroke-opacity="0.55" />
            <path class="dl-edge dl-edge--accent" d="M780 140 H840" stroke="#ff7417" stroke-opacity="0.55" />
          </g>

          <!-- Source nodes -->
          <g class="dl-node-group" font-family="Manrope, system-ui, sans-serif">
            <!-- Events -->
            <g transform="translate(40, 28)">
              <path class="dl-node" d="M0 0 H130 V32 L122 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="#ff7417" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Events</text>
            </g>
            <!-- GitHub -->
            <g transform="translate(40, 88)">
              <path class="dl-node" d="M0 0 H130 V32 L122 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">GitHub</text>
            </g>
            <!-- Shipped work -->
            <g transform="translate(40, 148)">
              <path class="dl-node" d="M0 0 H130 V32 L122 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Shipped work</text>
            </g>
            <!-- Founder notes -->
            <g transform="translate(40, 208)">
              <path class="dl-node" d="M0 0 H130 V32 L122 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Founder notes</text>
            </g>

            <!-- Hub: DevLabs graph + crosshair -->
            <g transform="translate(380, 88)">
              <path class="dl-node dl-node--hub" d="M0 0 H180 V92 L168 104 H0 Z" stroke="#ff7417" stroke-width="1.5" fill="#fff4ec" />
              <!-- decision crosshair -->
              <g class="dl-crosshair" stroke="#ff7417" stroke-width="1.25" opacity="0.85">
                <line x1="90" y1="12" x2="90" y2="28" />
                <line x1="82" y1="20" x2="98" y2="20" />
              </g>
              <text x="90" y="52" text-anchor="middle" font-size="11" font-weight="800" letter-spacing="0.12em" fill="#bf4f08">
                DEVLABS
              </text>
              <text x="90" y="72" text-anchor="middle" font-size="15" font-weight="800" fill="#050505">
                graph
              </text>
              <text x="90" y="90" text-anchor="middle" font-size="10" font-weight="600" fill="rgb(5 5 5 / 0.45)">
                resolve · rank · route
              </text>
            </g>

            <!-- Agent shortlist -->
            <g transform="translate(640, 110)">
              <path class="dl-node" d="M0 0 H140 V48 L132 60 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <text x="70" y="28" text-anchor="middle" font-size="12" font-weight="800" fill="#050505">
                Agent shortlist
              </text>
              <text x="70" y="44" text-anchor="middle" font-size="10" font-weight="600" fill="rgb(5 5 5 / 0.45)">
                evidence-ranked
              </text>
            </g>

            <!-- Hire -->
            <g transform="translate(840, 118)">
              <path class="dl-node dl-node--out" d="M0 0 H80 V36 L72 44 H0 Z" stroke="#050505" stroke-width="1.5" fill="#050505" />
              <text x="40" y="27" text-anchor="middle" font-size="12" font-weight="800" fill="#fffaf7">
                Hire
              </text>
            </g>
          </g>
        </svg>
      </div>

      <!-- Mobile: vertical trace -->
      <div class="system-map-mobile relative px-5 py-8 sm:hidden">
        <svg
          class="system-map-svg mx-auto w-full max-w-xs"
          viewBox="0 0 280 520"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Signal sources flow into the DevLabs graph, then to an agent shortlist and hire"
        >
          <title>From signal to shortlist</title>

          <g class="dl-edge-group" stroke="rgb(5 5 5 / 0.28)" stroke-width="1.25" stroke-linecap="round">
            <path class="dl-edge" d="M140 52 V72" />
            <path class="dl-edge" d="M140 112 V132" />
            <path class="dl-edge" d="M140 172 V192" />
            <path class="dl-edge" d="M140 232 V252" />
            <path class="dl-edge dl-edge--accent" d="M140 348 V368" stroke="#ff7417" stroke-opacity="0.55" />
            <path class="dl-edge dl-edge--accent" d="M140 428 V448" stroke="#ff7417" stroke-opacity="0.55" />
          </g>

          <g font-family="Manrope, system-ui, sans-serif">
            <g transform="translate(55, 12)">
              <path d="M0 0 H170 V32 L162 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="#ff7417" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Events</text>
            </g>
            <g transform="translate(55, 72)">
              <path d="M0 0 H170 V32 L162 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">GitHub</text>
            </g>
            <g transform="translate(55, 132)">
              <path d="M0 0 H170 V32 L162 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Shipped work</text>
            </g>
            <g transform="translate(55, 192)">
              <path d="M0 0 H170 V32 L162 40 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <circle cx="18" cy="20" r="3.5" fill="rgb(5 5 5 / 0.45)" />
              <text x="30" y="24.5" font-size="12" font-weight="700" fill="#050505">Founder notes</text>
            </g>

            <g transform="translate(40, 252)">
              <path d="M0 0 H200 V84 L188 96 H0 Z" stroke="#ff7417" stroke-width="1.5" fill="#fff4ec" />
              <g stroke="#ff7417" stroke-width="1.25" opacity="0.85">
                <line x1="100" y1="10" x2="100" y2="24" />
                <line x1="93" y1="17" x2="107" y2="17" />
              </g>
              <text x="100" y="46" text-anchor="middle" font-size="11" font-weight="800" letter-spacing="0.12em" fill="#bf4f08">
                DEVLABS
              </text>
              <text x="100" y="66" text-anchor="middle" font-size="15" font-weight="800" fill="#050505">
                graph
              </text>
              <text x="100" y="82" text-anchor="middle" font-size="10" font-weight="600" fill="rgb(5 5 5 / 0.45)">
                resolve · rank · route
              </text>
            </g>

            <g transform="translate(55, 368)">
              <path d="M0 0 H170 V48 L162 60 H0 Z" stroke="rgb(5 5 5 / 0.35)" stroke-width="1.25" fill="#fbf6f3" />
              <text x="85" y="28" text-anchor="middle" font-size="12" font-weight="800" fill="#050505">
                Agent shortlist
              </text>
              <text x="85" y="44" text-anchor="middle" font-size="10" font-weight="600" fill="rgb(5 5 5 / 0.45)">
                evidence-ranked
              </text>
            </g>

            <g transform="translate(90, 448)">
              <path d="M0 0 H100 V36 L92 44 H0 Z" stroke="#050505" stroke-width="1.5" fill="#050505" />
              <text x="50" y="27" text-anchor="middle" font-size="12" font-weight="800" fill="#fffaf7">
                Hire
              </text>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .system-map-panel {
    --cut: 1rem;
  }

  .system-map-svg .dl-edge {
    stroke-dasharray: 12 6;
  }

  .system-map-section.is-drawn .system-map-svg .dl-edge {
    animation: system-edge-draw 1.1s ease forwards;
  }

  .system-map-section.is-drawn .system-map-svg .dl-node-group,
  .system-map-section.is-drawn .system-map-mobile g[font-family] {
    animation: system-fade-up 0.7s ease 0.15s both;
  }

  @keyframes system-edge-draw {
    from {
      stroke-dashoffset: 80;
      opacity: 0.35;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes system-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .system-map-section.is-drawn .system-map-svg .dl-edge,
    .system-map-section.is-drawn .system-map-svg .dl-node-group,
    .system-map-section.is-drawn .system-map-mobile g[font-family] {
      animation: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-system-map]");
  if (section) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      section.classList.add("is-drawn");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              section.classList.add("is-drawn");
              io.disconnect();
            }
          }
        },
        { threshold: 0.28 }
      );
      io.observe(section);
    }
  }
</script>
