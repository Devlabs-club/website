---
const stats = [
  ["2,000+", "builders in the community"],
  ["25+", "events and builder programs"],
  ["50+", "projects shipped through our programs"],
];
---

<section id="community-impact" class="impact relative isolate overflow-hidden bg-[#fbf6f3] px-5 py-24 text-black sm:px-8 sm:py-32 lg:px-10">
  <div class="impact__grid absolute inset-0" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl border-x border-black/10">
    <header class="grid gap-8 border-y border-black/10 px-6 py-10 sm:px-10 lg:grid-cols-[1fr_0.65fr] lg:items-end lg:py-14">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-[#bf4f08]">Community impact</p>
        <h2 class="mt-5 max-w-4xl text-[clamp(2.8rem,6vw,6rem)] font-black leading-[0.93] tracking-[-0.045em]">
          Built to move builders forward.
        </h2>
      </div>
      <p class="max-w-xl text-[clamp(1.05rem,1.5vw,1.3rem)] font-medium leading-relaxed text-black/58 lg:pb-2">
        The community is not an audience. It is the programs, people, and capital behind the next thing a builder ships.
      </p>
    </header>

    <div class="grid border-b border-black/10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="flex min-h-[31rem] flex-col justify-between bg-[#ff7417] p-7 text-white sm:p-10 lg:p-12">
        <div class="flex items-center justify-between text-xs font-extrabold uppercase tracking-[0.18em]">
          <span>Funding and support</span>
          <span>Since day one</span>
        </div>
        <div>
          <p class="text-[clamp(5.5rem,11vw,10rem)] font-black leading-[0.78] tracking-[-0.07em]">$150K+</p>
          <p class="mt-8 max-w-xl text-[clamp(1.5rem,2.7vw,2.5rem)] font-black leading-tight">
            raised to support builder programs, prizes, and ambitious projects.
          </p>
        </div>
      </div>

      <figure class="relative min-h-[31rem] overflow-hidden border-t border-black/10 lg:border-l lg:border-t-0">
        <img src="/team-collage.webp" alt="Builders and organizers across the DevLabs community" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 right-0 border-t border-white/20 bg-black/30 px-6 py-4 text-xs font-extrabold uppercase tracking-[0.16em] text-white backdrop-blur-sm">
          Builders across DevLabs events and programs
        </figcaption>
      </figure>
    </div>

    <div class="grid border-b border-black/10 sm:grid-cols-3">
      {stats.map(([value, label]) => (
        <div class="border-b border-black/10 bg-[#fffaf7]/78 p-7 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0 sm:p-9">
          <p class="text-[clamp(3rem,5vw,5rem)] font-black leading-none tracking-[-0.055em]">{value}</p>
          <p class="mt-4 max-w-xs text-base font-bold leading-snug text-black/52">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact__grid {
    opacity: 0.45;
    background-image:
      linear-gradient(rgba(32, 24, 19, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(32, 24, 19, 0.055) 1px, transparent 1px);
    background-size: 46px 46px;
  }
</style>
