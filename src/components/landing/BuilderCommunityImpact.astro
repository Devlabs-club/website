---
const stats = [
  ["2,000+", "builders in the community"],
  ["25+", "events and builder programs"],
  ["50+", "projects shipped through our programs"],
];
---

<section id="community-impact" class="ruler-section relative isolate overflow-hidden bg-[#fbf6f3] px-5 py-20 text-[#1a2e34] sm:px-8 sm:py-24 lg:px-10">
  <div class="ruler-rails" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-[72rem]">
    <header class="mb-10 flex flex-col gap-6 sm:mb-12 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="flex items-center gap-2.5 text-[0.95rem] font-normal text-[#7a8b90]">
          <span class="grid h-[18px] w-[18px] place-items-center rounded-[4px] border border-[#c5d0d3]" aria-hidden="true">
            <span class="h-1.5 w-1.5 rounded-[2px] bg-[#9aabad]"></span>
          </span>
          Community impact
        </p>
        <h2 class="mt-3 max-w-3xl text-[clamp(2rem,3.6vw,3.15rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-[#16343c]">
          Built to move builders forward.
        </h2>
      </div>
      <p class="max-w-xl text-[1.02rem] font-normal leading-relaxed text-[#6d7e84] lg:pb-1">
        The community is not an audience. It is the programs, people, and capital behind the next thing a builder ships.
      </p>
    </header>

    <div class="grid gap-4 lg:grid-cols-[1.05fr_0.95fr] lg:gap-5">
      <article class="impact-fund relative min-h-[22rem] overflow-hidden rounded-[28px] border border-[#e4e4de] sm:min-h-[28rem]">
        <img
          src="/team-collage.webp"
          alt=""
          loading="lazy"
          class="pointer-events-none absolute inset-x-0 bottom-0 z-0 w-[170%] max-w-none -translate-x-[20%] select-none sm:w-[155%] sm:-translate-x-[18%]"
        />
        <div class="relative z-10 px-7 pb-36 pt-8 sm:px-9 sm:pb-44 sm:pt-10">
          <div class="flex items-center justify-between text-[0.78rem] font-medium text-[#bf4f08]">
            <span>Funding and support</span>
            <span>Since day one</span>
          </div>
          <p class="mt-10 text-[clamp(4rem,8vw,6.25rem)] font-semibold leading-[0.9] tracking-[-0.04em] text-[#16343c]">$150K+</p>
          <p class="mt-6 max-w-md text-[1.05rem] font-normal leading-relaxed text-[#5f7177]">
            raised to support builder programs, prizes, and ambitious projects.
          </p>
        </div>
      </article>

      <figure class="relative flex min-h-[24rem] flex-col overflow-hidden rounded-[28px] border border-[#e4e4de] bg-white sm:min-h-[28rem]" aria-label="Builders across DevLabs events and programs">
        <header class="relative z-10 px-6 pb-5 pt-6 sm:px-7 sm:pt-7">
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full bg-[#16343c] px-3 py-1 text-[0.68rem] font-medium tracking-[0.04em] text-white">In the room</span>
            <span class="inline-flex overflow-hidden rounded-full border border-[#eceae4] text-[0.68rem] font-medium">
              <span class="bg-[#16343c] px-2.5 py-1 text-white">15+</span>
              <span class="bg-white px-2.5 py-1 text-[#5f7177]">events</span>
            </span>
          </div>
          <h3 class="mt-4 max-w-[16rem] text-[1.35rem] font-semibold leading-tight tracking-[-0.03em] text-[#16343c] sm:text-[1.5rem]">
            Builders across DevLabs events and programs
          </h3>
        </header>

        <div class="relative min-h-[14rem] flex-1">
          <img
            src="/events/devhacks.jpg"
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
          />
        </div>
      </figure>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-3 lg:mt-5 lg:gap-5">
      {stats.map(([value, label]) => (
        <div class="rounded-[28px] border border-[#e4e4de] bg-white px-7 py-8">
          <p class="text-[clamp(2.1rem,3.4vw,3rem)] font-semibold leading-none tracking-[-0.03em] text-[#16343c]">{value}</p>
          <p class="mt-4 max-w-xs text-base font-normal leading-snug text-[#6d7e84]">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact-fund {
    background:
      radial-gradient(ellipse at 18% 120%, rgba(255, 168, 120, 0.34), transparent 58%),
      linear-gradient(180deg, #fff8ee 0%, #ffe9c8 100%);
  }
</style>
