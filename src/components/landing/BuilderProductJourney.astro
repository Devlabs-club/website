---
interface Props {
  ctaHref: string;
}

const { ctaHref } = Astro.props;

const apps = [
  { name: "Claude", mark: "claude" },
  { name: "Cursor", mark: "cursor" },
  { name: "GitHub", mark: "github" },
  { name: "ChatGPT", mark: "chatgpt" },
  { name: "LinkedIn", mark: "linkedin" },
];
---

<section id="builder-product" class="builder-how ruler-section relative isolate overflow-hidden bg-[#fbf6f3] px-5 py-20 text-[#1a2e34] sm:px-8 sm:py-24 lg:px-10">
  <div class="ruler-rails" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-[72rem]">
    <header class="mb-10 flex flex-col gap-6 sm:mb-12 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="flex items-center gap-2.5 text-[0.95rem] font-normal text-[#7a8b90]">
          <span class="grid h-[18px] w-[18px] place-items-center rounded-[4px] border border-[#c5d0d3]" aria-hidden="true">
            <span class="h-1.5 w-1.5 rounded-[2px] bg-[#9aabad]"></span>
          </span>
          Easy as one, two, three.
        </p>
        <h2 class="mt-3 text-[clamp(2rem,3.6vw,3.15rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-[#16343c]">
          How it works
        </h2>
      </div>

      <a
        href={ctaHref}
        class="inline-flex h-11 w-fit items-center gap-2.5 rounded-full bg-[#ff7417] px-5 text-[0.92rem] font-medium text-white transition hover:bg-[#e9630d]"
      >
        Build my profile
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="grid gap-4 lg:grid-cols-3 lg:gap-5">
      <article class="how-card overflow-hidden rounded-[28px] border border-[#e4e4de] bg-white">
        <div class="how-visual how-visual--join relative flex min-h-[17.5rem] items-center justify-center overflow-hidden px-8 py-10 sm:min-h-[19rem]">
          <div class="relative z-10 flex w-full max-w-[17.5rem] flex-col items-center">
            <div class="w-full rounded-2xl border border-black/[0.06] bg-white px-4 py-3.5 shadow-[0_10px_28px_rgba(40,30,16,0.08)]">
              <div class="flex items-center gap-3">
                <span class="flex -space-x-1.5" aria-hidden="true">
                  <img src="/landing/builders/aaditi.jpg" alt="" class="h-7 w-7 rounded-full border-2 border-white object-cover" />
                  <img src="/landing/builders/aakash.jpg" alt="" class="h-7 w-7 rounded-full border-2 border-white object-cover" />
                  <img src="/landing/builders/aanchal.jpg" alt="" class="h-7 w-7 rounded-full border-2 border-white object-cover" />
                </span>
                <p class="text-[0.92rem] font-medium text-[#16343c]">Join the community</p>
              </div>
            </div>
            <span class="my-2 text-[#c9b49a]" aria-hidden="true">↓</span>
            <div class="w-full rounded-2xl border border-black/[0.06] bg-white px-4 py-3.5 shadow-[0_10px_28px_rgba(40,30,16,0.08)]">
              <p class="text-[0.92rem] font-medium text-[#16343c]">You’re in. Start shipping.</p>
            </div>
          </div>
        </div>
        <div class="px-7 pb-8 pt-6 sm:px-8">
          <h3 class="flex items-baseline gap-2 text-[1.15rem] font-semibold tracking-[-0.02em] text-[#16343c]">
            <span class="font-normal text-[#9aa8ac]">1</span>
            Join the community
          </h3>
          <p class="mt-2.5 max-w-sm text-[0.95rem] font-normal leading-relaxed text-[#6d7e84]">
            Create your builder profile and step into a room of people who ship in public.
          </p>
        </div>
      </article>

      <article class="how-card overflow-hidden rounded-[28px] border border-[#e4e4de] bg-white">
        <div class="how-visual how-visual--trace relative flex min-h-[17.5rem] items-center justify-center overflow-hidden px-8 py-10 sm:min-h-[19rem]">
          <div class="how-visual__grid absolute inset-0" aria-hidden="true"></div>
          <div class="relative z-10 grid w-full max-w-[17.5rem] grid-cols-6 gap-3">
            {apps.map((app, index) => (
              <div class:list={["col-span-2 grid aspect-square place-items-center rounded-2xl border border-black/[0.05] bg-white shadow-[0_8px_20px_rgba(40,30,16,0.06)]", index === 3 && "col-start-2"]} title={app.name}>
                {app.mark === "claude" && (
                  <img src="/brand/claude.png" alt="" class="h-7 w-7 object-contain" />
                )}
                {app.mark === "github" && (
                  <svg class="h-7 w-7 text-[#1c211f]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92 0 1.38-.01 2.49-.01 2.83 0 .26.18.58.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
                  </svg>
                )}
                {app.mark === "linkedin" && (
                  <svg class="h-7 w-7 text-[#0a66c2]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M6.94 8.5H3.75V20h3.19V8.5ZM5.34 3.5a1.85 1.85 0 1 0 0 3.7 1.85 1.85 0 0 0 0-3.7ZM20.25 20h-3.18v-5.6c0-1.33-.02-3.05-1.86-3.05-1.86 0-2.15 1.45-2.15 2.95V20H9.88V8.5h3.05v1.57h.04c.43-.8 1.47-1.65 3.02-1.65 3.23 0 3.83 2.13 3.83 4.9V20Z" />
                  </svg>
                )}
                {app.mark === "chatgpt" && (
                  <img src="/brand/chatgpt.svg" alt="" class="h-7 w-7 object-contain" />
                )}
                {app.mark === "cursor" && (
                  <img src="/brand/cursor-ai.svg" alt="" class="h-7 w-7 object-contain" />
                )}
              </div>
            ))}
          </div>
        </div>
        <div class="px-7 pb-8 pt-6 sm:px-8">
          <h3 class="flex items-baseline gap-2 text-[1.15rem] font-semibold tracking-[-0.02em] text-[#16343c]">
            <span class="font-normal text-[#9aa8ac]">2</span>
            Run your agent trace
          </h3>
          <p class="mt-2.5 max-w-sm text-[0.95rem] font-normal leading-relaxed text-[#6d7e84]">
            Connect Claude and Cursor so founders see how you actually build — not just what you shipped.
          </p>
        </div>
      </article>

      <article class="how-card overflow-hidden rounded-[28px] border border-[#e4e4de] bg-white">
        <div class="how-visual how-visual--discover relative flex min-h-[17.5rem] items-center justify-center overflow-hidden px-8 py-10 sm:min-h-[19rem]">
          <div class="relative z-10 w-full max-w-[18rem] rounded-2xl border border-black/[0.06] bg-white p-4 shadow-[0_14px_32px_rgba(40,30,16,0.08)]">
            <p class="text-[0.72rem] font-medium text-[#9aa8ac]">Founder brief</p>
            <p class="mt-3 rounded-xl bg-[#fff1e4] px-3.5 py-3 text-[0.92rem] leading-relaxed text-[#c45a12]">
              A founder just picked up your profile. Your agent traces and shipped work are ready to review.
            </p>
          </div>
        </div>
        <div class="px-7 pb-8 pt-6 sm:px-8">
          <h3 class="flex items-baseline gap-2 text-[1.15rem] font-semibold tracking-[-0.02em] text-[#16343c]">
            <span class="font-normal text-[#9aa8ac]">3</span>
            Get discovered by founders
          </h3>
          <p class="mt-2.5 max-w-sm text-[0.95rem] font-normal leading-relaxed text-[#6d7e84]">
            When a startup needs someone like you, you get notified — warm intros from work you already did.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .how-visual--join {
    background:
      radial-gradient(ellipse at 50% 78%, rgba(255, 186, 92, 0.42), transparent 58%),
      linear-gradient(180deg, #fff8ee 0%, #ffe9c8 100%);
  }

  .how-visual--trace {
    background: #f6f3ec;
  }

  .how-visual__grid {
    background-image:
      linear-gradient(rgba(120, 110, 96, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(120, 110, 96, 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 40%, transparent 78%);
  }

  .how-visual--discover {
    background:
      radial-gradient(ellipse at 50% 80%, rgba(255, 168, 120, 0.28), transparent 56%),
      linear-gradient(180deg, #f7f1ea 0%, #f3e4d8 100%);
  }
</style>
