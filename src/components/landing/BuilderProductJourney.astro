---
interface Props {
  ctaHref: string;
}

const { ctaHref } = Astro.props;

const steps = [
  {
    number: "01",
    title: "Bring the work",
    body: "Connect the places where you already build. No rewriting every project into resume bullets.",
    detail: "GitHub · Portfolio · Devpost · Live demos",
  },
  {
    number: "02",
    title: "We build the proof",
    body: "DevLabs turns projects, event work, and open-source contributions into one profile founders can review.",
    detail: "Projects · Decisions · Execution · Context",
  },
  {
    number: "03",
    title: "Get discovered",
    body: "When a startup needs someone with your skills, the work you shipped becomes the reason for an introduction.",
    detail: "Relevant role · Proof-backed match · Warm intro",
  },
];
---

<section id="builder-product" class="builder-product relative isolate overflow-hidden bg-[#fbf6f3] px-5 py-24 text-black sm:px-8 sm:py-32 lg:px-10">
  <div class="builder-product__grid absolute inset-0" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl border-x border-black/10">
    <header class="grid gap-8 border-y border-black/10 px-6 py-10 sm:px-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:py-14">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-[#bf4f08]">01 / Your proof profile</p>
        <h2 class="mt-5 max-w-4xl text-[clamp(2.75rem,6.2vw,6.1rem)] font-black leading-[0.93] tracking-[-0.045em]">
          Your work becomes the profile founders review.
        </h2>
      </div>
      <p class="max-w-xl text-[clamp(1.05rem,1.6vw,1.35rem)] font-medium leading-relaxed text-black/60 lg:pb-2">
        DevLabs gives the things you have shipped a clear story, then puts that story in front of startup teams looking for builders like you.
      </p>
    </header>

    <div class="grid border-b border-black/10 lg:grid-cols-3">
      {steps.map((step) => (
        <article class="min-h-[21rem] border-b border-black/10 bg-[#fffaf7]/72 p-7 last:border-b-0 sm:p-9 lg:border-b-0 lg:border-r lg:last:border-r-0">
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center bg-[#ff7417] text-sm font-black text-white">{step.number}</span>
            <span class="h-px w-20 bg-[#ff7417]/45"></span>
          </div>
          <h3 class="mt-12 text-[clamp(1.65rem,2.6vw,2.35rem)] font-black leading-tight">{step.title}</h3>
          <p class="mt-4 text-base font-medium leading-relaxed text-black/58">{step.body}</p>
          <p class="mt-8 border-t border-black/10 pt-4 text-xs font-extrabold uppercase tracking-[0.13em] text-[#bf4f08]">{step.detail}</p>
        </article>
      ))}
    </div>

    <div class="grid border-b border-black/10 bg-[#191614] text-white lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col justify-between gap-12 p-7 sm:p-10 lg:p-12">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-[#ff9d5b]">Built with the community</p>
          <h3 class="mt-5 max-w-xl text-[clamp(2.2rem,4.5vw,4.35rem)] font-black leading-[0.95] tracking-[-0.04em]">
            Every room gives your profile more context.
          </h3>
          <p class="mt-6 max-w-xl text-base font-medium leading-relaxed text-white/62 sm:text-lg">
            Hackathons, hacker houses, and startup programs let us see how you build with a team, handle pressure, and carry an idea through to a demo.
          </p>
        </div>
        <a href={ctaHref} class="corner-cta group relative inline-flex min-h-14 w-fit items-center gap-8 px-6 text-sm font-extrabold text-[#ff8a3d] transition hover:bg-white/[0.04]">
          <i aria-hidden="true"></i>
          Build my profile
          <span class="text-xl transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      <figure class="relative min-h-[24rem] overflow-hidden border-t border-white/12 lg:border-l lg:border-t-0">
        <img src="/landing/community/devhacks-build.png" alt="Builders working together at a DevLabs hackathon" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/5 to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 right-0 flex items-center justify-between gap-4 border-t border-white/15 bg-black/35 px-6 py-4 text-xs font-extrabold uppercase tracking-[0.16em] backdrop-blur-sm">
          <span>DevHacks · Arizona</span>
          <span class="text-[#ff9d5b]">Build in public</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .builder-product__grid {
    opacity: 0.52;
    background-image:
      linear-gradient(rgba(32, 24, 19, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(32, 24, 19, 0.055) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .corner-cta::before,
  .corner-cta::after,
  .corner-cta i::before,
  .corner-cta i::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: #ff7417;
    pointer-events: none;
  }

  .corner-cta::before { left: 0; top: 0; border-left: 1px solid #ff7417; border-top: 1px solid #ff7417; }
  .corner-cta::after { right: 0; top: 0; border-right: 1px solid #ff7417; border-top: 1px solid #ff7417; }
  .corner-cta i::before { left: 0; bottom: 0; border-left: 1px solid #ff7417; border-bottom: 1px solid #ff7417; }
  .corner-cta i::after { right: 0; bottom: 0; border-right: 1px solid #ff7417; border-bottom: 1px solid #ff7417; }
</style>
