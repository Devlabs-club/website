---
/** Decorative ASCII star canvases — pair with LandingAsciiInit.astro */
---

<canvas
  class="ascii-star hero-star-left absolute left-[max(-12rem,-13vw)] top-32 h-[clamp(22rem,32vw,32rem)] w-[clamp(22rem,32vw,32rem)] -rotate-[22deg]"
  data-star-canvas
  aria-hidden="true"
></canvas>
<canvas
  class="ascii-star hero-star-right absolute right-[max(-11rem,-12vw)] top-20 h-[clamp(20rem,30vw,30rem)] w-[clamp(20rem,30vw,30rem)] rotate-[10deg]"
  data-star-canvas
  aria-hidden="true"
></canvas>
