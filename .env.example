# Copy to `.env` for local development (gitignored).
# WorkOS must list WORKOS_REDIRECT_URI exactly in the dashboard.

# --- App URLs ---
WEBSITE_ROOT=http://localhost:4321
WORKOS_REDIRECT_URI=http://localhost:4321/api/auth/oauth/callback
# Leave empty to run API routes locally; set to Vercel URL to proxy instead.
API_PROXY_ORIGIN=

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
ADMIN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
MOMENTUM_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momentum?retryWrites=true&w=majority

# OPENROUTER_MODEL_CHAT="openai/gpt-5.6-luna"
# OPENROUTER_MODEL_REASONING="openai/gpt-5.6-luna-pro"
# OPENROUTER_MODEL_EMBEDDING="openai/text-embedding-3-small"
# OPENROUTER_API_KEY=...

# Required for homepage GitHub contribution wall (GraphQL). Also improves public API rate limits.
# GITHUB_TOKEN=ghp_...

# --- Auth ---
JWT_SECRET=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
WORKOS_COOKIE_PASSWORD=

# --- Email & newsletter ---
SENDGRID_API_KEY=
# Protects `GET /api/email/stats` (optional, admin/API secret)
EMAIL_STATS_SECRET=
# Used by `talentEmail.replyAddressForThread()` to route threaded replies
# (requires SendGrid Inbound Parse + DNS MX for the subdomain).
SENDGRID_INBOUND_REPLY_DOMAIN=
# HMAC secret for tokenized reply aliases (reply+thread_<id>_<token>@domain).
# Falls back to ENRICHMENT_INTERNAL_SECRET if unset.
# SENDGRID_INBOUND_REPLY_SECRET=
# Optional: protects `POST /api/email/sendgrid-events` if you add matching custom auth
# handling on the SendGrid side (otherwise leave blank/unset).
# SENDGRID_EVENT_WEBHOOK_SECRET=
# SendGrid Inbound Parse destination (local: use ngrok → /email/sendgrid-inbound)
# Production: https://www.devlabs.club/email/sendgrid-inbound
# Also works at /api/email/sendgrid-inbound if you prefer that path.
# handling on the SendGrid side (or proxy it).
# SENDGRID_INBOUND_WEBHOOK_SECRET=
BEEHIV_API_KEY=
ZOHO_EMAIL=
ZOHO_PASSWORD=

# --- Media & search ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# Stripe billing — founder plans and custom hiring deposit.
# The server also accepts STRIPE_AGENT_SECRET_KEY or STRIPE_PROD_KEY when injected by an agent runtime.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
# STRIPE_GROWTH_YEARLY_PRICE_ID=price_...
# STRIPE_CUSTOM_DEPOSIT_PRICE_ID=price_...

# --- AI & enrichment ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHAT=openai/gpt-5.6-luna
# Used for evidence-rich cohort reranks and founder talent-pool analysis.
OPENROUTER_MODEL_REASONING=openai/gpt-5.6-luna-pro
# Talent search perf: auto skips semantic scoring when search index already retrieved candidates.
# Set to "disabled" to force deterministic-only ranking. Set to "enabled" to always try embeddings.
# TALENT_DISCOVERY_SEMANTIC=auto
# Cap in-memory embedding scan during discovery (default 350).
# TALENT_EMBEDDING_SCAN_LIMIT=350
# Opt-in Atlas $vectorSearch channel over talentembeddings_v2 (default off).
# TALENT_DISCOVERY_VECTOR_V2=on
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
# X/Twitter API v2 (Bearer token for read-only user + timeline fetch)
TWITTER_BEARER_TOKEN=
# Optional OAuth 1.0a app credentials (not required when Bearer is set)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
GITHUB_TOKEN=
# Internal enrichment (builder profile backfill + dry-run probes at POST /api/internal/enrichment-probe)
ENRICHMENT_INTERNAL_SECRET=
LINKEDIN_SCRAPER_URL=https://enrich-scraper-production.up.railway.app
LINKEDIN_SCRAPER_SECRET=

# --- Builder messaging ---
# Set true to use the legacy iMessage builder handoff. Defaults false so builders
# use the form-based profile intake and email communication flow.
DEVLABS_IMESSAGE_ENABLED=false
# Provider: bluebubbles | agentphone (auto-detects BlueBubbles when BLUEBUBBLES_* is set)
IMESSAGE_PROVIDER=bluebubbles

# BlueBubbles (iMessage pilot on a Mac) — @see docs/imessage-bluebubbles-setup.md
BLUEBUBBLES_SERVER_URL=http://localhost:1234
# Optional fallback when the primary tunnel URL expires (e.g. trycloudflare.com)
# BLUEBUBBLES_SERVER_URL_FALLBACK=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=
# Apple ID signed into iMessage on the Mac (builder texts this address)
BLUEBUBBLES_IMESSAGE_ADDRESS=hi@geekydan.dev
BLUEBUBBLES_WEBHOOK_SECRET=
# apple-script (reliable) or private-api (typing/tapbacks; needs helper)
BLUEBUBBLES_SEND_METHOD=apple-script

# AgentPhone (SMS/MMS/iMessage) — @see docs/agentphone-setup.md
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_FROM_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=
# Used in "Open Messages" handoff links (defaults to AGENTPHONE_FROM_NUMBER)
DEVLABS_IMESSAGE_PHONE=

# --- LinkedIn session (optional) ---
# LINKEDIN_LI_AT_COOKIE=
# LINKEDIN_JSESSIONID_COOKIE=
