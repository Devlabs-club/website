# Copy to `.env` or `.dev.vars` for local Astro dev (both gitignored).
# WorkOS must list WORKOS_REDIRECT_URI exactly in the dashboard.

WEBSITE_ROOT=http://localhost:4321
WORKOS_REDIRECT_URI=http://localhost:4321/api/auth/oauth/callback

# Required for talent OS, auth, and admin APIs (Atlas connection string)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
# ADMIN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
#
# Optional — Momentum program uses a separate database
# MOMENTUM_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momentum?retryWrites=true&w=majority

# OPENROUTER_MODEL_CHAT="google/gemini-2.5-flash"
# OPENROUTER_MODEL_EMBEDDING="openai/text-embedding-3-small"
# GITHUB_TOKEN=ghp_...

# Optional — LinkedIn authenticated profile scraping (copy cookies after logging in)
# LINKEDIN_LI_AT_COOKIE=...
# LINKEDIN_JSESSIONID_COOKIE=...

# Optional — remote Chrome CDP/noVNC scraper service. When set, onboarding
# LinkedIn enrichment runs on the remote service instead of local Chrome.
# LINKEDIN_SCRAPER_URL=https://enrich-scraper-production.up.railway.app
# LINKEDIN_SCRAPER_SECRET=...

# WORKOS_API_KEY=...
# WORKOS_CLIENT_ID=...
# WORKOS_COOKIE_PASSWORD=...

# Optional — builder claim phone/iMessage delivery.
# SMS verification uses Twilio Verify.
# Use either Account SID/Auth Token or API Key SID/Secret.
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_API_KEY_SID=...
# TWILIO_API_KEY_SECRET=...
# TWILIO_VERIFY_SERVICE_SID=...
#
# After SMS verification, the DevLabs agent sends the first iMessage through
# BlueBubbles. Set the BlueBubbles server webhook to:
#   https://<devlabs-os-domain>/api/builder/claim/message-webhook?password=$BLUEBUBBLES_PASSWORD
# Outbound iMessage webhook receives: { channel, to, body, claimId, builderId, purpose }.
# Inbound provider should POST replies to /api/builder/claim/message-webhook with
# Authorization: Bearer $BUILDER_CLAIM_INBOUND_WEBHOOK_SECRET and JSON { fromPhone, body }.
# BLUEBUBBLES_SERVER_URL=...
# BLUEBUBBLES_PASSWORD=...
# BUILDER_CLAIM_MESSAGE_WEBHOOK_URL=https://bluebubbles-adapter.example/send
# BUILDER_CLAIM_MESSAGE_WEBHOOK_SECRET=...
# BUILDER_CLAIM_INBOUND_WEBHOOK_SECRET=...

# --- iMessage gateway (BlueBubbles pilot) ---
# BlueBubbles Server runs on this Mac (default port 1234). Both it and Astro run
# locally, so no tunnel is needed for the pilot.
# BLUEBUBBLES_SERVER_URL=http://localhost:1234
# BLUEBUBBLES_PASSWORD=<the server password you set in the BlueBubbles app>
# Shared secret appended to the webhook URL; if unset, inbound auth is skipped (localhost-only).
# BLUEBUBBLES_WEBHOOK_SECRET=<random-string>

# Exa web search — powers the iMessage builder agent's deep_research
# (X/Twitter, personal site, press, Devpost). Smart minimal calls only.
# EXA_API_KEY=...
