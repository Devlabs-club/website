# Copy to `.env` for local development (gitignored).
# WorkOS must list WORKOS_REDIRECT_URI exactly in the dashboard.

# --- App URLs ---
WEBSITE_ROOT=http://localhost:4321
WORKOS_REDIRECT_URI=http://localhost:4321/api/auth/oauth/callback
# Leave empty to run API routes locally; set to Vercel URL to proxy instead.
API_PROXY_ORIGIN=

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
ADMIN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
MOMENTUM_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momentum?retryWrites=true&w=majority

# OPENROUTER_MODEL_CHAT="google/gemini-2.5-flash"
# OPENROUTER_MODEL_EMBEDDING="openai/text-embedding-3-small"
# OPENROUTER_API_KEY=...

# Required for homepage GitHub contribution wall (GraphQL). Also improves public API rate limits.
# GITHUB_TOKEN=ghp_...

# --- Auth ---
JWT_SECRET=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
WORKOS_COOKIE_PASSWORD=

# --- Email & newsletter ---
SENDGRID_API_KEY=
BEEHIV_API_KEY=
ZOHO_EMAIL=
ZOHO_PASSWORD=

# --- Media & search ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# Stripe billing — founder plans and custom hiring deposit.
# The server also accepts STRIPE_AGENT_SECRET_KEY or STRIPE_PROD_KEY when injected by an agent runtime.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
# STRIPE_GROWTH_YEARLY_PRICE_ID=price_...
# STRIPE_CUSTOM_DEPOSIT_PRICE_ID=price_...

# --- AI & enrichment ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHAT=google/gemini-2.5-flash
EXA_API_KEY=
GITHUB_TOKEN=
ENRICHMENT_INTERNAL_SECRET=
LINKEDIN_SCRAPER_URL=https://rich-scraper-production.up.railway.app
LINKEDIN_SCRAPER_SECRET=

# --- Builder messaging (AgentPhone — SMS/MMS/iMessage) ---
# @see docs/agentphone-setup.md
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_FROM_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=
# Used in "Open Messages" handoff links (defaults to AGENTPHONE_FROM_NUMBER)
DEVLABS_IMESSAGE_PHONE=

# --- LinkedIn session (optional) ---
# LINKEDIN_LI_AT_COOKIE=
# LINKEDIN_JSESSIONID_COOKIE=
