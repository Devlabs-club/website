# Copy to `.env` or `.dev.vars` for local Astro dev (both gitignored).
# WorkOS must list WORKOS_REDIRECT_URI exactly in the dashboard.

WEBSITE_ROOT=http://localhost:4321
WORKOS_REDIRECT_URI=http://localhost:4321/api/auth/oauth/callback

# Required for talent OS, auth, and admin APIs (Atlas connection string)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
# ADMIN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devlabs?retryWrites=true&w=majority
#
# Optional — Momentum program uses a separate database
# MOMENTUM_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momentum?retryWrites=true&w=majority

# OPENROUTER_MODEL_CHAT="google/gemini-2.5-flash"
# OPENROUTER_MODEL_EMBEDDING="openai/text-embedding-3-small"
# GITHUB_TOKEN=ghp_...

# Optional — LinkedIn authenticated profile scraping (copy cookies after logging in)
# LINKEDIN_LI_AT_COOKIE=...
# LINKEDIN_JSESSIONID_COOKIE=...
# WORKOS_API_KEY=...
# WORKOS_CLIENT_ID=...
# WORKOS_COOKIE_PASSWORD=...
